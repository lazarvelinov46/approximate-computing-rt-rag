 no GPU.\n# Answers audit question 6.\nimport torch\nfrom transformers import Qwen2Config, Qwen2ForCausalLM\nfrom transformers.cache_utils import Cache, DynamicLayer\n\ntorch.manual_seed(42)\ntiny = Qwen2Config(vocab_size=256, hidden_size=64, intermediate_size=128,\n                   num_hidden_layers=2, num_attention_heads=4,\n                   num_key_value_heads=2, max_position_embeddings=128,\n                   use_sliding_window=False, tie_word_embeddings=False)\nm = Qwen2ForCausalLM(tiny).eval()\nprint(f\"resolved attn_implementation: {m.config._attn_implementation}\")\n\n# --- 1. what does a cache layer get to work with? --------------------------\nclass SpyLayer(DynamicLayer):\n    seen = None\n    def update(self, k, v, cache_kwargs=None):\n        SpyLayer.seen = {\"cache_kwargs\": sorted((cache_kwargs or {}).keys()),\n                         \"key_shape\": tuple(k.shape)}\n        return super().update(k, v, cache_kwargs)\n\nids = torch.randint(0, 256, (2, 12))\nwith torch.no_grad():\n    m(input_ids=ids, past_key_values=Cache(layers=[SpyLayer() for _ in range(2)]),\n      use_cache=True)\nprint(f\"\\nupdate() receives cache_kwargs={SpyLayer.seen['cache_kwargs']}  \"\n      f\"key_states{SpyLayer.seen['key_shape']}\")\nprint(\"query_states available to the cache:\",\n      any(\"quer\" in k for k in SpyLayer.seen[\"cache_kwargs\"]))\n\n# --- 2. does the decoder layer even hand attn_weights back? ----------------\nimport inspect\nfrom transformers.models.qwen2.modeling_qwen2 import Qwen2DecoderLayer\ndl = inspect.getsource(Qwen2DecoderLayer.forward)\nprint(\"\\ndecoder layer discards weights:\", \"hidden_states, _ = self.self_attn\" in dl)\nprint(\"returns a bare tensor       :\", \"-> torch.Tensor\" in dl)\n\n# --- 3. the only route: forward hook on self_attn, sdpa vs eager -----------\ngrabbed = {}\ndef hook(mod, args, out):\n    grabbed[\"w\"] = out[1]\nh = m.model.layers[0].self_attn.register_forward_hook(hook)\n\nfor impl in (\"sdpa\", \"eager\"):\n    m.set_attn_implementation(impl)\n    grabbed.clear()\n    with torch.no_grad():\n        m(input_ids=ids, use_cache=False)\n    w = grabbed.get(\"w\")\n    print(f\"  {impl:<6} attn_weights: \"\n          f\"{'None' if w is None else tuple(w.shape)}\")\nh.remove()\nm.set_attn_implementation(\"sdpa\")\n\n# --- 4. what eager would cost at the STUDY shape ---------------------------\nB, H, S = CFG[\"generation\"][\"batch_size\"], cfg_hf.num_attention_heads, 744\nfp16 = B * H * S * S * 2 / 2**30\nprint(f\"\\neager attn matrix at B={B} H={H} S={S}: \"\n      f\"{fp16:.2f} GiB fp16 + {2*fp16:.2f} GiB fp32 softmax, transient per layer\")\nprint(f\"  headroom: 14.56 - 5.87 weights = {14.56-5.87:.2f} GiB\")\n\nAUDIT[\"attention\"] = {\"cache_kwargs\": SpyLayer.seen[\"cache_kwargs\"],\n                      \"decoder_discards_weights\": \"hidden_states, _ = self.self_attn\" in dl,\n                      \"hook_target\": \"model.layers[i].self_attn\",\n                      \"eager_required\": True,\n                      \"eager_matrix_gib_fp16_at_744\": round(fp16, 3)}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T09:22:28.408808Z","iopub.execute_input":"2026-09-07T09:22:28.409089Z","iopub.status.idle":"2026-09-07T09:22:30.135339Z","shell.execute_reply.started":"2026-09-07T09:22:28.409063Z","shell.execute_reply":"2026-09-07T09:22:30.134077Z"}},"outputs":[{"name":"stdout","text":"resolved attn_implementation: sdpa\n\nupdate() receives cache_kwargs=['cache_position', 'cos', 'sin']  key_states(2, 2, 12, 16)\nquery_states available to the cache: False\n\ndecoder layer discards weights: True\nreturns a bare tensor       : True\n  sdpa   attn_weights: None\n  eager  attn_weights: (2, 4, 12, 12)\n\neager attn matrix at B=16 H=16 S=744: 0.26 GiB fp16 + 0.53 GiB fp32 softmax, transient per layer\n  headroom: 14.56 - 5.87 weights = 8.69 GiB\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# notebooks/21_ac_knob4_env_audit — CELL 5\n# THE DECISIVE PROBE. Under padding_side=\"left\", is a keep-set that is NOT a\n# contiguous suffix maskable at all? get_mask_sizes can only report\n# (kv_length, kv_offset) and sdpa_mask builds arange(kv_length) + kv_offset.\n#\n# Test: same sequence, run alone (no padding) vs in a padded batch. Correct\n# masking => identical greedy output. Divergence isolates mask corruption\n# from the eviction effect itself. Mirrors knob 5's matched batch control.\nimport torch\nfrom transformers.cache_utils import Cache, DynamicLayer\n\nclass EvictLayer(DynamicLayer):\n    \"\"\"Store a subset, return the full states (DynamicSlidingWindowLayer contract).\"\"\"\n    is_sliding = False\n    def __init__(self, keep_sink: int, keep_recent: int):\n        super().__init__()\n        self.keep_sink, self.keep_recent = keep_sink, keep_recent\n        self.cumulative_length = 0\n        self.evicted = 0\n    @property\n    def budget(self):\n        return self.keep_sink + self.keep_recent\n    def update(self, k, v, cache_kwargs=None):\n        if not self.is_initialized:\n            self.lazy_initialization(k, v)\n        self.cumulative_length += k.shape[-2]\n        full_k = torch.cat([self.keys, k], dim=-2)\n        full_v = torch.cat([self.values, v], dim=-2)\n        S = full_k.shape[-2]\n        if S > self.budget:\n            if self.keep_sink:\n                idx = torch.cat([torch.arange(self.keep_sink),\n                                 torch.arange(S - self.keep_recent, S)]).to(full_k.device)\n                self.keys, self.values = full_k.index_select(-2, idx), full_v.index_select(-2, idx)\n            else:\n                self.keys = full_k[:, :, -self.keep_recent:, :]\n                self.values = full_v[:, :, -self.keep_recent:, :]\n            self.evicted += S - self.budget\n        else:\n            self.keys, self.values = full_k, full_v\n        return full_k, full_v\n    def get_seq_length(self):\n        return self.cumulative_length\n    def get_mask_sizes(self, cache_position):\n        q = cache_position.shape[0]\n        stored = self.keys.shape[-2] if self.is_initialized else 0\n        # The only expressible answer: pretend the stored block is contiguous\n        # and ends at the current position. True for recency, a LIE for sink+recent.\n        return stored + q, max(self.cumulative_length - stored, 0)\n\ndef make(factory):\n    return Cache(layers=[factory() for _ in range(tiny.num_hidden_layers)])\n\nPAD, NEW = 0, 8\nlong_ids  = torch.randint(1, 256, (1, 20))\nshort_ids = torch.randint(1, 256, (1, 12))\n# left padding, exactly as the study runs it\npadded = torch.cat([torch.full((1, 8), PAD), short_ids], dim=1)\nbatch_ids  = torch.cat([long_ids, padded], dim=0)\nbatch_mask = torch.cat([torch.ones(1, 20, dtype=torch.long),\n                        torch.cat([torch.zeros(1, 8, dtype=torch.long),\n                                   torch.ones(1, 12, dtype=torch.long)], dim=1)], dim=0)\n\ndef run(ids, mask, factory):\n    with torch.no_grad():\n        return m.generate(input_ids=ids, attention_mask=mask,\n                          past_key_values=make(factory), use_cache=True,\n                          max_new_tokens=NEW, do_sample=False,\n                          pad_token_id=PAD)[:, ids.shape[1]:]\n\nPOLICIES = [(\"full cache (control)\",   lambda: DynamicLayer()),\n            (\"no-op evict (budget 64)\", lambda: EvictLayer(0, 64)),\n            (\"recency window (0+6)\",    lambda: EvictLayer(0, 6)),\n            (\"sink+recent (2+6)\",       lambda: EvictLayer(2, 6))]\n\nprint(f\"{'policy':<26}{'runs':>6}{'row0 b1==b2':>13}{'row1 b1==b2':>13}\")\nfor name, f in POLICIES:\n    try:\n        solo0 = run(long_ids,  torch.ones(1, 20, dtype=torch.long), f)\n        solo1 = run(short_ids, torch.ones(1, 12, dtype=torch.long), f)\n        both  = run(batch_ids, batch_mask, f)\n        a = bool((solo0[0] == both[0]).all())\n        b = bool((solo1[0] == both[1]).all())\n        print(f\"{name:<26}{'yes':>6}{str(a):>13}{str(b):>13}\")\n        AUDIT.setdefault(\"mask_probe\", {})[name] = {\"runs\": True, \"row0\": a, \"row1\": b}\n    except Exception as e:\n        print(f\"{name:<26}{'NO':>6}   {type(e).__name__}: {str(e)[:60]}\")\n        AUDIT.setdefault(\"mask_probe\", {})[name] = {\"runs\": False, \"error\": repr(e)[:200]}\n\n# Which absolute positions does \"keep first N\" actually pin under left padding?\nprint(f\"\\nrow1 has 8 leading PADs; keep_sink=2 pins absolute positions 0,1 \"\n      f\"-> both are PAD tokens, not the system prompt.\")\n\nimport json, os\nos.makedirs(\"results\", exist_ok=True)\nwith open(\"results/knob4_env_audit.json\", \"w\") as fh:\n    json.dump(AUDIT, fh, indent=2)\nprint(\"\\nwrote results/knob4_env_audit.json\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T09:22:30.136781Z","iopub.execute_input":"2026-09-07T09:22:30.137585Z","iopub.status.idle":"2026-09-07T09:22:30.451957Z","shell.execute_reply.started":"2026-09-07T09:22:30.13755Z","shell.execute_reply":"2026-09-07T09:22:30.450226Z"}},"outputs":[{"name":"stdout","text":"policy                      runs  row0 b1==b2  row1 b1==b2\nfull cache (control)         yes         True         True\nno-op evict (budget 64)      yes         True         True\nrecency window (0+6)         yes         True         True\nsink+recent (2+6)            yes         True        False\n\nrow1 has 8 leading PADs; keep_sink=2 pins absolute positions 0,1 -> both are PAD tokens, not the system prompt.\n\nwrote results/knob4_env_audit.json\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"# notebooks/21_ac_knob4_env_audit — CELL 6\n# Is the non-contiguous failure caused by PADDING specifically?\n# If every row in a batch has the same length the padding mask is all-ones,\n# the mis-reported kv_offset selects an all-ones slice, and no stored token is\n# pushed into the future by the causal mask. Test that claim directly, and\n# confirm eviction actually FIRED so this isn't a no-op passing trivially.\nimport torch\nfrom transformers.cache_utils import Cache, DynamicLayer\n\ndef run_keep(ids, mask, factory):\n    cache = Cache(layers=[factory() for _ in range(tiny.num_hidden_layers)])\n    with torch.no_grad():\n        out = m.generate(input_ids=ids, attention_mask=mask,\n                         past_key_values=cache, use_cache=True,\n                         max_new_tokens=NEW, do_sample=False, pad_token_id=PAD)\n    ev = getattr(cache.layers[0], \"evicted\", 0)\n    return out[:, ids.shape[1]:], ev\n\nSINK = lambda: EvictLayer(2, 6)\ntorch.manual_seed(7)\n\n# --- A. length-uniform batch, no padding anywhere --------------------------\nL, R = 16, 4\nuni = torch.randint(1, 256, (R, L))\nuni_mask = torch.ones(R, L, dtype=torch.long)\nbatch_out, ev_b = run_keep(uni, uni_mask, SINK)\nassert ev_b > 0, \"eviction never fired — budget too large to test anything\"\n\nagree = []\nfor r in range(R):\n    solo, _ = run_keep(uni[r:r+1], uni_mask[r:r+1], SINK)\n    agree.append(bool((solo[0] == batch_out[r]).all()))\nprint(f\"uniform batch (R={R}, L={L}, evicted={ev_b} tokens/layer)\")\nprint(f\"  per-row solo == batched: {agree}   all={all(agree)}\")\n\n# --- B. negative control: same policy, one row padded ----------------------\nmix = torch.cat([uni[:R-1], torch.cat([torch.full((1, 6), PAD),\n                                       torch.randint(1, 256, (1, L-6))], dim=1)], dim=0)\nmix_mask = torch.cat([torch.ones(R-1, L, dtype=torch.long),\n                      torch.cat([torch.zeros(1, 6, dtype=torch.long),\n                                 torch.ones(1, L-6, dtype=torch.long)], dim=1)], dim=0)\nmix_out, _ = run_keep(mix, mix_mask, SINK)\nmix_agree = []\nfor r in range(R):\n    solo, _ = run_keep(mix[r:r+1][:, mix_mask[r].bool()],\n                       torch.ones(1, int(mix_mask[r].sum()), dtype=torch.long), SINK)\n    mix_agree.append(bool((solo[0] == mix_out[r]).all()))\nprint(f\"mixed-length batch\")\nprint(f\"  per-row solo == batched: {mix_agree}   padded row (last) = {mix_agree[-1]}\")\n\n# --- C. does the recency window survive BOTH? ------------------------------\nWIN = lambda: EvictLayer(0, 8)\nw_uni, _ = run_keep(uni, uni_mask, WIN)\nw_mix, _ = run_keep(mix, mix_mask, WIN)\nw_ok = []\nfor r in range(R):\n    s_u, _ = run_keep(uni[r:r+1], uni_mask[r:r+1], WIN)\n    s_m, _ = run_keep(mix[r:r+1][:, mix_mask[r].bool()],\n                      torch.ones(1, int(mix_mask[r].sum()), dtype=torch.long), WIN)\n    w_ok.append((bool((s_u[0] == w_uni[r]).all()), bool((s_m[0] == w_mix[r]).all())))\nprint(f\"recency window (uniform, mixed) per row: {w_ok}\")\n\nAUDIT[\"padding_hypothesis\"] = {\n    \"uniform_batch_noncontiguous_ok\": all(agree),\n    \"mixed_batch_noncontiguous_ok\": all(mix_agree),\n    \"padded_row_ok\": mix_agree[-1],\n    \"recency_ok_all\": all(a and b for a, b in w_ok),\n    \"evicted_tokens_per_layer\": int(ev_b)}\n\nimport json\nwith open(\"results/knob4_env_audit.json\", \"w\") as fh:\n    json.dump(AUDIT, fh, indent=2)\nprint(\"\\nupdated results/knob4_env_audit.json\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T09:22:30.453474Z","iopub.execute_input":"2026-09-07T09:22:30.45386Z","iopub.status.idle":"2026-09-07T09:22:30.893632Z","shell.execute_reply.started":"2026-09-07T09:22:30.453817Z","shell.execute_reply":"2026-09-07T09:22:30.892667Z"}},"outputs":[{"name":"stdout","text":"uniform batch (R=4, L=16, evicted=15 tokens/layer)\n  per-row solo == batched: [True, True, True, True]   all=True\nmixed-length batch\n  per-row solo == batched: [True, True, True, False]   padded row (last) = False\nrecency window (uniform, mixed) per row: [(True, True), (True, True), (True, True), (True, True)]\n\nupdated results/knob4_env_audit.json\n","output_type":"stream"}],"execution_count":6}]}