\n# not the docs. Answers audit questions 1-4.\nimport inspect, re, transformers\nfrom transformers import cache_utils\nfrom transformers.generation import configuration_utils as gcfg\n\nprint(f\"transformers {transformers.__version__}  ({cache_utils.__file__})\\n\")\n\nSRC = inspect.getsource(cache_utils)\n\n# --- 1. class inventory, split by level -------------------------------------\nlayers, caches = {}, {}\nfor name, obj in vars(cache_utils).items():\n    if not inspect.isclass(obj) or obj.__module__ != cache_utils.__name__:\n        continue\n    bases = [b.__name__ for b in obj.__bases__]\n    if issubclass(obj, cache_utils.CacheLayerMixin):\n        layers[name] = bases\n    elif issubclass(obj, cache_utils.Cache):\n        caches[name] = bases\n\nprint(\"CacheLayerMixin subclasses:\")\nfor n, b in layers.items():\n    print(f\"  {n:<28} <- {', '.join(b)}\")\nprint(\"\\nCache subclasses:\")\nfor n, b in caches.items():\n    print(f\"  {n:<28} <- {', '.join(b)}\")\n\n# --- 2. does ANY eviction primitive exist? ----------------------------------\nEVICT_TERMS = (\"evict\", \"compress\", \"prune\", \"topk\", \"top_k\",\n               \"budget\", \"drop\", \"keep_\", \"snapkv\", \"h2o\", \"sink\")\nhits = {t: len(re.findall(t, SRC, re.I)) for t in EVICT_TERMS}\nhits = {t: c for t, c in hits.items() if c}\nprint(f\"\\neviction-related terms in cache_utils.py: {hits or 'NONE'}\")\nprint(f\"SinkCache present: {hasattr(cache_utils, 'SinkCache')}\")\n\n# --- 3. what generate() will accept ----------------------------------------\nprint(f\"\\nSTATIC     {gcfg.STATIC_CACHE_IMPLEMENTATIONS}\")\nprint(f\"DYNAMIC    {gcfg.DYNAMIC_CACHE_IMPLEMENTATIONS}\")\nprint(f\"DEPRECATED {gcfg.DEPRECATED_STATIC_CACHE_IMPLEMENTATIONS}\")\n\n# --- 4. the two construction paths, from the installed generate() source ----\nfrom transformers.generation.utils import GenerationMixin\ngsrc = inspect.getsource(GenerationMixin._prepare_cache_for_generation)\nassert \"user_defined_cache = model_