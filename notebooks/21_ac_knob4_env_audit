              <- DynamicLayer\n  QuantoQuantizedLayer         <- QuantizedLayer\n  HQQQuantizedLayer            <- QuantizedLayer\n\nCache subclasses:\n  Cache                        <- object\n  DynamicCache                 <- Cache\n  StaticCache                  <- Cache\n  QuantizedCache               <- Cache\n  EncoderDecoderCache          <- Cache\n\neviction-related terms in cache_utils.py: NONE\nSinkCache present: False\n\nSTATIC     ('static', 'offloaded_static')\nDYNAMIC    ('dynamic', 'dynamic_full', 'offloaded', 'quantized')\nDEPRECATED ('sliding_window', 'hybrid', 'hybrid_chunked', 'offloaded_hybrid', 'offloaded_hybrid_chunked')\n\npast_key_values=<Cache> -> accepted, short-circuits (escape route 1)\ncache_config           -> reaches QuantizedCache ONLY; no class registry\n\nCache.__init__(self, layers: list[transformers.cache_utils.CacheLayerMixin] | None = None, layer_class_to_replicate: type[transformers.cache_utils.CacheLayerMixin] | None = None, offloading: bool = False, offload_only_non_sliding: bool = True)\nDynamicLayer.update(self, key_states: torch.Tensor, value_states: torch.Tensor, cache_kwargs: dict[str, typing.Any] | None = None) -> tuple[torch.Tensor, torch.Tensor]\n\nDynamicSlidingWindowLayer.update contract:\n  stores truncated: True\n  returns full    : True\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# notebooks/21_ac_knob4_env_audit — CELL 3  (corrected: loads CFG itself)\n# Qwen2.5-3B config: is the baseline secretly windowed, and does the 36 KiB\n# per-token arithmetic in the knob-4 scope hold against the real config?\n# config.json only — no weights, no GPU. Answers audit question 5.\nfrom src.config import load_config\nfrom transformers import AutoConfig\nfrom transformers.cache_utils import DynamicCache\n\nCFG = load_config()\ncfg_hf = AutoConfig.from_pretrained(CFG[\"models\"][\"generator\"])\n\nprint(f\"{CFG['models']['generator']}\")\nfor f in (\"num_hidden_layers\", \"num_attention_heads\", \"num_key_value_heads\",\n          \"hidden_size\", \"head_dim\", \"use_sliding_window\", \"sliding_window\",\n          \"max_window_layers\", \"max_position_embeddings\"):\n    print(f\"  {f:<24} {getattr(cfg_hf, f, '<absent>')}\")\n\nlt = getattr(cfg_hf, \"layer_types\", None)\nprint(f\"  layer_types              {set(lt) if lt else None}\"\n      f\"  (n={len(lt) if lt else 0})\")\n\n# The decisive check: config.sliding_window is nulled unless use_sliding_window.\nWINDOWED = cfg_hf.sliding_window is not None\nprint(f\"\\nbaseline would be windowed: {WINDOWED}\")\nassert not WINDOWED, (\"Qwen2.5-3B declares an ACTIVE sliding window — every \"\n                      \"Phase-1 number carries silent truncation. STOP and \"\n                      \"record this before proceeding.\")\n\n# What DynamicCache(config=...) actually builds — this is the fp16 baseline.\nprobe = DynamicCache(config=cfg_hf)\nkinds = {type(l).__name__ for l in probe.layers}\nprint(f\"DynamicCache(config=...) builds {len(probe.layers)} layers: {kinds}\")\nassert kinds == {\"DynamicLayer\"}, kinds\nassert not any(probe.is_sliding)\n\n# --- memory model, recomputed from the config not from memory ---------------\nhd = getattr(cfg_hf, \"head_dim\", cfg_hf.hidden_size // cfg_hf.num_attention_heads)\nbytes_per_token = 2 * cfg_hf.num_key_value_heads * hd * 2 * cfg_hf.num_hidden_layers\nB = CFG[\"generation\"][\"batch_size\"]\nprint(f\"\\nKV per token: 2*{cfg_hf.num_key_value_heads}*{hd}*2B*{cfg_hf.num_hidden_layers}\"\n      f\" = {bytes_per_token/1024:.1f} KiB\")\nfor S, tag in ((744, \"regime1 baseline mean\"), (1524, \"regime1 max\"),\n               (761, \"regime2 baseline mean\"), (2224, \"knob5 k=10\")):\n    print(f\"  S={S:<5} B={B}  ->  {B*S*bytes_per_token/2**30:.3f} GiB   [{tag}]\")\nprint(f\"\\nknob3 MEASURED at S=744,B=16: 0.42 GiB  (weights resident 5.87 GiB)\")\n\nAUDIT[\"qwen2\"] = {\"num_hidden_layers\": cfg_hf.num_hidden_layers,\n                  \"num_key_value_heads\": cfg_hf.n