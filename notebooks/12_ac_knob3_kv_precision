: v for k, v in spec.items() if k != \"allow_flush\"}\n    lab = KV.label(**clean)\n    df = (base if lab == \"kv_fp16\"\n          else R.load_results(OUT, setting=lab, mode=\"short\"))\n    assert len(df) == 1000, f\"{lab}: {len(df)} rows\"\n    agg = Q.aggregate(df.to_dict(\"records\"), k=TOP_K)\n    d = KV.describe(**clean)\n    ident = sum(BASE_PRED.get(q) == p\n                for q, p in zip(df[\"qid\"], df[\"prediction\"])) / 1000\n    rows.append({\n        \"setting\": lab, \"backend\": d[\"backend\"], \"nbits\": d[\"bits\"],\n        \"q_group_size\": d[\"q_group_size\"],\n        \"residual_length\": d[\"residual_length\"],\n        \"effective_bits\": d[\"effective_bits\"],\n        \"compression\": d[\"compression_vs_fp16\"],\n        \"rmse_proxy\": RMSE.get(lab),\n        \"identity_vs_fp16\": round(ident, 4),\n        \"em\": agg[\"em\"], \"f1\": agg[\"f1\"],\n        f\"recall@{TOP_K}\": agg[f\"recall@{TOP_K}\"],\n        \"complete_frac\": agg[\"complete_frac\"],\n        \"em_complete\": agg[\"em_complete\"],\n        \"em_incomplete\": agg[\"em_incomplete\"],\n        \"em_bridge\": agg[\"em_bridge\"], \"em_comparison\": agg[\"em_comparison\"],\n        \"abstain_rate\": agg[\"abstain_rate\"],\n    })\n\nsummary = pd.DataFrame(rows)\nsummary.to_csv(\"results/knob3_summary.csv\", index=False)\n\ncf = summary[\"complete_frac\"].nunique()\nprint(f\"complete_frac distinct values across settings: {cf} \"\n      f\"({'OK — retrieval untouched' if cf == 1 else 'BUG — must be 1'})\")\nprint(summary[[\"setting\", \"effective_bits\", \"compression\", \"rmse_proxy\",\n               \"identity_vs_fp16\", \"em\", \"f1\", \"em_complete\",\n               \"abstain_rate\"]].to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T22:49:37.997773Z","iopub.status.idle":"2026-09-03T22:49:37.998026Z","shell.execute_reply.started":"2026-09-03T22:49:37.997909Z","shell.execute_reply":"2026-09-03T22:49:37.997925Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/12_ac_knob3_kv_precision — CELL 4\n# McNemar exact, paired on qid. Same shape as knobs 1 and 2.\n#\n# Pre-registered: a null claim needs discordant >= 30 AND p > 0.05. Under 10\n# discordant pairs the comparison is UNINFORMATIVE, not evidence of\n# equivalence — a high p with 4 discordant pairs says nothing.\n\nfrom scipy.stats import binomtest\n\ndef em_by_qid(setting):\n    df = (base if setting == \"kv_fp16\"\n          else R.load_results(OUT, setting=setting, mode=\"short\"))\n    return {r[\"qid\"]: Q.exact_match(r[\"prediction\"], r[\"gold_answer\"])\n            for r in df.to_dict(\"records\")}\n\ndef mcnemar(sa, sb, label=None):\n    A, B = em_by_qid(sa), em_by_qid(sb)\n    assert set(A) == set(B), f\"{sa} vs {sb}: qid sets differ\"\n    b = sum(1 for q in A if B[q] == 1 and A[q] == 0)   # sb-only correct\n    c = sum(1 for q in A if A[q] == 1 and B[q] == 0)   # sa-only correct\n    n = b + c\n    p = binomtest(b, n, 0.5).pvalue if n else 1.0\n    if n == 0:\n        verdict = \"IDENTICAL — zero discordant pairs\"\n    elif n < 10:\n        verdict = \"UNINFORMATIVE — too few discordant\"\n    elif p > 0.05 and n >= 30:\n        verdict = \"null, adequately powered\"\n    elif p > 0.05:\n        verdict = \"null, underpowered\"\n    else:\n        verdict = \"SIGNIFICANT\"\n    print(f\"{(label or f'{sa} vs {sb}'):48s} b={b:>3} c={c:>3} \"\n          f\"disc={n:>3} p={p:.4f}  {verdict}\")\n    return {\"a\": sa, \"b_setting\": sb, \"b\": b, \"c\": c, \"discordant\": n,\n            \"p\": round(float(p), 4), \"verdict\": verdict}\n\nMC = {}\nprint(\"--- vs fp16 baseline (does quantization cost quality?) ---\")\nfor spec in RUN_PLAN:\n    lab = KV.label(**{k: v for k, v in spec.items() if k != \"allow_flush\"})\n    MC[f\"fp16_vs_{lab}\"] = mcnemar(\"kv_fp16\", lab)\n\nprint(\"\\n--- backend contrast at matched footprint ---\")\nMC[\"hqq_vs_quanto_n4\"] = mcnemar(\"kv_hqq_n4_g32_r512\", \"kv_quanto_n4_g32_r512\")\nMC[\"hqq_vs_quanto_n2\"] = mcnemar(\"kv_hqq_n2_g32_r512\", \"kv_quanto_n2_g32_r512\")\n\nprint(\"\\n--- residual_length variant (does re-quantization drift cost?) ---\")\nMC[\"r512_vs_r0_n4\"] = mcnemar(\"kv_hqq_n4_g32_r512\", \"kv_hqq_n4_g32_r0\")\n\nprint(\"\\n--- proxy validation: does CPU RMSE predict EM? ---\")\nprox = summary.dropna(subset=[\"rmse_proxy\"])\nsp = prox[[\"rmse_proxy\", \"em\"]].corr(method=\"spearman\").iloc[0, 1]\npe = prox[[\"rmse_proxy\", \"em\"]].corr(method=\"pearson\").iloc[0, 1]\nprint(prox[[\"setting\", \"effective_bits\", \"rmse_proxy\", \"em\",\n            \"identity_vs_fp16\"]].to_string(index=False))\nprint(f\"\\nSpearman(rmse, em) = {sp:.3f}   Pearson = {pe:.3f}   n={len(prox)}\")\nprint(\"Negative and strong => the free CPU sweep predicts downstream quality \"\n      \"and generation runs can be spent sparsely. Weak => RMSE is the wrong \"\n      \"proxy, which is equally worth knowing before Phase 4 leans on it.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T22:49:37.999426Z","iopub.status.idle":"2026-09-03T22:49:37.999802Z","shell.execute_reply.started":"2026-09-03T22:49:37.999603Z","shell.execute_reply":"2026-09-03T22:49:37.999628Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/12_ac_knob3_kv_precision — CELL 5\nimport json\n\nwith open(\"results/knob3_summary.json\", \"w\") as fh:\n    json.dump({\n        \"knob\": 3, \"name\": \"KV cache precision\", \"regime\": 1, \"mode\": \"short\",\n        \"n\": 1000, \"seed\": CFG.get(\"seed\", 42),\n        \"transformers\": \"5.0.0\",\n        \"frozen_constants\": {\n            \"q_group_size\": KV.Q_GROUP_SIZE,\n            \"residual_length\": KV.RESIDUAL_LENGTH,\n            \"axis_per_channel\": KV.PER_CHANNEL_AXIS,\n            \"batch_size\": CFG[\"generation\"][\"batch_size\"],\n            \"max_new_tokens\": CFG[\"generation\"][\"max_new_tokens\"],\n        },\n        \"preregistration_amendments\": [\n            \"backend hqq not optimum-quanto: quanto validates nbits in [2,4], \"\n            \"so 8-bit is unreachable and 8/4/2 is not a single-backend curve\",\n            \"q_group_size 32 not the library default 64: group 64 achieves \"\n            \"per-channel grouping only for even padded lengths, measured at \"\n            \"38.1% of short batches vs 60.3% of explain batches, which would \"\n            \"confound the short-vs-explain contrast\",\n            \"residual_length 512 not the default 128: at 128 a question \"\n            \"flushes only if its answer exceeds 128 tokens, making the \"\n            \"approximation depend on the outcome\",\n            \"group size added as a second precision axis after the smoke run \"\n            \"showed identity saturated at 1.0 for 8- and 4-bit, leaving the \"\n            \"8/4/2 ladder with no resolution between 4 and 2 bits\",\n        ],\n        \"axis_verified_on_real_kv\": \"results/knob3_smoke.json\",\n        \"acceptance_rule\": (\"McNemar exact on paired EM; a null claim requires \"\n                            \"discordant >= 30 and p > 0.05; under 10 \"\n                            \"discordant is uninformative, not equivalence\"),\n        \"mcnemar\": MC,\n        \"proxy_correlation\": {\"spearman\": round(float(sp), 4),\n                              \"pearson\": round(float(pe), 4),\n                              \"n\": int(len(prox))},\n        \"settings\": summary.to_dict(\"records\"),\n    }, fh, indent=2, default=str)\n\nprint(\"wrote results/knob3_summary.json and results/knob3_summary.csv\")\nprint(\"COMMIT AND PUSH results/knob3_*.csv AND results/knob3_summary.json, \"\n      \"THEN TERMINATE — the explain arm is a separate session.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T22:49:38.001278Z","iopub.status.idle":"2026-09-03T22:49:38.001566Z","shell.execute_reply.started":"2026-09-03T22:49:38.001449Z","shell.execute_reply":"20