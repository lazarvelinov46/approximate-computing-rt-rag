 notebooks/12_ac_knob3_kv_precision — CELL 2\n# Ordered by value so a killed session loses the least. resume=True and the\n# per-batch CSV flush mean a re-run picks up where it stopped.\n#\n# Retrieval is recomputed per setting rather than cached. It costs ~34s and\n# buys the invariant check for free: knob 3 does not touch the retriever, so\n# retrieved_ids and prompt_tokens MUST match the baseline exactly. If they\n# drift, something is wrong with the plumbing and the sweep must stop.\n\nRUN_PLAN = [\n    dict(bits=4),                                        # headline + proxy anchor\n    dict(bits=2),                                        # headline\n    dict(bits=8),                                        # headline\n    dict(bits=3),                                        # proxy\n    dict(bits=2, q_group_size=16),                       # cliff + Pareto point\n    dict(bits=3, q_group_size=16),                       # cliff\n    dict(bits=4, backend=\"quanto\"),                      # backend contrast\n    dict(bits=2, backend=\"quanto\"),                      # backend contrast\n    dict(bits=1),                                        # endpoint\n    dict(bits=4, residual_length=0, allow_flush=True),   # variant\n]\n\ndef spec_label(spec):\n    return KV.label(**{k: v for k, v in spec.items() if k != \"allow_flush\"})\n\nt_all = time.time()\nfor si, spec in enumerate(RUN_PLAN):\n    lab = spec_label(spec)\n    print(f\"\\n{'='*70}\\n[{si+1}/{len(RUN_PLAN)}] {lab}  spec={spec}\")\n    t0 = time.time()\n    R.run_pipeline(\n        exs, CFG,\n        embedder=embedder, generator=gen, gen_tok=tok,\n        mode=\"short\", setting=lab, kv=spec,\n        out_csv=OUT, resume=True, progress=True,\n    )\n    df = R.load_results(OUT, setting=lab, mode=\"short\")\n    assert len(df) == 1000, f\"{lab}: {len(df)} rows, expected 1000\"\n\n    bad_ret = [q for q, v in zip(df[\"qid\"], df[\"retrieved_ids\"])\n               if BASE_RET.get(q) != v]\n    bad_len = [q for q, v in zip(df[\"qid\"], df[\"prompt_tokens\"])\n               if int(BASE_PLEN.get(q, -1)) != int(v)]\n    assert not bad_ret, f\"{lab}: retrieved_ids differ on {len(bad_ret)} questions\"\n    assert not bad_len, f\"{lab}: prompt_tokens differ on {len(bad_len)} questions\"\n\n    ident = sum(BASE_PRED.get(q) == p for q, p in zip(df[\"qid\"], df[\"prediction\"]))\n    agg = Q.aggregate(df.to_dict(\"records\"), k=TOP_K)\n    mins = (time.time() - t0) / 60\n    print(f\"  {mins:.1f} min | em {agg['em']:.4f}  f1 {agg['f1']:.4f}  \"\n          f\"em_complete {agg['em_complete']:.4f}  \"\n          f\"abstain {agg['abstain_rate']:.4f}  identity {ident/1000:.4f}\")\n    print(f\"  retrieval invariants hold. elapsed total \"\n          f\"{(time.time()-t_all)/60:.0f} min\")\n    print(f\"  >>> COMMIT AND PUSH {OUT} NOW <<<\")\n\nprint(f\"\\nsweep complete in {(time.time()-t_all)/60:.0f} min\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T21:39:40.334727Z","iopub.execute_input":"2026-09-03T21:39:40.334987Z","iopub.status.idle":"2026-09-03T22:49:37.997052Z","shell.execute_reply.started":"2026-09-03T21:39:40.33496Z","shell.execute_reply":"2026-09-03T22:49:37.991616Z"}},"outputs":[{"name":"stdout","text":"\n======================================================================\n[1/10] kv_hqq_n4_g32_r512  spec={'bits': 4}\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Batches:   0%|          | 0/157 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"7dec6d6edebc42fba6cec36f7401c6e8"}},"metadata":{}},{"name":"stderr","text":"The following generation flags are not valid and may be ignored: ['temperature', 'top_p', 'top_k']. Set `TRANSFORMERS_VERBOSITY=info` for more details.\n","output_type":"stream"},{"name":"stdout","text":"retrieved + prompted 1000 questions in 32.6s  [mode=short, max_new_tokens=32, kv=kv_hqq_n4_g32_r512]\n  batch 5/63  (44s elapsed)\n  batch 10