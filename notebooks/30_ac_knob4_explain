 {tag}  evict={spec}\")\n        t0 = time.time()\n        R.run_pipeline(\n            exs, CFG,\n            embedder=embedder, generator=gen, gen_tok=tok,\n            mode=\"explain\", setting=tag, evict=spec,\n            batch_size=1,\n            out_csv=OUT, resume=True, progress=True,\n        )\n        df = R.load_results(OUT, setting=tag, mode=\"explain\")\n        assert len(df) == 1000, f\"{tag}: {len(df)} rows\"\n        assert df[\"qid\"].nunique() == 1000, f\"{tag}: duplicate qids\"\n        bad = [q for q, v in zip(df[\"qid\"], df[\"retrieved_ids\"])\n               if BASE_RET.get(q) != v]\n        assert not bad, f\"{tag}: retrieved_ids differ on {len(bad)} questions\"\n\n        a = Q.aggregate(df.to_dict(\"records\"), k=TOP_K)\n        dt = pd.to_numeric(df[\"decode_tokens\"])\n        pf = float((df[\"parsed_ok\"] == 0).mean())\n        print(f\"  {(time.time()-t0)/60:.0f} min | em {a['em']:.4f}  \"\n              f\"f1 {a['f1']:.4f}  recall@{TOP_K} {a[f'recall@{TOP_K}']:.4f}  \"\n              f\"complete_frac {a['complete_frac']:.4f}\")\n        print(f\"    em_complete {a['em_complete']:.4f}  \"\n              f\"em_bridge {a['em_bridge']:.4f}  \"\n              f\"em_comparison {a['em_comparison']:.4f}  \"\n              f\"abstain {a['abstain_rate']:.4f}\")\n        print(f\"    parse_fail {pf:.4f}  trunc {(dt >= CAP - 1).mean():.4f}  \"\n              f\"decode p50 {dt.median():.0f}  p99 {dt.quantile(0.99):.0f}\")\n        print(f\"  elapsed total {(time.time()-t_all)/60:.0f} min\")\n        print(f\"  >>> COMMIT AND PUSH {OUT} NOW <<<\")\n    print(f\"\\n{label} complete in {(time.time()-t_all)/60:.0f} min\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-10T07:45:20.037996Z","iopub.execute_input":"2026-09-10T07:45:20.038554Z","iopub.status.idle":"2026-09-10T07:46:40.938614Z","shell.execute_reply.started":"2026-09-10T07:45:20.038517Z","shell.execute_reply":"2026-09-10T07:46:40.937888Z"}},"outputs":[{"name":"stdout