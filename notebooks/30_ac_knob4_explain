,"output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# notebooks/30_ac_knob4_explain — CELL 2\n# Setup. Separate CSV from the short arm: _completed_qids filters on `setting`\n# alone, so sharing a file across modes would make resume skip explain rows\n# because the short row already exists under the same tag.\nimport time, torch\nimport numpy as np\nimport pandas as pd\nfrom src.config import load_config\nfrom src.data.loader import load_from_config\nimport src.pipeline.rag as R\nimport src.retriever.embed as E\nimport src.generator.model as G\nimport src.metrics.quality as Q\nfrom src.generator import eviction as EV\n\nEV.selftest()\nCFG = load_config()\nexs = load_from_config(CFG)\nTOP_K = CFG[\"retrieval\"][\"top_k\"]\nCAP = CFG[\"generation\"][\"max_new_tokens_explain\"]\nOUT = \"results/knob4_explain_results.csv\"\nBASE_EXPLAIN = \"results/baseline_explain_1k_results.csv\"\n\nbe = R.load_results(BASE_EXPLAIN, setting=\"baseline_explain\", mode=\"explain\")\nassert len(be) == 1000\nagg_be = Q.aggregate(be.to_dict(\"records\"), k=TOP_K)\nprint(f\"frozen explain baseline: em {agg_be['em']:.4f}  f1 {agg_be['f1']:.4f}  \"\n      f\"parse_fail {(be['parsed_ok'] == 0).mean():.4f}  \"\n      f\"decode p50 {pd.to_numeric(be['decode_tokens']).median():.0f}\")\nprint(\"[expect em 0.4240  f1 0.5594  parse_fail 0.0060  p50 92]\")\n\nBASE_RET  = dict(zip(be[\"qid\"], be[\"retrieved_ids\"]))\nBASE_PLEN = dict(zip(be[\"qid\"], be[\"prompt_tokens\"]))\n\nembedder = E.load_embedder(CFG[\"models\"][\"embedder\"])\ngen, tok = G.load_generator(CFG[\"models\"][\"generator\"])\nprint(f\"weights resident: {torch.cuda.memory_allocated(0)/2**30:.2f} GiB  \"\n      f\"max_new_tokens {CAP}\")\n\ndef run_arm(plan, label):\n    \"\"\"Run a list of (tag, spec), reporting the project's standard metrics\n    plus the explain-specific ones (parse, truncation, decode length).\"\"\"\n    t_all = time.time()\n    for si, (tag, spec) in enumerate(plan):\n        print(f\"\\n{'='*70}\\n[{si+1}/{len(plan)}] {label}  {tag}  evict={spec}\")\n        t0 = time.time()\n        R.run_pipeline(\n            exs, CFG,\n            embedder=embedder, generator=gen, gen_tok=tok,\n            mode=\"explain\", setting=tag, evict=spec,\n            batch_size=1,\n            out_csv=OUT, resume=True, progress=True,\n        )\n        df = R.load_results(OUT, setting=tag, mode=\"explain\")\n        assert len(df) == 1000, f\"{tag}: {len(df)} rows\"\n        assert df[\"qid\"].nunique() == 1000, f\"{tag}: duplicate qids\"\n        bad = [q for q, v in zip(df[\"qid\"], df[\"retrieved_ids\"])\n               if BASE_RET.get(q) != v]\n        assert not bad, f\"{tag}: retrieved_ids differ on {len(bad)} questions\"\n\n        a = Q.aggregate(df.to_dict(\"records\"), k=TOP_K)\n        dt = pd.to_numeric(df[\"decode_tokens\"])\n        pf = float((df[\"parsed_ok\"] == 0).mean())\n        print(f\"  {(time.time()-t0)/60:.0f} min | em {a['em']:.4f}  \"\n              f\"f1 {a['f1']:.4f}  recall@{TOP_K} {a[f'recall@{TOP_K}']:.4f}  \"\n              f\"complete_frac {a['complete_frac']:.4f}\")\n        print(f\"    em_complete {a['em_complete']:.4f}  \"\n              f\"em_bridge {a['em_bridge']:.4f}  \"\n              f\"em_comparison {a['em_comparison']:.4f}  \"\n              f\"abstain {a['abstain_rate']:.4f}\")\n        print(f\"    parse_fail {pf:.4f}  trunc {(dt >= CAP - 1).mean():.4f}  \"\n              f\"decode p50 {dt.median():.0f}  p99 {dt.quantile(0.99):.0f}\")\n        print(f\"  elapsed total {(time.time()-t_all)/60:.0f} min\")\n        print(f\"  >>> COMMIT AND PUSH {OUT} NOW <<<\")\n    print(f\"\\n{label} complete in {(time.time()-t_all)/60:.0f} min\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-09T12:12:16.311394Z","iopub.execute_input":"2026-09-09T12:12:16.311926Z","iopub.status.idle":"2026-09-09T12:13:50.710843Z","shell.execute_reply.started":"2026-09-09T12:12:16.311891Z","shell.execute_reply":"2026-09-09T12:13: