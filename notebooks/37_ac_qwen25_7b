"\nassert torch.cuda.device_count() == 2, \"need T4 x2: the 7B is split across both cards\"\n\nCFG_Q, CFG_7 = load_config(), load_config(model=\"qwen25_7b\")\nQWEN, SEVEN = CFG_Q[\"models\"][\"generator\"], CFG_7[\"models\"][\"generator\"]\nOUTDIR = results_dir(SEVEN)\nB, TOP_K = CFG_7[\"generation\"][\"batch_size\"], CFG_7[\"retrieval\"][\"top_k\"]\nMNT = {\"short\": CFG_7[\"generation\"][\"max_new_tokens\"],\n       \"explain\": CFG_7[\"generation\"][\"max_new_tokens_explain\"]}\nSYSTEM_OF = {m: G.system_for(SEVEN, m) for m in (\"short\", \"explain\")}\nCEIL = 13.0\n\n# --- weights: the Part-A-verified copy, else the same Hub revision -----------\nwith open(OUTDIR / \"prep_audit.json\") as fh:\n    PREP = json.load(fh)\nREV, FILES = PREP[\"weights\"][\"hub_revision\"], PREP[\"weights\"][\"files\"]\n\ndef sizes_ok(d):\n    return d is not None and all((Path(d) / f).exists() and (Path(d) / f).stat().st_size == v[\"size\"]\n                                 for f, v in FILES.items())\n\nWDIR, t0 = PREP[\"weights\"][\"local_dir\"], time.time()\nif not sizes_ok(WDIR):\n    WDIR = snapshot_download(SEVEN, revision=REV, allow_patterns=list(FILES))\n    print(f\"downloaded {SEVEN}@{REV[:10]} in {(time.time() - t0) / 60:.1f} min\")\nassert sizes_ok(WDIR), \"weights do not match the Part A record\"\n\n# --- pinned two-card load ----------------------------------------------------\nDM = G.device_map_for(CFG_7)\nt0 = time.time()\ngen, tok = G.load_generator(SEVEN, device_map=DM, weights_dir=WDIR)\nLOAD_MIN = (time.time() - t0) / 60\nDEVS = M.model_devices(gen)\nassert DEVS == [0, 1] and gen.config.name_or_path == SEVEN\nassert gen.device == torch.device(\"cuda:0\") and gen.dtype == torch.float16\nPLACE = G.check_placement(gen, DM)\nMEM_W = M.snapshot(DEVS)\n\nembedder = E.load_embedder(CFG_7[\"models\"][\"embedder\"])\nMEM_E = M.snapshot(DEVS)\nemb_gib = MEM_E[\"cuda:0\"][\"allocated\"] - MEM_W[\"cuda:0\"][\"allocated\"]\nprint(f\"{SEVEN}@{REV[:10]} from {WDIR}\\n  load {LOAD_MIN:.1f} min | attn \"\n      f\"{gen.config._attn_implementation} | weights per card {PLACE}\")\nprint(f\"  embedder on cuda:0 +{emb_gib:.2f} GiB | \" + M.fmt(MEM_E))\n\ndef free_all():\n    gc.collect()\n    for d in DEVS:\n        with torch.cuda.device(d):\n            torch.cuda.empty_cache()\n\n# --- data, dev sample, frozen 3B prompts ---------------------------------------\nexs = load_from_config(CFG_7)\nBY_QID = {e.qid: e for e in exs}\ncorpus = C.build_corpus(verbose=False)\nassert corpus.manifest[\"sha256\"] == \\\n    C.load_manifest(\"results/corpus_a1_manifest.json\")[\"sha256\"], \"A1 corpus drifted\"\nfrozen = {e.qid for e in exs}\npool = load_hotpotqa(subset_size=800, seed=7, verbose=False)\ndev = [e for e in pool if e.qid not in frozen][:200]             # notebook 02's dev sample\nassert len(dev) == 200\n\nFROZEN = {  # label -> (csv, setting, mode, regime)\n    \"r1_short_k5\":   (\"results/baseline_1k_results.csv\",         \"baseline\",            \"short\",   1),\n    \"r1_explain_k5\": (\"results/baseline_explain_1k_results.csv\", \"baseline_explain\",    \"explain\", 1),\n    \"r1_short_k10\":  (\"results/knob5_results.csv\",               \"topk_10\",             \"short\",   1),\n    \"r2_short_k5\":   (\"results/regime2_a1_baseline_results.csv\", \"regime2_a1_baseline\", \"short\",   2),\n}\n\ndef frozen_prompts(label):\n    path, setting, mode, regime = FROZEN[label]\n    df = R.load_results(path, setting=setting)\n    out = []\n    for q, s in zip(df.qid, df.retrieved_ids):\n        e, ids = BY_QID[q], [int(x) for x in s.split()]\n        paras = [e.paragraphs[i] for i in ids] if regime == 1 else [corpus.texts[i] for i in ids]\n        out.append(G.build_prompt(tok, e.question, paras, system=SYSTEM_OF[mode]))\n    return out, mode\n\nAUDIT_B = {\"versions\": {p: version(p) for p in (\"transformers\", \"tokenizers\", \"torch\", \"hqq\",\n                                                  \"faiss-cpu\", \"sentence-transformers\", \"datasets\")},\n           \"hub_revision\": REV, \"weights_dir\": str(WDIR),\n           \"load_min\": round(LOAD_MIN, 1), \"device_map_first_layer_on_gpu1\":\n           CFG_7[\"placement\"][\"first_layer_on_gpu1\"], \"weights_gib_per_card\": PLACE,\n           \"mem_after_load\": MEM_E, \"embedder_gib_cuda0\": round(emb_gib, 3)}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-03T16:45:58.504348Z","iopub.execute_input":"2026-11-03T16:45:58.504962Z","iopub.status.idle":"2026-11-03T16:49:16.757101Z","shell.execute_reply.started":"2026-11-03T16:45:58.504936Z","shell.execute_reply":"2026-11-03T16:49:16.756343Z"}},"outputs":[{"name":"stdout","text":"  Installing build dependencies ... \u001b[?25l\u001b[?25hdone\n  Getting requirements to build wheel ... \u001b[?25l\u001b[?25hdone\n  Preparing metadata (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n  Building wheel for hqq (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n/kaggle/working/ac-rag-stack\n\u001b[33md6674f5\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32mmain\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/main\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/HEAD\u001b[m\u001b[33m)\u001b[m Because QK product overflows fp16 with qwen 2.5, added fp32 eager\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Downloading bytes:           |  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"9e1f0440b415441fa96292d3800e6dd2"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Reconstructing (incomplete total...): |          |  0.00B /  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"28f036e78bb14ddc92da34588226f411"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Fetching 11 files:   0%|          | 0/11 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2