ce result was produced on 5.0.0\"\n\nfrom src.config import load_config, results_dir\nCFG_Q = load_config()\nCFG_7 = load_config(model=\"qwen25_7b\")\nQWEN, SEVEN = CFG_Q[\"models\"][\"generator\"], CFG_7[\"models\"][\"generator\"]\n\nchk = copy.deepcopy(CFG_7)\nchk[\"models\"][\"generator\"] = QWEN\nassert chk.pop(\"placement\") == {\"first_layer_on_gpu1\": 14}\nassert chk == CFG_Q, \"the overlay changed more than the generator and its placement\"\nprint(f\"{QWEN} -> {results_dir(QWEN)}\\n{SEVEN} -> {results_dir(SEVEN)}\")\n\n# results/ is a gitignore WHITELIST — a non-whitelisted model dir never pushes.\nos.makedirs(results_dir(SEVEN), exist_ok=True)\nprobe = results_dir(SEVEN) / \"_probe.csv\"\nprobe.touch()\nignored = subprocess.run([\"git\", \"check-ignore\", \"-q\", str(probe)]).returncode == 0\nprobe.unlink()\nassert not ignored, \"results/qwen25_7b/ is gitignored — whitelist it in .gitignore\"\nprint(\"results/qwen25_7b/ is pushable\")\n\nAUDIT = {\"versions\": VERSIONS}","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-11-03T15:17:57.656186Z","iopub.execute_input":"2026-11-03T15:17:57.658011Z","iopub.status.idle":"2026-11-03T15:18:27.2128Z","shell.execute_reply.started":"2026-11-03T15:17:57.657938Z","shell.execute_reply":"2026-11-03T15:18:27.21161Z"}},"outputs":[{"name":"stdout","text":"  Installing build dependencies ... \u001b[?25l\u001b[?25hdone\n  Getting requirements to build wheel ... \u001b[?25l\u001b[?25hdone\n  Preparing metadata (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n  Building wheel for hqq (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n/kaggle/working/ac-rag-stack\n\u001b[33m72ce75f\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32mmain\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/main\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/HEAD\u001b[m\u001b[33m)\u001b[m Updated model so it accepts qwen 7b which goes on 2 cudas. Added script for calculating memory performances\n{'transformers': '5.0.0', 'tokenizers': '0.22.2', 'torch': '2.11.0+cpu', 'hqq': '0.2.8.post1', 'faiss-cpu': '1.15.1', 'sentence-transformers': '5.7.0', 'datasets': '4.8.5'}\nQwen/Qwen2.5-3B-Instruct -> /kaggle/working/ac-rag-stack/results\nQwen/Qwen2.5-7B-Instruct -> /kaggle/working/ac-rag-stack/results/qwen25_7b\nresults/qwen25_7b/ is pushable\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# notebooks/37_ac_qwen25_7b — CELL 2   [CPU]\n# Find an attached copy of the 7B and verify every weight, config and tokenizer\n# file against the Hub's own hashes (sha256 for LFS files, git blob sha1 for\n# the rest). A full match means the copy IS that Hub revision; it is recorded\n# as the arm's snapshot and Part B loads from it. No match: Part B downloads.\nimport glob, hashlib\nfrom pathlib import Path\nfrom huggingface_hub import HfApi\n\ninfo = HfApi().model_info(SEVEN, files_metadata=True)\nNEEDED = [s for s in info.siblings\n          if s.rfilename.endswith((\".safetensors\", \".json\", \".txt\"))]\n\ndef candidates():\n    out = []\n    for cj in glob.glob(\"/kaggle/input/**/config.json\", recursive=True):\n        try:\n            c = json.load(open(cj))\n        except (OSError, ValueError):\n            continue\n        if c.get(\"architectures\") == [\"Qwen2ForCausalLM\"] and c.get(\"hidden_size\") == 3584 \\\n                and c.get(\"num_hidden_layers\") == 28:\n            out.append(Path(cj).parent)\n    return out\n\ndef file_hash(path, lfs):\n    h = hashlib.sha256() if lfs else hashlib.sha1()\n    if not lfs:\n        h.update(f\"blob {path.stat().st_size}\\0\".encode())\n    with open(path, \"rb\") as fh:\n        for chunk in iter(lambda: fh.read(1 << 24), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\nLOCAL = None\ncands = candidates()\nprint(f\"Hub {SEVEN} @ {info.sha}: {len(NEEDED)} files to match\")\nprint(f\"attached candidates: {[str(c) for c in cands] or 'none'}\")\nfor c in cands:\n    t0, bad = time.time(), []\n    for s in NEEDED:\n        p = c / s.rfilename\n        want = s.lfs.sha256 if s.lfs else s.blob_id\n        if not p.exists() or file_hash(p, s.lfs is not None) != want:\n            bad.append(s.rfilename + (\"\" if p.exists() else \" (missing)\"))\n    print(f\"  {c}: {len(NEEDED) - len(bad)}/{len(NEEDED)} match ({time.time() - t0:.0f}s)\"\n          + (f\"  MISMATCH {bad}\" if bad else \"\"))\n    if not bad:\n        LOCAL = c\n        break\n\nAUDIT[\"weights\"] = {\n    \"hub_revision\": info.sha,\n    \"local_dir\": str(LOCAL) if LOCAL else None,\n    \"files\": {s.rfilename: {\"size\": s.size, \"hash\": s.lfs.sha256 if s.lfs else s.blob_id}\n              for s in NEEDED}}\nprint(f\"\\nsnapshot {info.sha} — \" + (f\"Part B loads from {LOCAL}\" if LOCAL else\n      \"no verified copy: Part B downloads ~15 GB per session into /kaggle/temp\"))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-03T15:18:27.214814Z","iopub.execute_input":"2026-11-03T15:18:27.215373Z","iopub.status.idle":"2026-11-03T15:18:27.361507Z","shell.execute_reply.started":"2026-11-03T15:18:27.215335Z","shell.execute_reply":"2026-11-03T15:18:27.360465Z"}},"outputs":[{"name":"stdout","text":"Hub Qwen/Qwen2.5-7B-Instruct @ a09a35458c702b33eeacc393d103063234e8bc28: 11 files to match\nattached candidates: none\n\nsnapshot a09a35458c702b33eeacc393d103063234e8bc28 — no verified copy: Part B downloads ~15 GB per session into /kaggle/temp\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# notebooks/37_ac_qwen25_7b — CELL 3   [CPU]\n# Same family, same prompts? Tokenizer, chat template and generation_config of\n# the 7B against the 3B (repetition_penalty and eos apply under greedy too),\n# then every frozen 3B prompt (4 sets x 1000) rebuilt from its STORED\n# retrieved_ids with both tokenizers. All counts must be 0: prompt_tokens\n# identity then becomes a per-setting assertion for the whole arm.\nimport numpy as np\nfrom transformers import AutoConfig, GenerationConfig\nfrom src.data.loader import load_from_config\nfrom src.data import corpus as C\nimport src.generator.model as G\nimport src.pipeline.rag as R\n\nexs = load_from_config(CFG_7)\nBY_QID = {e.qid: e for e in exs}\ncorpus = C.build_corpus(verbose=False)\nassert corpus.manifest[\"sha256\"] == \\\n    C.load_manifest(\"results/corpus_a1_manifest.json\")[\"sha256\"], \"A1 corpus drifted\"\n\ntok3, tok7 = G.load_tokenizer(QWEN), G.load_tokenizer(SEVEN)\nTOK = {\"vocab\": tok7.get_vocab() == tok3.get_vocab(),\n       \"chat_template\": tok7.chat_template == tok3.chat_template,\n       \"special_tokens\": tok7.all_special_tokens == tok3.all_special_tokens,\n       \"pad_eos\": (tok7.pad_token_id, tok7.eos_token_id) == (tok3.pad_token_id, tok3.eos_token_id),\n       \"backend_json\": tok7.backend_tokenizer.to_str() == tok3.backend_tokenizer.to_str()}\nprint(f\"tokenizer 7B == 3B: {TOK}\")\nassert all(v for k, v in TOK.items() if k != \"backend_json\"), \"tokenizers differ\"\n\ngc3, gc7 = (GenerationConfig.from_pretrained(m).to_diff_dict() for m in (QWEN, SEVEN))\nfor d in (gc3, gc7):\n    d.pop(\"transformers_version\", None)\nGC_DIFF = {k: (gc3.get(k), gc7.get(k)) for k in set(gc3) | set(gc7) if gc3.get(k) != gc7.get(k)}\nprint(f\"generation_config 3B: {gc3}\\n  7B differs on: {GC_DIFF or 'nothing'}\")\nassert not GC_DIFF, \"decoding defaults differ between the models\"\n\nSYSTEM_OF = {m: G.system_for(SEVEN, m) for m in (\"short\", \"explain\")}\nassert SYSTEM_OF == {m: G.system_for(QWEN, m) for m in (\"short\", \"explain\")}\nassert SYSTEM_OF[\"short\"] == G.SYSTEM\n\nFROZEN = {  # label -> (csv, setting, mode, regime)\n    \"r1_short_k5\":   (\"results/baseline_1k_results.csv\",         \"baseline\",            \"short\",   1),\n    \"r1_explain_k5\": (\"results/baseline_explain_1k_results.csv\", \"baseline_explain\",    \"explain\", 1),\n    \"r1_short_k10\":  (\"results/knob5_results.csv\",               \"topk_10\",             \"short\",   1),\n    \"r2_short_k5\":   (\"results/regime2_a1_baseline_results.csv\", \"regime2_a1_baseline\", \"short\",   2),\n}\n\ndef passages(e, ids, regime):\n    return [e.paragraphs[i] for i in ids] if regime == 1 else [corpus.texts[i] for i in ids]\n\ndef rebuild(label, k=None):\n    path, setting, mode, regime = FROZEN[label]\n    df = R.load_results(path, setting=setting)\n    assert len(df) == 1000 and df.qid.nunique() == 1000, f\"{label}: {len(df)} rows\"\n    paras = [passages(BY_QID[q], [int(x) for x in s.split()][:k], regime)\n             for q, s in zip(df.qid, df.retrieved_ids)]\n    prompts = {n: [G.build_prompt(t, BY_QID[q].question, p, system=SYSTEM_OF[mode])\n                   for q, p in zip(df.qid, paras)] for n, t in ((\"3b\", tok3), (\"7b\", tok7))}\n    return df, mode, prompts\n\nPLENS, IDENT = {}, {}\nfor label in FROZEN:\n    df, mode, P = rebuild(label)\n    ids3 = tok3(P[\"3b\"], **G.ENCODE_KWARGS)[\"input_ids\"]\n    ids7 = tok7(P[\"7b\"], **G.ENCODE_KWARGS)[\"input_ids\"]\n    texts = df.raw_generation if mode == \"explain\" else df.prediction\n    res = {\"string\": sum(a != b for a, b in zip(P[\"3b\"], P[\"7b\"])),\n           \"ids\": sum(a != b for a, b in zip(ids3, ids7)),\n           \"prompt_tokens\": sum(len(i) != int(t) for i, t in zip(ids7, df.prompt_tokens)),\n           \"decode_tokens\": sum(G.n_tokens(tok7, t) != int(d)\n                                for t, d in zip(texts, df.decode_tokens))}\n    IDENT[label] = res\n    PLENS[label] = np.array([len(i) for i in ids7])\n    print(f\"{label:<14} \" + \"  \".join(f\"{k} {v}\" for k, v in res.items()))\n    assert not any(res.values()), f\"{label}: 7B prompts differ from the 3B's\"\nfor k in (2, 3):   # k=2/3 are prefixes of the k=5 ranking (verified in knob 5)\n    _, _, P = rebuild(\"r1_short_k5\", k)\n    PLENS[f\"r1_short_k{k}\"] = np.array([G.n_tokens(tok7, p) for p in P[\"7b\"]])\nprint(\"\\n7B prompts byte- and id-identical to the 3B's on all frozen sets\")\n\nGEOM = {m: G.kv_geometry(AutoConfig.from_pretrained(m)) for m in (QWEN, SEVEN)}\nfor m, g in GEOM.items():\n    print(f\"{m}: {g}\")\nassert (GEOM[SEVEN][\"n_layers\"], GEOM[SEVEN][\"n_kv_heads\"], GEOM[SEVEN][\"head_dim\"]) == (28, 4, 128)\n\nAUDIT.update(tokenizer=TOK, generation_config=gc7, prompt_identity=IDENT,\n             geometry={m.split(\"/\")[-1]: g for m, g in GEOM.items()})","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-03T15:18:27.363702Z","iopub.execute_input":"2026-11-03T15:18:27.364067Z","iopub.status.idle":"2026-11-03T15:19:58.867522Z","shell.execute_reply.started":"2026-11-03T15:18:27.364041Z","shell.execute_reply":"2026-11-03T15:19:58.866405Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"README.md:   0%|          | 0.00/9.52k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"3b9406b32b234e3aa1d26722c2ab4a72"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"distractor/train-00000-of-00002.parquet: reconstructing file:   0%|          |  0.00B /  166MB            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"2ed7fc71f2ef4e3c86304b9cb3caa415"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"distractor/train-00000-of-00002.parquet: downloading bytes:           |  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"cd98addcd26e4805a89530fe7d78ef76"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"distractor/train-00001-of-00002.parquet: reconstructing file:   0%|          |  0.00B /  166MB            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"f6d9aff7b8de4ac0b7d7a69b4d4bcba7"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"distr