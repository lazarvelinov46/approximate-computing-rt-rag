ans the 3B's rotation-composition\n#     results (notebook 22; notebook 33 cell 4) hold unchanged.\n# (c) all four eviction policies end-to-end on a tiny model with the 7B's real\n#     attention geometry (28 query / 4 KV heads, head_dim 128).\n# (d) knob 3: per-channel alignment for every real batch, and every planned\n#     setting through the real QuantizedCache at the worst batch, both parities.\nimport torch\nfrom transformers import AutoModelForCausalLM, QuantizedCache\nfrom transformers.models.qwen2.modeling_qwen2 import Qwen2RotaryEmbedding\nfrom src.generator import eviction as EV, kv_cache as KV\n\nPATTERN = r\"cuda:0|\\.cuda\\(|device=0|_memory_stats\\(0\\)|memory_allocated\\(0\\)\"\nhits = subprocess.run([\"grep\", \"-rnE\", \"--include=*.py\", PATTERN, \"src/generator\"],\n                      capture_output=True, text=True).stdout.strip()\nprint(f\"hard-coded device 0 in src/generator: {hits or 'none'}\")\nassert not hits\n\ncfg3, cfg7 = AutoConfig.from_pretrained(QWEN), AutoConfig.from_pretrained(SEVEN)\nassert cfg7.tie_word_embeddings is False, \"tied: lm_head would share embed_tokens' card\"\n\n# --- (a) placement -----------------------------------------------------------\nDM = G.device_map_for(CFG_7)\nwith torch.device(\"meta\"):\n    meta = AutoModelForCausalLM.from_config(cfg7)\ntensors = list(meta.named_parameters()) + list(meta.named_buffers())\nunmapped = [n for n, _ in tensors if G.device_for(n, DM) is None]\nunused = [k for k in DM if not any(n == k or n.startswith(k + \".\") for n, _ in tensors)]\nassert not unmapped and not unused, f\"unmapped {unmapped[:5]} | unused keys {unused}\"\nW = {d: sum(t.numel() * 2 for n, t in tensors if G.device_for(n, DM) == d) / 2**30\n     for d in (0, 1)}\nprint(f\"\\nsplit: layers 0-{CFG_7['placement']['first_layer_on_gpu1'] - 1} on cuda:0 | \"\n      f\"fp16 weights cuda:0 {W[0]:.2f} GiB, cuda:1 {W[1]:.2f} GiB\")\ndel meta\n\n# Per-card estimate: weights + this card's half of the KV cache + the prefill\n# MLP peak (gate·act, up and their product alive together: 3 x B x S x I fp16).\n# The embedder (~0.13 GiB) adds to cuda:0. Ceiling 13.0 GiB, as notebooks 17/33.\nB = CFG_7[\"generation\"][\"batch_size\"]\nMNT = {\"short\": CFG_7[\"generation\"][\"max_new_tokens\"],\n       \"explain\": CFG_7[\"generation\"][\"max_new_tokens_explain\"]}\nI_DIM, CEIL = cfg7.intermediate_size, 13.0\nEST = []\nprint(f\"\\n{'set':<14} {'batch':>5} {'worst':>6} {'KV/card':>8} {'MLP':>6} {'card est':>9}\")\nfor name in (\"r1_short_k2\", \"r1_short_k3\", \"r1_short_k5\", \"r1_short_k10\",\n             \"r1_explain_k5\", \"r2_short_k5\"):\n    mode = \"explain\" if \"explain\" in name else \"short\"\n    for b in ((B, 8) if name == \"r1_short_k10\" else (B,)):\n        pl = PLENS[name]\n        S = int(max(pl[i:i + b].max() for i in range(0, len(pl), b)))\n        kv = GEOM[SEVEN][\"kv_bytes_per_token\"] / 2 * b * (S + MNT[mode]) / 2**30\n        mlp = 3 * b * S * I_DIM * 2 / 2**30\n        card = max(W.values()) + kv + mlp\n        EST.append({\"set\": name, \"batch\": b, \"worst\": S, \"kv_card\": round(kv, 2),\n                    \"mlp\": round(mlp, 2), \"card_est\": round(card, 2), \"under_ceiling\": card < CEIL})\n        print(f\"{name:<14} {b:>5} {S:>6} {kv:>8.2f} {mlp:>6.2f} {card:>9.2f}\"\n              f\"{'' if card < CEIL else '   <-- over ' + str(CEIL)}\")\n\n# --- (b) rope ----------------------------------------------------------------\nEV.selftest()\nrp7 = cfg7.rope_parameters\nassert rp7.get(\"rope_type\", \"default\") in EV.STATIC_ROPE\nr3, r7 = Qwen2RotaryEmbedding(config=cfg3), Qwen2RotaryEmbedding(config=cfg7)\nSAME_ROPE = bool(torch.equal(r3.inv_freq, r7.inv_freq)) and float(r7.attention_scaling) == 1.0\nprint(f\"\\nrope 7B {rp7} | inv_freq identical to 3B: {SAME_ROPE}\")\nassert SAME_ROPE\n\n# --- (c) eviction on the real attention geometry ------------------------------\ntiny = AutoConfig.from_pretrained(SEVEN, num_hidden_layers=2, intermediate_size=256,\n                                  vocab_size=512)\ntorch.manual_seed(42)\nm = AutoModelForCausalLM.from_config(tiny).float().eval()\nm.generation_config.eos_token_id = None            # vocab 512: run every decode step\ngeo = G.kv_geometry(m.config)\nassert (geo[\"n_kv_heads\"], geo[\"q_per_kv\"], geo[\"head_dim\"]) == (4, 7, 128), geo\nassert torch.equal(m.model.rotary_emb.inv_freq, r7.inv_freq)\n\nPROMPT_LEN, NEW = 64, 12\nids = torch.randint(0, 512, (1, PROMPT_LEN))\nmask = torch.ones_like(ids)\n\ndef gen(cache=None):\n    with EV.attention_scoring(m, cache), torch.no_grad():\n        out = m.generate(input_ids=ids, attention_mask=mask, past_key_values=cache,\n                         max_new_tokens=NEW, do_sample=False, pad_token_id=0)\n    return out[:, PROMPT_LEN:]\n\nassert EV.make_cache(m, \"recency\", 1.0) is None\nEV_ROWS = {}\nfor policy in (\"recency\", \"sink_recent\", \"random\", \"attention\"):\n    m.set_attn_implementation(\"eager\" if policy == \"attention\" else \"sdpa\")\n    c = EV.make_cache(m, policy, 0.5)\n    out = gen(c)\n    L0, want = c.layers[0], EV.budget_for(PROMPT_LEN, 0.5, policy)\n    phase_ok = all(bool((l.phase.diff() == 1).all())\n                   and int(l.phase[-1]) == l.cumulative_length - 1 for l in c.layers)\n    rec = {\"budget\": int(L0.budget), \"stored\": int(L0.keys.shape[-2]),\n           \"evicted\": int(L0.evicted), \"rotations\": int(L0.rotations), \"phase_ok\": phase_ok,\n           \"deterministic\": bool(torch.equal(out, gen(EV.make_cache(m, policy, 0.5))))}\n    if policy == \"attention\":\n        rec[\"scores_finite\"] = all(bool(torch.isfinite(l.scores / l.n_obs.clamp(min=1)).all())\n                                   and bool((l.n_obs > 0).all()) for l in c.layers)\n        rec[\"layer_keepsets_differ\"] = (set(c.layers[0]._last_keep.tolist())\n                                        != set(c.layers[1]._last_keep.tolist()))\n    EV_ROWS[policy] = rec\n    print(f\"{policy:<12} {rec}\")\n    assert rec[\"budget\"] == want and rec[\"stored\"] == want and rec[\"evicted\"] > 0\n    assert phase_ok and rec[\"deterministic\"]\n    assert (rec[\"rotations\"] == 0) if policy == \"recency\" else (rec[\"rotations\"] > 0)\n    if policy == \"attention\":\n        assert rec[\"scores_finite\"]\nm.set_attn_implementation(\"sdpa\")\ndel m\n\n# --- (d) knob 3 --------------------------------------------------------------\nKV.selftest()\nKVH, HD = GEOM[SEVEN][\"n_kv_heads\"], GEOM[SEVEN][\"head_dim\"]\nALIGN = {}\nfor name, pl in PLENS.items():\n    for b in (B, 8):\n        for G_ in (32, 16):\n            _, s = KV.batch_alignment([int(x) for x in pl], b, q_group_size=G_,\n                                      num_kv_heads=KVH, head_dim=HD)\n            ALIGN[f\"{name}_b{b}_g{G_}\"] = s[\"frac_true_per_channel\"]\nprint(f\"\\nhqq per-channel fraction, every set x batch {B}/8 x G 32/16: \"\n      f\"min {min(ALIGN.values())}\")\nassert min(ALIGN.values()) == 1.0\n\ndef spike(t, channels=(7, 31, 64, 99), gain=20.0):\n    out = t.clone()\n    out[..., list(channels)] *= gain\n    return out\n\ndef rmse_through_cache(cfg, nbits, group, batch, seq, n_kv):\n    torch.manual_seed(42)\n    k = spike(torch.randn(batch, n_kv, seq, HD, dtype=torch.float16))\n    cache = QuantizedCache(backend=\"hqq\", config=cfg, nbits=nbits, axis_key=0, axis_value=0,\n                           q_group_size=group, residual_length=KV.RESIDUAL_LENGTH)\n    cache.update(k, k.clone(), layer_idx=0)                       # prefill: quantized once\n    step = torch.randn(batch, n_kv, 1, HD, dtype=torch.float16)\n    cache.update(step, step.clone(), layer_idx=0)                 # decode: fp16 residual\n    lay = cache.layers[0]\n    rec = lay._dequantize(lay._quantized_keys).float()\n    assert rec.shape == k.shape and torch.isfinite(rec).all()\n    return float((rec - k.float()).pow(2).mean().sqrt())\n\nS_W = int(max(PLENS[\"r1_short_k5\"][i:i + B].max() for i in range(0, 1000, B)))\nHQQ = {}\nprint(f\"worst real batch: {B} x {KVH} KV heads x {S_W} tokens x {HD}\")\nfor nbits, group in ((8, 32), (4, 32), (3, 32), (2, 32), (2, 16)):\n    lab = KV.label(nbits, q_group_size=group)\n    (e0, c0), (e1, c1) = [(rmse_through_cache(cfg7, nbits, group, B, s, KVH),\n                           KV.channels_per_group(B, s, group, KVH, HD)) for s in (S_W, S_W + 1)]\n    HQQ[lab] = {\"rmse\": [round(e0, 5), round(e1, 5)], \"chan_per_group\": [c0, c1]}\n    print(f\"{lab:<20} RMSE {e0:.4f} / {e1:.4f} (padded {S_W} / {S_W + 1}) | chan/grp {c0} / {c1}\")\n    assert c0 == c1 == 1 and abs(e0 - e1) / e0 < 0.05\n\n# Control: 3B geometry, final 8-row batch, G=32, odd length -> 2 chan/grp. Must show.\nq_even, q_odd = (rmse_through_cache(cfg3, 4, 32, 8, s, 2) for s in (744, 745))\nprint(f\"control 3B b8 G32 n4: RMSE even {q_even:.4f} / odd {q_odd:.4f}\")\nassert q_odd > 1.1 * q_even, \"misalignment control did not show — the parity test is uninformative\"\n\nAUDIT.update(placement={\"device_map\": DM, \"weights_gib\": {f\"cuda:{d}\": round(v, 3) for d, v in W.items()},\n                        \"estimates\": EST},\n             rope={\"rope_parameters\": rp7, \"inv_freq_equal_3b\": SAME_ROPE},\n             eviction_tiny_7b=EV_ROWS,\n             knob3={\"alignment_min\": min(ALIGN.values()), \"hqq_7b\": HQQ,\n                    \"control_3b_b8_g32\": [q_even, q_odd]},\n             grep_device0=hits or None)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-03T15:19:58.869003Z","iopub.execute_input":"2026-11-03T15:19:58.869294Z","iopub.status.idle":"2026-11-03T15:23:30.15711Z","shell.execute_reply.started":"2026-11-03T15:19:58.86927Z","shell.execute_reply":"2026-11-03T15:23:30.15608Z"}},"outputs":[{"name":"stdout","text":"hard-coded device 0 in src/generator: none\n\nsplit: layers 0-13 on cuda:0 | fp16 weights cuda:0 7.09 GiB, cuda:1 7.09 GiB\n\nset            batch  worst  KV/card    MLP  card est\nr1_short_k2       16    690     0.31   1.17      8.57\nr1_short_k3       16   1135     0.50   1.92      9.51\nr1_short_k5       16   1524     0.66   2.58     10.34\nr1_short_k10      16   2953     1.28   5.00     13.37   <-- over 13.0\nr1_short_k10       8   2953     0.64   2.50     10.23\nr1_explain_k5     16   1551     0.77   2.63     10.49\nr2_short_k5       16   1325     0.58   2.24      9.92\neviction selftest OK\n\nrope 7B {'rope_theta': 1000000.0, 'rope_type': 'default'} | inv_freq identical to 3B: True\nrecency      {'budget': 32, 'stored': 32, 'evicted': 43, 'rotations': 0, 'phase_ok': True, 'deterministic': True}\nsink_recent  {'budget': 32, 'stored': 32, 'evicted': 43, 'rotations': 12, 'phase_ok': True, 'deterministic': True}\nrandom       {'budget': 32, 'stored': 32, 'evicted': 43, 'rotations': 11, 'phase_ok': True, 'deterministic': True}\nattention    {'budget': 32, 'stored': 32, 'evicted': 43, 'rotations': 11, 'phase_ok': True, 'deterministic': True, 'scores_finite': True, 'layer_keepsets_differ': True}\nkv_cache selftest OK\n\nhqq per-channel fraction, every set x batch 16/8 x G 32/16: min 1.0\nworst real batch: 16 x 4 KV heads x 1524 tokens x 128\nkv_hqq_n8_g32_r512   RMSE 0.0161 / 0.0161 (padded 1524 / 1525) | chan/grp 1 / 1\nkv_hqq_n4_g32_r512   RMSE 0.2807 / 0.2813 (padded 1524 / 1525) | chan/grp 1 / 1\nkv_hqq_n3_g32_r512   RMSE 0.6080 / 0.6080 (padded 1524 / 1525) | chan/grp 1 / 1\nkv_hqq_n2_g32_r512   RMSE 1.4311 / 1.4330 (padded 1524 / 1525) | chan/grp 1 / 1\nkv_hqq_n2_g16_r512   RMSE 1.1889 / 1.1906 (padded 1524 / 1525) | chan/grp 1 / 1\ncontrol 3B b8 G32 n4: RMSE even 0.2822 / odd 0.3278\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# notebooks/37_ac_qwen25_7b — CELL 5   [CPU]\nout = results_dir(SEVEN) / \"prep_audit.json\"\nwith open(out, \"w\") as fh:\n    json.dump(AUDIT, fh, indent=2, default=str)\nprint(f\"wrote {out.relative_to(results_dir(QWEN))}\")\nprint(\"COMMIT AND PUSH. Part A done, no GPU used.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-03T15:26:38.506