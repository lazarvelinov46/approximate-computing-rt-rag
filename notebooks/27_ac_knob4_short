pe":"stream"}],"execution_count":1},{"cell_type":"code","source":"# notebooks/27_ac_knob4_short — CELL 2\n# Setup. The frozen baseline is loaded to assert retrieval invariants: knob 4\n# touches only the generator, so retrieved_ids and prompt_tokens must be\n# IDENTICAL to Phase 1 for every setting. Drift means broken plumbing.\nimport time, json, torch\nimport pandas as pd\nfrom src.config import load_config\nfrom src.data.loader import load_from_config\nimport src.pipeline.rag as R\nimport src.retriever.embed as E\nimport src.generator.model as G\nimport src.metrics.quality as Q\nfrom src.generator import eviction as EV\n\nEV.selftest()\n\nCFG = load_config()\nexs = load_from_config(CFG)\nTOP_K = CFG[\"retrieval\"][\"top_k\"]\nMNT = CFG[\"generation\"][\"max_new_tokens\"]\nOUT = \"results/knob4_short_results.csv\"\n\nbase = R.load_results(\"results/baseline_1k_results.csv\", setting=\"baseline\")\nassert len(base) == 1000\nBASE_RET  = dict(zip(base[\"qid\"], base[\"retrieved_ids\"]))\nBASE_PLEN = dict(zip(base[\"qid\"], base[\"prompt_tokens\"]))\nBASE_PRED = dict(zip(base[\"qid\"], base[\"prediction\"]))\nprint(f\"frozen baseline loaded: EM \"\n      f\"{Q.aggregate(base.to_dict('records'), k=TOP_K)['em']:.4f}  [expect 0.3910]\")\n\nembedder = E.load_embedder(CFG[\"models\"][\"embedder\"])\ngen, tok = G.load_generator(CFG[\"models\"][\"generator\"])\nprint(f\"weights resident: {torch.cuda.memory_allocated(0)/2**30:.2f} GiB\")\n\n# The reference is tagged evict_none_b1, NOT 'baseline'. The eviction guard\n# would not stop evict=None at batch 1 from appending into the frozen Phase-1\n# CSV, and a batch-1 run is not the frozen baseline. Every McNemar in this\n# knob runs against evict_none_b1.\nRUN_PLAN = [\n    (\"evict_none_b1\",           None),\n    (\"evict_recency_r075\",      dict(policy=\"recency\",     keep_ratio=0.75)),\n    (\"evict_recency_r050\",      dict(policy=\"recency\",     keep_ratio=0.50)),\n    (\"evict_recency_r025\",      dict(policy=\"recency\",     keep_ratio=0.25)),\n    (\"evict_sink4_r075\",        dict(policy=\"sink_recent\", keep_ratio=0.75)),\n    (\"evict_sink4_r050\",        dict(policy=\"sink_recent\", keep_ratio=0.50)),\n    (\"evict_sink4_r025\",        dict(policy=\"sink_recent\", keep_ratio=0.25)),\n    (\"evict_random_r050_s42\",   dict(policy=\"random\",      keep_ratio=0.50)),\n    (\"evict_attn_r050\",         dict(policy=\"attention\",   keep_ratio=0.50)),\n    (\"evict_sink4_r050_naive\",  dict(policy=\"sink_recent\", keep_ratio=0.50,\n                                     shift_rope=False, allow_naive=True)),\n]\n\n# Labels must match what EV.label() produces, or the CSV tag and the setting\n# record disagree and the close-out joins on the wrong key.\nfor tag, spec in RUN_PLAN:\n    if spec is not None:\n        assert tag == EV.label(**spec), f\"{tag!r} != {EV.label(**spec)!r}\"\nprint(f\"\\n{len(RUN_PLAN)} settings, labels verified against EV.label()\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-08T11:16:11.916553Z","iopub.execute_input":"2026-09-08T11:16:11.916857Z","iopub.status.idle":"2026-09-08T11:17:35.059662Z","shell.execute_reply.started":"2026-09-08T11:16:11.916826Z","shell.execute_reply":"2026-09-08T11:17:35.059015Z"}},"outputs":[{"name":"stdout","text":"eviction selftest OK\n","output_type":"stream"},{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"README.md: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"a94415fb0b2849358c476a3e1df79ca3"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"distractor/train-00000-of-00002.parquet:   0%|          | 0.00/166M [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"601c61fb888