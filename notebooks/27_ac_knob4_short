index.json: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8b097ae5f885449d8c4f4c9832a1ddca"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Downloading (incomplete total...): 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"92cc2b0dcdf04b8aa7874101caf104bc"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Fetching 2 files:   0%|          | 0/2 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"4499269ff1734b0e9e08037f2e80729c"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/434 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b92d14c207de43318418e1af535943c2"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"generation_config.json:   0%|          | 0.00/242 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"0b49436de83b4b1089cc14b6a6cb2814"}},"metadata":{}},{"name":"stdout","text":"weights resident: 5.87 GiB\n\n10 settings, labels verified against EV.label()\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# notebooks/27_ac_knob4_short — CELL 3\n# The sweep. ~1.5 h. resume=True and the per-batch flush mean a killed session\n# picks up where it stopped — at batch 1 that granularity is per question.\n#\n# Retrieval is recomputed per setting (~34s) and buys the invariant check for\n# free: knob 4 does not touch the retriever, so any drift in retrieved_ids or\n# prompt_tokens means the plumbing is wrong and the sweep must stop.\nt_all = time.time()\nsummary = {}\n\nfor si, (tag, spec) in enumerate(RUN_PLAN):\n    print(f\"\\n{'='*70}\\n[{si+1}/{len(RUN_PLAN)}] {tag}  evict={spec}\")\n    t0 = time.time()\n    R.run_pipeline(\n        exs, CFG,\n        embedder=embedder, generator=gen, gen_tok=tok,\n        mode=\"short\", setting=tag, evict=spec,\n        batch_size=1,\n        out_csv=OUT, resume=True, progress=True,\n    )\n    df = R.load_results(OUT, setting=tag, mode=\"short\")\n    assert len(df) == 1000, f\"{tag}: {len(df)} rows, expected 1000\"\n    assert df[\"qid\"].nunique() == 1000, f\"{tag}: duplicate qids\"\n\n    bad_ret = [q for q, v in zip(df[\"qid\"], df[\"retrieved_ids\"])\n               if BASE_RET.get(q) != v]\n    bad_len = [q for q, v in zip(df[\"qid\"], df[\"prompt_tokens\"])\n               if int(BASE_PLEN.get(q, -1)) != int(v)]\n    assert not bad_ret, f\"{tag}: retrieved_ids differ on {len(bad_ret)} questions\"\n    assert not bad_len, f\"{tag}: prompt_tokens differ on {len(bad_len)} questions\"\n\n    agg = Q.aggregate(df.to_dict(\"records\"), k=TOP_K)\n    ident = sum(BASE_PRED.get(q) == p\n                for q, p in zip(df[\"qid\"], df[\"prediction\"])) / 1000\n    dt = pd.to_numeric(df[\"decode_tokens\"])\n    summary[tag] = {**agg, \"identity_vs_frozen\": round(ident, 4),\n                    \"decode_mean\": round(float(dt.mean()), 2),\n                    \"minutes\": round((time.time() - t0) / 60, 1)}\n\n    print(f\"  {summary[tag]['minutes']:.1f} min | em {agg['em']:.4f}  \"\n          f\"f1 {agg['f1']:.4f}  em_complete {agg['em_complete']:.4f}  \"\n          f\"abstain {agg['abstain_rate']:.4f}\")\n    print(f\"  identity vs frozen baseline {ident:.4f}  \"\n          f\"decode_tokens mean {dt.mean():.2f}\")\n    print(f\"  retrieval invariants hold. elapsed total \"\n          f\"{(time.time()-t_all)/60:.0f} min\")\n    print(f\"  >>> COMMIT AND PUSH {OUT} NOW <<<\")\n\nprint(f\"\\nshort arm complete in {(time.time()-t_all)/60:.0f} min\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T20:41:18.440227Z","iopub.execute_input":"2026-09-07T20:41:18.440753Z","iopub.status.idle":"2026-09-07T22:32:05.84074Z","shell.execute_reply.started":"2026-09-07T20:41:18.440725Z","shell.execute_reply":"2026-09-07T22:32:05.839806Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/27_ac_knob4_short — CELL 4\n# The reference check, run BEFORE any eviction result is interpreted.\n# evict_none_b1 must reproduce the frozen baseline. If it does not, the batch-1\n# deviation is not free and every McNemar below inherits an unmeasured effect.\nfrom scipy.stats import binomtest\n\nref = summary[\"evict_none_b1\"]\nprint(f\"evict_none_b1   em {ref['em']:.4f}   [frozen baseline 0.3910]\")\nprint(f\"identity vs frozen predictions: {ref['identity_vs_frozen']:.4f}\")\n\n# Score through score_rows so the normaliser and the k-slice are identical to\n# aggregate(). Q.exact_match is the function; `em` is the key it writes.\ndef em_by_qid(df):\n    return {r[\"qid\"]: r[\"em\"]\n            for r in Q.score_rows(df.to_dict(\"records\"), k=TOP_K)}\n\ne_b1 = em_by_qid(R.load_results(OUT, setting=\"evict_none_b1\", mode=\"short\"))\ne_fz = em_by_qid(base)\nassert set(e_b1) == set(e_fz), \"the two runs cover different questions\"\n\nb = sum(1 for q in e_fz if e_fz[q] == 1 and e_b1[q] == 0)   # frozen only\nc = sum(1 for q in e_fz if e_fz[q] == 0 and e_b1[q] == 1)   # batch-1 only\nprint(f\"\\nMcNemar evict_none_b1 vs frozen baseline: b={b} c={c} \"\n      f\"discordant={b+c}\")\n\nif b + c == 0:\n    print(\"  discordant=0 with identical marginals -> NULL (knob 5 carve-out)\")\nelse:\n    p = binomtest(b, b + c, 0.5).pvalue\n    verdict = (\"NULL, adequately powered\" if p > 0.05 and b + c >= 30\n               else \"NULL but UNDERPOWERED\" if p > 0.05\n               else \"SIGNIFICANT — batch 1 is not free\")\n    print(f\"  p={p:.4f}  -> {verdict}\")\n\n# A reusable helper for the close-out: every eviction setting is measured\n# against evict_none_b1, never against the frozen baseline.\nREF_EM = e_b1\n\ndef mcnemar_vs_ref(tag):\n    e = em_by_qid(R.load_results(OUT, setting=tag, mode=\"short\"))\n    b_ = sum(1 for q in REF_EM if REF_EM[q] == 1 and e[q] == 0)\n    c_ = sum(1 for q in REF_EM if REF_EM[q] == 0 and e[q] == 1)\n    d = b_ + c_\n    p = binomtest(b_, d, 0.5).pvalue if d else 1.0\n    return {\"b\": b_, \"c\": c_, \"discordant\": d, \"p\": round(p, 4)}\n\nprint(f\"\\n{'setting':<26}{'em':>8}{'b':>5}{'c':>5}{'disc':>6}{'p':>9}  verdict\")\nprint(f\"{'evict_none_b1':<26}{ref['em']:>8.4f}{'—':>5}{'—':>5}{'—':>6}{'—':>9}  reference\")\nfor tag, _ in RUN_PLAN[1:]:\n    m = mcnemar_vs_ref(tag)\n    v = (\"SIGNIFICANT\" if m[\"p\"] <= 0.05\n         else \"null\" if m[\"discordant\"] >= 30\n         else \"null\" if m[\"discordant\"] == 0\n         else \"UNINFORMATIVE\")\n    print(f\"{tag:<26}{summary[tag]['em']:>8.4f}{m['b']:>5}{m['c']:>5}\"\n          f\"{m['discordant']:>6}{m['p']:>9.4f}  {v}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T22:33:39.216448Z","iopub.execute_input":"2026-09-07T22:33:39.216899Z","iopub.status.idle":"2026-09-07T22:33:40.180548Z","shell.execute_reply.started":"2026-09-07T22:33:39.216866Z","shell.execute_reply":"2026-09-07T22:33:40.179802Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/27_ac_knob4_short — CELL 5\n# The naive ablation returned metrics IDENTICAL to its shifted twin, not merely\n# close. The smoke test showed 2/32 predictions differing, so this needs ruling\n# in or out before it is recorded as a confirmed prediction.\nimport pandas as pd\n\nsh = R.load_results(OUT, setting=\"evict_sink4_r050\", mode=\"short\")\nna = R.load_results(OUT, setting=\"evict_sink4_r050_naive\", mode=\"short\")\nprint(f\"rows: shifted {len(sh)}  naive {len(na)}\")\nassert sh[\"qid\"].tolist() == na[\"qid\"].tolist(), \"qid order differs\"\n\ndiff = [(q, a, b_) for q, a, b_ in\n        zip(sh[\"qid\"], sh[\"prediction\"], na[\"prediction\"]) if a != b_]\nprint(f\"prediction strings differing: {len(diff)} / 1000\")\nfor q, a, b_ in diff[:5]:\n    print(f\"  {q}: shifted={a[:40]!r}  naive={b_[:40]!r}\")\n\n# Did the naive branch actually run with shifting off? Rebuild both caches and\n# generate one question directly — no CSV, no resume, no ambiguity.\np0 = G.build_prompt(tok, exs[0].question,\n                    [exs[0].paragraphs[i] for i in R.retrieve_all(\n                        embedder, exs[:1], TOP_K)[0]])\n\nc_sh = EV.make_cache(gen, \"sink_recent\", 0.50)\no_sh = G.generate_batch(gen, tok, [p0], MNT,\n                        evict=dict(policy=\"sink_recent\", keep_ratio=0.50))\nc_na = EV.make_cache(gen, \"sink_recent\", 0.50, shift_rope=False,\n                     allow_naive=True)\no_na = G.generate_batch(gen, tok, [p0], MNT,\n                        evict=dict(policy=\"sink_recent\", keep_ratio=0.50,\n                                   shift_rope=False, allow_naive=True))\nprint(f\"\\ndirect single-question check:\")\nprint(f\"  shifted: {o_sh[0][:60]!r}\")\nprint(f\"  naive  : {o_na[0][:60]!r}\")\nprint(f\"  shift_rope flags: {c_sh.layers[0].shift_rope} / {c_na.layers[0].shift_rope}\")\n\n# And confirm the labels are distinct, so resume could not have conflated them.\nprint(f\"\\nlabels: {EV.label(policy='sink_recent', keep_ratio=0.5)!r} vs \"\n      f\"{EV.label(policy='sink_recent', keep_ratio=0.5, shift_rope=False)!r}\")\nprint(f\"settings in CSV: {sorted(pd.read_csv(OUT, usecols=['setting'])['setting'].unique())}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T22:35:02.163041Z","iopub.execute_input":"2026-09-07T22:35:02.163407Z","iopub.status.idle":"2026-09-07T22:35:03.611935Z","shell.execute_reply.started":"2026-09-07T22:35:02.163366Z","shell.execute_reply":"2026-09-07T22:35:03.611282Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/27_ac_knob4_short — CELL 6\n# The naive ablation differs on 32/1000 predictions but produced an IDENTICAL\n# aggregate EM, b and c against the reference — a coincidence, not an artifact\n# (CELL 5: direct check reproduces the difference, shift_rope flags True/False).\n# The ablation must therefore be tested PAIRED AGAINST ITS OWN TWIN, not read\n# off two matching summary rows. This is precisely why the study's acceptance\n# criterion is McNemar and never the aggregate gap.\nfrom scipy.stats import binomtest\n\nsh_em = em_by_qid(R.load_results(OUT, setting=\"evict_sink4_r050\", mode=\"short\"))\nna_em = em_by_qid(R.load_results(OUT, setting=\"evict_sink4_r050_naive\",\n                                 mode=\"short\"))\nassert set(sh_em) == set(na_em)\n\nb = sum(1 for q in sh_em if sh_em[q] == 1 and na_em[q] == 0)  # shifted only\nc = sum(1 for q in sh_em if sh_em[q] == 0 and na_em[q] == 1)  # naive only\nd = b + c\np = binomtest(b, d, 0.5).pvalue if d else 1.0\nprint(f\"shifted vs naive, PAIRED:  b={b} c={c} discordant={d}  p={p:.4f}\")\nprint(f\"  aggregate EM: {summary['evict_sink4_r050']['em']:.4f} vs \"\n      f\"{summary['evict_sink4_r050_naive']['em']:.4f}  (identical — coincidence)\")\nverdict = (\"SIGNIFICANT\" if p <= 0.05\n           else \"null, adequately powered\" if d >= 30\n           else \"UNINFORMATIVE, discordant < 30\")\nprint(f\"  -> {verdict}\")\n\n# Where did the 32 changed predictions go? A prediction can change without\n# changing EM, so separate the two.\nsh_df = R.load_results(OUT, setting=\"evict_sink4_r050\", mode=\"short\")\nna_df = R.load_results(OUT, setting=\"evict_sink4_r050_naive\", mode=\"short\")\nchg = [q for q, a, b_ in zip(sh_df[\"qid\"], sh_df[\"prediction\"],\n                             na_df[\"prediction\"]) if a != b_]\nem_chg = [q for q in chg if sh_em[q] != na_em[q]]\nprint(f\"\\npredictions changed: {len(chg)}   of which EM changed: {len(em_chg)}\"\n      f\"   EM-neutral: {len(chg) - len(em_chg)}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T22:36:26.463769Z","iopub.execute_input":"2026-09-07T22:36:26.464461Z","iopub.status.idle":"2026-09-07T22:36:26.752936Z","shell.execute_reply.started":"2026-09-07T22:36:26.46443Z","shell.execute_reply":"2026-09-07T22:36:26.752171Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/27_ac_knob4_short — CELL 7\n# CELL 6's verdict line was WRONG: it tested d >= 30 before d == 0, so it\n# printed UNINFORMATIVE for the zero-discordant case the study explicitly\n# carves out. Fixing here because the close-out reuses this logic.\ndef verdict(b, c, p):\n    d = b + c\n    if p <= 0.05:\n        return \"SIGNIFICANT\"\n    if d == 0 and b == c:\n        return \"null (zero-discordant carve-out)\"\n    if d >= 30:\n        return \"null, adequately powered\"\n    return f\"UNINFORMATIVE, discordant={d} < 30\"\n\nprint(f\"shifted vs naive: {verdict(0, 0, 1.0)}\")\nprint(\"  32/1000 predictions changed, 0 changed EM, marginals identical\")\n\n# Re-print the full table with the corrected verdict, and add the matched-budget\n# policy contrast that is the knob's headline.\nprint(f\"\\n{'setting':<26}{'em':>8}{'b':>5}{'c':>5}{'disc':>6}{'p':>9}  verdict\")\nprint(f\"{'evict_none_b1':<26}{summary['evict_none_b1']['em']:>8.4f}\"\n      f\"{'—':>5}{'—':>5}{'—':>6}{'—':>9}  reference\")\nfor tag, _ in RUN_PLAN[1:]:\n    m = mcnemar_vs_ref(tag)\n    print(f\"{tag:<26}{summary[tag]['em']:>8.4f}{m['b']:>5}{m['c']:>5}\"\n          f\"{m['discordant']:>6}{m['p']:>9.4f}  \"\n          f\"{verdict(m['b'], m['c'], m['p'])}\")\n\n# --- the mechanism contrast, all at keep_ratio 0.50 -----------------------\nprint(f\"\\nmatched budget (keep_ratio 0.50, ~372 of 744 tokens):\")\nPOL = [(\"attention\", \"evict_attn_r050\"), (\"random\", \"evict_random_r050_s42\"),\n       (\"sink+recent\", \"evict_sink4_r050\"), (\"recency\", \"evict_recency_r050\")]\nfor name, tag in POL:\n    e = summary[tag][\"em\"]\n    print(f\"  {name:<12} EM {e:.4f}   vs reference {e - summary['evict_none_b1']['em']:+.4f}\"\n          f\"   vs random {e - summary['evict_random_r050_s42']['em']:+.4f}\")\n\n# Does any policy beat the coin flip? That is what the random control exists for.\nprint()\nfor name, tag in POL:\n    if tag == \"evict_random_r050_s42\":\n        continue\n    a = em_by_qid(R.load_results(OUT, setting=tag, mode=\"short\"))\n    r = em_by_qid(R.load_results(OUT, setting=\"evict_random_r050_s42\",\n                                 mode=\"short\"))\n    b_ = sum(1 for q in r if a[q] == 1 and r[q] == 0)\n    c_ = sum(1 for q in r if a[q] == 0 and r[q] == 1)\n    p_ = binomtest(b_, b_ + c_, 0.5).pvalue if b_ + c_ else 1.0\n    print(f\"  {name:<12} vs random: b={b_:>3} c={c_:>3} d={b_+c_:>3} \"\n          f\"p={p_:.4f}  {verdict(b_, c_, p_)}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T22:37:19.149419Z","iopub.execute_input":"2026-09-07T22:37:19.149698Z","iopub.status.idle":"2026-09-07T22:37:20.555238Z","shell.execute_reply.started":"2026-09-07T22:37:19.149673Z","shell.execute_reply":"2026-09-07T22:37:20.554319Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/27_ac_knob4_short — CELL 8\n# AMENDMENT: the original RUN_PLAN gave the position policies three keep_ratios\n# and the control policies one, so \"both position policies lose to random\" and\n# \"attention does not beat random\" each rested on a single budget. The\n# asymmetry was an oversight in the setting list, not a design decision. This\n# adds x-axis coverage only — same metric, same acceptance criterion, same\n# reference. ~32 min.\n#\n# Prereqs: CELL 1, then CELL 2. Do NOT rerun CELL 3 — resume=True skips the\n# completed batches but still spends ~34s per setting recomputing retrieval.\nimport time\nimport pandas as pd\n\nADD_PLAN = [\n    (\"evict_random_r075_s42\", dict(policy=\"random\",    keep_ratio=0.75)),\n    (\"evict_random_r025_s42\", dict(policy=\"random\",    keep_ratio=0.25)),\n    (\"evict_attn_r075\",       dict(policy=\"attention\", keep_ratio=0.75)),\n    (\"evict_attn_r025\",       dict(policy=\"attention\", keep_ratio=0.25)),\n]\nfor tag, spec in ADD_PLAN:\n    assert tag == EV.label(**spec), f\"{tag!r} != {EV.label(**spec)!r}\"\n\n# These four must not already be in the CSV — a partial earlier run would make\n# resume=True silently return stale rows under the same tag.\nexisting = set(pd.read_csv(OUT, usecols=[\"setting\"])[\"setting\"].unique())\nclash = [t for t, _ in ADD_PLAN if t in existing]\nassert not clash, f\"already present in {OUT}: {clash}\"\nprint(f\"{len(existing)} settings already in {OUT}, adding {len(ADD_PLAN)}\")\n\nt_all = time.time()\nfor si, (tag, spec) in enumerate(ADD_PLAN):\n    print(f\"\\n{'='*70}\\n[{si+1}/{len(ADD_PLAN)}] {tag}  evict={spec}\")\n    t0 = time.time()\n    R.run_pipeline(\n        exs, CFG,\n        embedder=embedder, generator=gen, gen_tok=tok,\n        mode=\"short\", setting=tag, evict=spec,\n        batch_size=1,\n        out_csv=OUT, resume=True, progress=True,\n    )\n    df = R.load_results(OUT, setting=tag, mode=\"short\")\n    assert len(df) == 1000, f\"{tag}: {len(df)} rows, expected 1000\"\n    assert df[\"qid\"].nunique() == 1000, f\"{tag}: duplicate qids\"\n\n    bad_ret = [q for q, v in zip(df[\"qid\"], df[\"retrieved_ids\"])\n               if BASE_RET.get(q) != v]\n    bad_len = [q for q, v in zip(df[\"qid\"], df[\"prompt_tokens\"])\n               if int(BASE_PLEN.get(q, -1)) != int(v)]\n    assert not bad_ret, f\"{tag}: retrieved_ids differ on {len(bad_ret)} questions\"\n    assert not bad_len, f\"{tag}: prompt_tokens differ on {len(bad_len)} questions\"\n\n    agg = Q.aggregate(df.to_dict(\"records\"), k=TOP_K)\n    dt = pd.to_numeric(df[\"decode_tokens\"])\n    print(f\"  {(time.time()-t0)/60:.1f} min | em {agg['em']:.4f}  \"\n          f\"f1 {agg['f1']:.4f}  em_complete {agg['em_complete']:.4f}  \"\n          f\"abstain {agg['abstain_rate']:.4f}  decode {dt.mean():.2f}\")\n    print(f\"  retrieval invariants hold. elapsed total \"\n          f\"{(time.time()-t_all)/60:.0f} min\")\n    print(f\"  >>> COMMIT AND PUSH {OUT} NOW <<<\")\n\nprint(f\"\\n4 a