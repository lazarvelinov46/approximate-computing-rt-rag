batch-1\n# deviation is not free and every McNemar below inherits an unmeasured effect.\nfrom scipy.stats import binomtest\n\nref = summary[\"evict_none_b1\"]\nprint(f\"evict_none_b1   em {ref['em']:.4f}   [frozen baseline 0.3910]\")\nprint(f\"identity vs frozen predictions: {ref['identity_vs_frozen']:.4f}\")\n\n# Score through score_rows so the normaliser and the k-slice are identical to\n# aggregate(). Q.exact_match is the function; `em` is the key it writes.\ndef em_by_qid(df):\n    return {r[\"qid\"]: r[\"em\"]\n            for r in Q.score_rows(df.to_dict(\"records\"), k=TOP_K)}\n\ne_b1 = em_by_qid(R.load_results(OUT, setting=\"evict_none_b1\", mode=\"short\"))\ne_fz = em_by_qid(base)\nassert set(e_b1) == set(e_fz), \"the two runs cover different questions\"\n\nb = sum(1 for q in e_fz if e_fz[q] == 1 and e_b1[q] == 0)   # frozen only\nc = sum(1 for q in e_fz if e_fz[q] == 0 and e_b1[q] == 1)   # batch-1 only\nprint(f\"\\nMcNemar evict_none_b1 vs frozen baseline: b={b} c={c} \"\n      f\"discordant={b+c}\")\n\nif b + c == 0:\n    print(\"  discordant=0 with identical marginals -> NULL (knob 5 carve-out)\")\nelse:\n    p = binomtest(b, b + c, 0.5).pvalue\n    verdict = (\"NULL, adequately powered\" if p > 0.05 and b + c >= 30\n               else \"NULL but UNDERPOWERED\" if p > 0.05\n               else \"SIGNIFICANT — batch 1 is not free\")\n    print(f\"  p={p:.4f}  -> {verdict}\")\n\n# A reusable helper for the close-out: every eviction setting is measured\n# against evict_none_b1, never against the frozen baseline.\nREF_EM = e_b1\n\ndef mcnemar_vs_ref(tag):\n    e = em_by_qid(R.load_results(OUT, setting=tag, mode=\"short\"))\n    b_ = sum(1 for q in REF_EM if REF_EM[q] == 1 and e[q] == 0)\n    c_ = sum(1 for q in REF_EM if REF_EM[q] == 0 and e[q] == 1)\n    d = b_ + c_\n    p = binomtest(b_, d, 0.5).pvalue if d else 1.0\n    return {\"b\": b_, \"c\": c_, \"discordant\": d, \"p\": round(p, 4)}\n\nprint(f\"\\n{'setting':<26}{'em':>8}{'b':>5}{'c':>5}{'disc':>6}