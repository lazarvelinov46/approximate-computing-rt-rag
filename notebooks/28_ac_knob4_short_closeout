],"execution_count":1},{"cell_type":"code","source":"# notebooks/28_ac_knob4_short_closeout — CELL 2\n# Load all 14 settings and rebuild the summary table. No GPU, no model.\nimport json\nimport pandas as pd\nfrom scipy.stats import binomtest\nfrom src.config import load_config\nimport src.pipeline.rag as R\nimport src.metrics.quality as Q\nfrom src.generator import eviction as EV\n\nCFG = load_config()\nTOP_K = CFG[\"retrieval\"][\"top_k\"]\nOUT = \"results/knob4_short_results.csv\"\nREF = \"evict_none_b1\"\n\nGRID = [                       # (tag, policy, keep_ratio)\n    (REF,                     \"none\",        1.00),\n    (\"evict_recency_r075\",    \"recency\",     0.75),\n    (\"evict_recency_r050\",    \"recency\",     0.50),\n    (\"evict_recency_r025\",    \"recency\",     0.25),\n    (\"evict_sink4_r075\",      \"sink_recent\", 0.75),\n    (\"evict_sink4_r050\",      \"sink_recent\", 0.50),\n    (\"evict_sink4_r025\",      \"sink_recent\", 0.25),\n    (\"evict_random_r075_s42\", \"random\",      0.75),\n    (\"evict_random_r050_s42\", \"random\",      0.50),\n    (\"evict_random_r025_s42\", \"random\",      0.25),\n    (\"evict_attn_r075\",       \"attention\",   0.75),\n    (\"evict_attn_r050\",       \"attention\",   0.50),\n    (\"evict_attn_r025\",       \"attention\",   0.25),\n    (\"evict_sink4_r050_naive\", \"sink_recent_naive\", 0.50),\n]\n\npresent = set(pd.read_csv(OUT, usecols=[\"setting\"])[\"setting\"].unique())\nmissing = [t for t, _, _ in GRID if t not in present]\nassert not missing, f\"missing from {OUT}: {missing}\"\nprint(f\"{len(present)} settings in {OUT}\")\n\nDF, EM = {}, {}\nfor tag, _, _ in GRID:\n    d = R.load_results(OUT, setting=tag, mode=\"short\")\n    assert len(d) == 1000 and d[\"qid\"].nunique() == 1000, f\"{tag}: bad rows\"\n    DF[tag] = d\n    EM[tag] = {r[\"qid\"]: r[\"em\"]\n               for r in Q.score_rows(d.to_dict(\"records\"), k=TOP_K)}\n\nBASE_PLEN = dict(zip(DF[REF][\"qid\"], DF[REF][\"prompt_tokens\"]))\n\nrecords = []\nfor tag, pol, kr in GRID:\n    d, agg = DF[tag], Q.aggregate(DF[tag].to_dict(\"records\"), k=TOP_K)\n    dt = pd.to_numeric(d[\"decode_tokens\"])\n    budgets = [EV.budget_for(int(BASE_PLEN[q]), kr, \"recency\")\n               for q in d[\"qid\"]]\n    records.append({\n        \"setting\": tag, \"policy\": pol, \"keep_ratio\": kr,\n        \"budget_mean\": round(sum(budgets) / len(budgets), 1),\n        \"em\": agg[\"em\"], \"f1\": agg[\"f1\"],\n        \"em_complete\": agg[\"em_complete\"],\n        \"em_incomplete\": agg[\"em_incomplete\"],\n        \"em_bridge\": agg[\"em_bridge\"], \"em_comparison\": agg[\"em_comparison\"],\n        \"abstain_rate\": agg[\"abstain_rate\"],\n        \"decode_mean\": round(float(dt.mean()), 2),\n        \"decode_p99\": round(float(dt.quantile(0.99)), 1),\n        \"trunc_frac\": round(float((dt >= 31).mean()), 4),\n    })\n\nsummary = pd.DataFrame(records)\nsummary.to_csv(\"results/knob4_short_summary.csv\", index=False)\nprint(summary.to_string(index=False))\n\n# The curve, read across policies at matched budget.\npiv = summary[summary.policy != \"sink_recent_naive\"].pivot_table(\n    index=\"keep_ratio\", columns=\"policy\", values=\"em\")\nprint(\"\\nEM at matched keep_ratio:\")\nprint(piv.to_string())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-08T12:46:29.043636Z","iopub.execute_input":"2026-09-08T12:46:29.043967Z","iopub.status.idle":"2026-09-08T12:46:32.604116Z","shell.execute_reply.started":"2026-09-08T12:46:29.043929Z","shell.execute_reply":"2026-09-08T12:46:32.60332Z"}},"outputs":[{"name":"stdout","text":"14 settings in results/knob4_short_results.csv\n               setting            policy  keep_ratio  budget_mean    em     f1  em_complete  em_incomplete  em_bridge  em_comparison  abstain_rate  decode_mean  decode_p99  trunc_frac\n         evict_none_b1              none        1.00        744.0 0.392 0.5078       0.4427         0.1296     0.3601         0.5260         0.009         3.44        10.0       0.000\n    evict_recency_r075           recency        0.75        558.4 0.230 0.3545       0.2661         0.0432     0.1869         0.4115         0.000         5.45        32.0       0.072\n    evict_recency_r050           recency        0.50        372.3 0.161 0.2786       0.1885         0.0185     0.1040         0.4010         0.001         6.03        32.0       0.106\n    evict_recency_r025           recency        0.25        186.4 0.121 0.2298       0.1420         0.0123     0.0569         0.3906         0.001         6.15        32.0       0.105\n      evict_sink4_r075       sink_recent        0.75        558.4 0.358 0.4730       0.4093         0.0926     0.3168         0.5312         0.008         3.76        22.0       0.007\n      evict_sink4_r050       sink_recent        0.50        372.3 0.282 0.3883       0.3234         0.0679     0.2265         0.5156         0.008         3.81        27.0       0.010\n      evict_sink4_r025       sink_recent        0.25        186.4 0.248 0.3527       0.2840         0.0617     0.1856         0.5104         0.010         3.77        31.0       0.011\n evict_random_r075_s42            random        0.75        558.4 0.378 0.4981       0.4272         0.1235     0.3428         0.5260         0.008         3.49        11.0       0.000\n evict_random_r050_s42            random        0.50        372.3 0.320 0.4531       0.3652         0.0864     0.2772         0.5000         0.003         4.10        32.0       0.021\n evict_random_r025_s42            random        0.25        186.4 0.087 0.2049       0.0979         0.0309     0.0767         0.1302         0.000        17.71        32.0       0.487\n       evict_attn_r075         attention        0.75        558.4 0.370 0.4936       0.4177         0.1235     0.3317         0.5312         0.009         3.37        11.0       0.000\n       evict_attn_r050         attention        0.50        372.3 0.337 0.4659       0.3807         0.1111   