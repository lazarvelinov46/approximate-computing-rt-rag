 verdict(b, c, p)}\n    print(f\"{(label or f'{a_tag} vs {b_tag}'):<46} b={b:>3} c={c:>3} \"\n          f\"d={d:>3} p={p:.4f}  {rec['verdict']}\")\n    return rec\n\nMC = {}\nprint(\"--- every setting vs the batch-1 reference ---\")\nfor tag, _, _ in GRID[1:]:\n    MC[f\"ref_vs_{tag}\"] = mcnemar(REF, tag)\n\nprint(\"\\n--- vs the random control at MATCHED budget ---\")\nprint(\"    (the contrast the amendment enabled; b = policy-only correct)\")\nRND = {0.75: \"evict_random_r075_s42\", 0.50: \"evict_random_r050_s42\",\n       0.25: \"evict_random_r025_s42\"}\nfor kr in (0.75, 0.50, 0.25):\n    for pol, tag in ((\"recency\", f\"evict_recency_r{int(kr*100):03d}\"),\n                     (\"sink_recent\", f\"evict_sink4_r{int(kr*100):03d}\"),\n                     (\"attention\", f\"evict_attn_r{int(kr*100):03d}\")):\n        MC[f\"{tag}_vs_random\"] = mcnemar(tag, RND[kr],\n                                         f\"r{kr:.2f} {pol:<12} vs random\")\n    print()\n\nprint(\"--- content vs position at matched budget (attention vs sink+recent) ---\")\nfor kr in (0.75, 0.50, 0.25):\n    r3 = f\"r{int(kr*100):03d}\"\n    MC[f\"attn_vs_sink_{r3}\"] = mcnemar(f\"evict_attn_{r3}\", f\"evict_sink4_{r3}\",\n                                       f\"r{kr:.2f} attention vs sink+recent\")\n\nprint(\"\\n--- RoPE shift ablation, paired against its own twin ---\")\nMC[\"shift_vs_naive\"] = mcnemar(\"evict_sink4_r050\", \"evict_sink4_r050_naive\",\n                               \"shifted vs naive (sink_recent r050)\")\nsh, na = DF[\"evict_sink4_r050\"], DF[\"evict_sink4_r050_naive\"]\nchg = sum(a != b for a, b in zip(sh[\"prediction\"], na[\"prediction\"]))\nprint(f\"  predictions changed: {chg}/1000, EM changed: \"\n      f\"{MC['shift_vs_naive']['discordant']}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-08T12:46:32.607923Z","iopub.execute_input":"2026-09-08T12:46:32.60818Z","iopub.status.idle":"2026-09-08T12:46:32.675486Z","shell.execute_reply.started"