ensor_flatten__()[0])\n        except Exception:\n            pass\n    if isinstance(obj, torch.Tensor):\n        if type(obj) is not torch.Tensor:\n            inner = [getattr(obj, a) for a in\n                     (\"_data\", \"_scale\", \"_zeropoint\", \"_shift\", \"_qtype\")\n                     if hasattr(obj, a)]\n            if inner:\n                seen.add(id(obj))\n                return sum(tensor_bytes(t, seen) for t in inner)\n        seen.add(id(obj))\n        return obj.numel() * obj.element_size()\n    if isinstance(obj, (tuple, list)):\n        return sum(tensor_bytes(o, seen) for o in obj)\n    if isinstance(obj, dict):\n        return sum(tensor_bytes(v, seen) for v in obj.values())\n    if hasattr(obj, \"__dict__\"):\n        return sum(tensor_bytes(v, seen) for v in vars(obj).values())\n    return 0\n\ntorch.manual_seed(42)\nB, S = 1, 256\nprobe = torch.randn(B, KVH, S, HD, dtype=torch.float16)\nn_elem = B * KVH * S * HD\n\nprint(f\"{'nbits':>5} {'group':>6} {'eff bits':>9} {'formula':>8} {'matches':>8}\")\nrows = []\nfor nbits in (1, 8):\n    for G in (16, 32, 64, 128, 256):\n        cache = QuantizedCache(backend=\"hqq\", config=mcfg, nbits=nbits,\n                               axis_key=0, axis_value=0, q_group_size=G,\n                               residual_length=512)\n        cache.update(probe, probe.clone(), layer_idx=0)\n        eff = tensor_bytes(cache.layers[0]._quantized_keys) * 8 / n_elem\n        formula = nbits + 32.0 / G\n        ok = abs(eff - formula) < 1e-6\n        rows.append((nbits, G, eff, ok))\n        print(f\"{nbits:>5} {G:>6} {eff:>9.3f} {formula:>8.3f} {str(ok):>8}\")\n\ncontrol_ok = all(ok for nb, _, _, ok in rows if nb == 8)\none_bit_ok = all(ok for nb, _, _, ok in rows if nb == 1)\nprint(f\"\\ncontrol (nbits=8) matches formula: {control_ok}\")\nif not control_ok:\n    print(\"-> harness problem, not a packing problem. Stop here.\")\nelif one_bit_ok:\n    print(\"-> edit kv_cache.py: _FORMULA_VERIFIED_NBITS = 