, **spec) if spec else None\n    enc = tok([prompt], return_tensors=\"pt\", padding=True).to(gen.device)\n    with EV.attention_scoring(gen, cache), torch.inference_mode():\n        out = gen.generate(**enc, past_key_values=cache,\n                           max_new_tokens=MNT, do_sample=False,\n                           pad_token_id=tok.pad_token_id)\n    text = tok.decode(out[0, enc[\"input_ids\"].shape[-1]:],\n                      skip_special_tokens=True).strip()\n    return text, cache\n\n# --- verify the mirror before trusting anything it produces ---------------\nspec_v = dict(policy=\"sink_recent\", keep_ratio=0.25)\nfor i in range(3):\n    a, _ = run_with_cache(prompts[i], spec_v)\n    b = G.generate_batch(gen, tok, [prompts[i]], MNT, evict=spec_v)[0]\n    assert a == b, f\"mirror diverged on q{i}:\\n  {a!r}\\n  {b!r}\"\nprint(\"run_with_cache matches G.generate_batch on 3 questions\")\n\ndef retention(cache, spans):\n    \"\"\"Per-span fraction of tokens still cached, averaged over the 36 layers.\"\"\"\n    per_layer = EV.kept_origins(cache)\n    n_prompt = spans[\"n_tokens\"]\n    res = {}\n    for name in (\"gold\", \"distractor\"):\n        rows = []\n        for o in per_layer:\n            kept = set(o)\n            tot = hit = 0\n            for (s, t) in spans[name]:\n                tot += t - s\n                hit += sum(1 for p in range(s, t) if p in kept)\n            rows.append(hit / tot if tot else float(\"nan\"))\n        res[name] = float(np.nanmean(rows))\n    for name in (\"question\", \"system\"):\n        sp = spans[name]\n        if sp is None:\n            res[name] = float(\"nan\")\n            continue\n        s, t = sp\n        res[name] = float(np.mean([\n            sum(1 for p in range(s, t) if p in set(o)) / (t - s)\n            for o in per_layer]))\n    res[\"prompt_all\"] = float(np.mean([\n        sum(1 for p in o if p < n_prompt) / n_prompt for o in per_layer]))\n    return res\n\nPLAN = [(pol, kr) for kr in (0.50, 0.2