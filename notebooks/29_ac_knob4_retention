type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# notebooks/29_ac_knob4_retention — CELL 2\n# Setup + token spans. `origin` records each cached key's ORIGINAL absolute\n# position, so at batch 1 (no padding) it indexes the prompt directly. Spans\n# are located by substring search plus the tokenizer's offset mapping, which\n# is independent of the chat-template internals.\nimport time, json, torch\nimport numpy as np\nimport pandas as pd\nfrom src.config import load_config\nfrom src.data.loader import load_from_config\nimport src.pipeline.rag as R\nimport src.retriever.embed as E\nimport src.generator.model as G\nimport src.metrics.quality as Q\nfrom src.generator import eviction as EV\n\nEV.selftest()\nCFG = load_config()\nexs = load_from_config(CFG)\nTOP_K = CFG[\"retrieval\"][\"top_k\"]\nMNT = CFG[\"generation\"][\"max_new_tokens\"]\n\nembedder = E.load_embedder(CFG[\"models\"][\"embedder\"])\ngen, tok = G.load_generator(CFG[\"models\"][\"generator\"])\n\nN_RET = 200\nsub = exs[:N_RET]                       # frozen set, so EM stays comparable\nretr = R.retrieve_all(embedder, sub, TOP_K, progress=True)\nprompts = [G.build_prompt(tok, e.question, [e.paragraphs[i] for i in r])\n           for e, r in zip(sub, retr)]\nprint(f\"{N_RET} questions, prompt tokens mean \"\n      f\"{np.mean([len(tok.encode(p)) for p in prompts]):.0f}\")\n\ndef token_spans(prompt, e, ret):\n    \"\"\"-> dict of name -> (tok_start, tok_end) half-open, plus n_tokens.\"\"\"\n    enc = tok(prompt, return_offsets_mapping=True)\n    offs = enc[\"offset_mapping\"]\n    n = len(enc[\"input_ids\"])\n\n    def span_of(text):\n        ci = prompt.find(text)\n        if ci < 0:\n            return None\n        cj = ci + len(text)\n        idx = [t for t, (a, b) in enumerate(offs) if a < cj and b > ci]\n        return (min(idx), max(idx) + 1) if idx else None\n\n    out = {\"n_tokens\": n, \"gold\": [], \"distractor\": []}\n    for rank, pidx in enumerate(ret):\n        s = span_of(e.paragraphs[pidx])\n        if s is None:\n            continue\n        (\"gold\" if pidx in e.gold_ids else \"distractor\")\n        out[\"gold\" if pidx in e.gold_ids else \"distractor\"].append(s)\n    out[\"question\"] = span_of(f\"Question: {e.question}\")\n    out[\"system\"] = span_of(G.SYSTEM)\n    return out\n\nSPANS = [token_spans(p, e, r) for p, e, r in zip(prompts, sub, retr)]\n\n# Sanity: the offset mapping must describe the SAME tokenization generate sees.\nfor i in (0, 1, 2):\n    assert SPANS[i][\"n_tokens\"] == \\\n        tok([prompts[i]], return_tensors=\"pt\", padding=True)[\"input_ids\"].shape[1]\nok_gold = sum(len(s[\"gold\"]) > 0 for s in SPANS)\nok_q = sum(s[\"question\"] is not None for s in SPANS)\nprint(f\"gold span located: {ok_gold}/{N_RET}   question span: {ok_q}/{N_RET}\")\nprint(f\"gold spans per question: \"\n      f\"{np.mean([len(s['gold']) for s in SPANS]):.2f} \"\n      f\"(recall@5 caps this at 2)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-08T13:17:57.183479Z","iopub.execute_input":"2026-09-08T13:17:57.184021Z","iopub.status.idle":"2026-09-08T13:19:27.449995Z","shell.execute_reply.started":"2026-09-08T13:17:57.183988Z","shell.execute_reply":"2026-09-08T13:19:27.449228Z"}},"outputs":[{"name":"stdout","text":"eviction selftest OK\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"README.md: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"857ec505184942e593ac82b0a063ff59"}},"metadata":{}},{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"distractor/train-00000-of-00002.parquet:   0%|          | 0.00/166M [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"d630596d