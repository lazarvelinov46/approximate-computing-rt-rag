       print(f\"\\n{'='*70}\\n[{si+1}/{len(plan)}] {label}  {tag}  evict={spec}\")\n        t0 = time.time()\n        R.run_pipeline(\n            exs, CFG,\n            embedder=embedder, generator=gen, gen_tok=tok,\n            mode=\"explain\", setting=tag, evict=spec,\n            batch_size=1,\n            out_csv=OUT, resume=True, progress=True,\n        )\n        df = R.load_results(OUT, setting=tag, mode=\"explain\")\n        assert len(df) == 1000, f\"{tag}: {len(df)} rows\"\n        assert df[\"qid\"].nunique() == 1000, f\"{tag}: duplicate qids\"\n        bad = [q for q, v in zip(df[\"qid\"], df[\"retrieved_ids\"])\n               if BASE_RET.get(q) != v]\n        assert not bad, f\"{tag}: retrieved_ids differ on {len(bad)} questions\"\n\n        a = Q.aggregate(df.to_dict(\"records\"), k=TOP_K)\n        dt = pd.to_numeric(df[\"decode_tokens\"])\n        pf = float((df[\"parsed_ok\"] == 0).mean())\n        print(f\"  {(time.time()-t0)/60:.0f} min | em {a['em']:.4f}  \"\n              f\"f1 {a['f1']:.4f}  recall@{TOP_K} {a[f'recall@{TOP_K}']:.4f}  \"\n              f\"complete_frac {a['complete_frac']:.4f}\")\n        print(f\"    em_complete {a['em_complete']:.4f}  \"\n              f\"em_bridge {a['em_bridge']:.4f}  \"\n              f\"em_comparison {a['em_comparison']:.4f}  \"\n              f\"abstain {a['abstain_rate']:.4f}\")\n        print(f\"    parse_fail {pf:.4f}  trunc {(dt >= CAP - 1).mean():.4f}  \"\n              f\"decode p50 {dt.median():.0f}  p99 {dt.quantile(0.99):.0f}\")\n        print(f\"  elapsed total {(time.time()-t_all)/60:.0f} min\")\n        print(f\"  >>> COMMIT AND PUSH {OUT} NOW <<<\")\n    print(f\"\\n{label} complete in {(time.time()-t_all)/60:.0f} min\")\n# append to CELL 2\nfor tag, spec in [\n    (\"evict_none_b1\", None),\n    (\"evict_recency_r025\",    dict(policy=\"recency\",     keep_ratio=0.25)),\n    (\"evict_sink4_r025\",      dict(policy=\"sink_recent\", keep_ratio=0.25)),\n    (\"evict_random_r025_s42\", dict(policy=\"random\",      keep_ratio=0.25)),\n    (\"evict_attn_r025\",       dict(policy=\"attention\",   keep_ratio=0.25)),\n    (\"evict_recency_r050\",    dict(policy=\"recency\",     keep_ratio=0.50)),\n    (\"evict_sink4_r050\",      dict(policy=\"sink_recent\", keep_ratio=0.50)),\n    (\"evict_random_r050_s42\", dict(policy=\"random\",      keep_ratio=0.50)),\n    (\"evict_attn_r050\",       dict(policy=\"attention\",   keep_ratio=0.50)),\n]:\n    if spec is not None:\n        assert tag == EV.label(**spec), f\"{tag!r} != {EV.label(**spec)!r}\"\nprint(\"all 9 explain-arm labels verified against EV.label()\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-12T11:28:42.692244Z","iopub.execute_input":"2026-09-12T11:28:42.693202Z","iopub.status.idle":"2026-09-12T11:30:01.919247Z","shell.execute_reply.started":"2026-09-12T11:28:42.693153Z","shell.execute_reply":"2026-09-12T11:30:01.918508Z"}},"outputs":[{"name":"stdout","text":"eviction selftest OK\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"README.md: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"9b5a471f849a4387b55b3a80cc97bcdd"}},"metadata":{}},{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"distractor/train-00000-of-00002.parquet:   0%|          | 0.00/166M [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"dd17d917b37142be99e2c09261f33754"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"distractor/train-00001-of-00002.parquet:   0%|          | 0.00/166M [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"96b88e480bfb415eabe2220e62a0a513"}},"metadata":{}},{"output_type