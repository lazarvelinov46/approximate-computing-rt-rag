":"code","source":"# notebooks/35_ac_llama32_3b_knob12 — CELL 2\n# Corpus embeddings (~3.5 min), shared by every index below. Helpers read the\n# CSVs, so any cell can be re-run after a restart.\nvecs = RP.embed_corpus(embedder, corpus)\n\nCITE = re.compile(r\"^\\s*(\\[\\d+\\][\\s,;]*)+\")\ndef is_bare(p):\n    return bool(CITE.match(p)) and not CITE.sub(\"\", p).strip()\n\nFILES = {1: (OUTDIR / \"knob1_results.csv\", \"results/knob1_results.csv\"),\n         2: (OUTDIR / \"knob2_results.csv\", \"results/knob2_results.csv\")}\nTAGS = {1: [\"knob1_hnsw_ef32\", \"knob1_hnsw_ef5\", \"knob1_ivf_nprobe1\"],\n        2: [\"knob2_pq_m192\", \"knob2_pq_m64\", \"knob2_pq_m48\", \"knob2_pq_m32\"]}\n\ndef load(path, setting):\n    df = R.load_results(str(path), setting=setting)\n    assert len(df) == 1000 and df.qid.nunique() == 1000, \\\n        f\"{setting}: {len(df)} rows, {df.qid.nunique()} unique qids\"\n    return df\n\ndef hits(df):\n    return {q: Q.exact_match(p, g) for q, p, g in zip(df.qid, df.prediction, df.gold_answer)}\n\ndef mcnemar(ref_df, set_df):\n    A, S = hits(ref_df), hits(set_df)\n    b = sum(1 for q in A if S[q] == 1 and A[q] == 0)     # setting-only correct\n    c = sum(1 for q in A if A[q] == 1 and S[q] == 0)     # reference-only correct\n    p = binomtest(b, b + c, 0.5).pvalue if b + c else 1.0\n    return {\"b\": b, \"c\": c, \"d\": b + c, \"p\": round(float(p), 4), \"verdict\": verdict(b, c, p)}\n\nL_BASE = load(OUTDIR / \"regime2_a1_baseline_results.csv\", \"regime2_a1_baseline\")\nQ_BASE = load(\"results/regime2_a1_baseline_results.csv\", \"regime2_a1_baseline\")\nEM0 = {\"llama\": Q.aggregate(L_BASE.to_dict(\"records\"), k=TOP_K)[\"em\"],\n       \"qwen\":  Q.aggregate(Q_BASE.to_dict(\"records\"), k=TOP_K)[\"em\"]}\n\n# (b, c) published in notebooks 07 / 08 — the recomputation must reproduce them.\nQWEN_KNOWN = {\"knob1_hnsw_ef32\": (2, 11), \"knob1_hnsw_ef5\": (25, 56),\n              \"knob1_ivf_nprobe1\": (39, 139), \"knob2_pq_m64\": (47, 47),\n              \"knob2_pq_m32\": (42, 73)}\n\nREC = {}\ndef check_and_compare(knob, tag):\n    l_path, q_path = FILES[knob]\n    L, Qd = load(l_path, tag), load(q_path, tag)\n    qret = dict(zip(Qd.qid, Qd.retrieved_ids))\n    bad = sum(qret[q] != v for q, v in zip(L.qid, L.retrieved_ids))\n    assert bad == 0, f\"{tag}: retrieved_ids differ from Qwen's on {bad} questions — index not reproduced\"\n    aL, aQ = (Q.aggregate(d.to_dict(\"records\"), k=TOP_K) for d in (L, Qd))\n    mL, mQ = mcnemar(L_BASE, L), mcnemar(Q_BASE, Qd)\n    if tag in QWEN_KNOWN:\n        assert (mQ[\"b\"], mQ[\"c\"]) == QWEN_KNOWN[tag], \\\n            f\"{tag}: Qwen recomputed b={mQ['b']} c={mQ['c']}, published {QWEN_KNOWN[tag]}\"\n    REC[tag] = {\n        \"complete_frac\": aL[\"complete_frac\"],\n        \"llama\": {\"em\": aL[\"em\"], \"dEM\": round(aL[\"em\"] - EM0[\"llama\"], 4), **mL,\n                  \"em_complete\": aL[\"em_complete\"], \"em_incomplete\": aL[\"em_incomplete\"],\n                  \"abstain_rate\": aL[\"abstain_rate\"],\n                  \"bare_cite\": round(float(np.mean([is_bare(p) for p in L.prediction])), 4)},\n        \"qwen\":  {\"em\": aQ[\"em\"], \"dEM\": round(aQ[\"em\"] - EM0[\"qwen\"], 4), **mQ},\n    }\n    print(f\"{tag:<18} cf {aL['complete_frac']:.3f} | llama EM {aL['em']:.3f} \"\n          f\"{REC[tag]['llama']['dEM']:+.3f}  b={mL['b']:>3} c={mL['c']:>3} p={mL['p']:.4f} \"\n          f\"{mL['verdict']:<12} | qwen EM {aQ['em']:.3f} {REC[tag]['qwen']['dEM']:+.3f}  \"\n          f\"p={mQ['p']:.4f} {mQ['verdict']}\")\n\nrun = dict(embedder=embedder, generator=gen, gen_tok=tok, mode=\"short\",\n           resume=True, progress=False)\nprint(f\"regime-2 baselines: llama EM {EM0['llama']:.3f}, qwen EM {EM0['qwen']:.3f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-22T12:24:13.535269Z","iopub.execute_input":"2026-09-22T12:24:13.535916Z","iopub.status.idle":"2026-09-22T12:27:34.971985Z","shell.execute_reply.started":"2026-09-22T