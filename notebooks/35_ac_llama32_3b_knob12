sion(\"transformers\") == \"5.0.0\"\nCFG_L = load_config(model=\"llama32_3b\")\nLLAMA = CFG_L[\"models\"][\"generator\"]\nOUTDIR = results_dir(LLAMA)\nTOP_K = CFG_L[\"retrieval\"][\"top_k\"]\nassert G.system_for(LLAMA, \"short\") == G.SYSTEM_NO_CITE != G.SYSTEM\n\nexs = load_from_config(CFG_L)\ncorpus = C.build_corpus(verbose=False)\nassert corpus.manifest[\"sha256\"] == \\\n    C.load_manifest(\"results/corpus_a1_manifest.json\")[\"sha256\"], \"A1 corpus drifted\"\ngold_global = C.resolve_gold(corpus, exs)\n\ngen, tok = G.load_generator(LLAMA)\nsnap = getattr(gen.config, \"_commit_hash\", None) or HfApi().model_info(LLAMA).sha\nwith open(OUTDIR / \"baselines_summary.json\") as fh:\n    base_snap = json.load(fh)[\"snapshot\"]\nassert snap == base_snap, f\"model snapshot changed since the baselines: {snap} vs {base_snap}\"\nprint(f\"{LLAMA}  snapshot {snap}  weights {torch.cuda.memory_allocated(0) / 2**30:.2f} GiB\")\n\nembedder = E.load_embedder(CFG_L[\"models\"][\"embedder\"])","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-09-22T12:22:25.266482Z","iopub.execute_input":"2026-09-22T12:22:25.266754Z","iopub.status.idle":"2026-09-22T12:24:13.533636Z","shell.execute_reply.started":"2026-09-22T12:22:25.26672Z","shell.execute_reply":"2026-09-22T12:24:13.532913Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m58.4/58.4 kB\u001b[0m \u001b[31m4.2 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25h  Installing build dependencies ... \u001b[?25l\u001b[?25hdone\n  Getting requirements to build wheel ... \u001b[?25l\u001b[?25hdone\n  Preparing metadata (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m18.8/18.8 MB\u001b[0m \u001b[31m61.7 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m:00:01\u001b[0m00: