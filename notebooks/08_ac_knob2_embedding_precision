 I.build_sq_index(vecs, nbits=8)\nassert sq.ntotal == len(corpus) and sq.metric_type == faiss.METRIC_INNER_PRODUCT\nids_c, _ = I.search(sq, qv200, TOP_K)\nsq2 = I.build_sq_index(vecs, nbits=8)\nids_d, _ = I.search(sq2, qv200, TOP_K)\nprint(f\"\\nsq 8-bit ok: {I.bytes_per_vector('sq', nbits=8)} bytes/vector \"\n      f\"({I.bytes_per_vector('flat') / I.bytes_per_vector('sq', nbits=8):.0f}x)\")\nprint(f\"sq rebuild identical: {np.array_equal(ids_c, ids_d)}\")\n\n# --- sanity: quantized search must NOT equal exact search ------------------\nex, _ = I.search(index, qv200, TOP_K)\nprint(f\"\\npq vs exact identical rate: \"\n      f\"{np.mean([np.array_equal(a, b) for a, b in zip(ids_a, ex)]):.3f}\")\nprint(f\"sq vs exact identical rate: \"\n      f\"{np.mean([np.array_equal(c, b) for c, b in zip(ids_c, ex)]):.3f}\")\nprint(\"(both should be < 1.0 — a rate of exactly 1.0 means the index is not \"\n      \"actually quantizing, e.g. training silently no-opped)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-02T12:05:10.15848Z","iopub.execute_input":"2026-09-02T12:05:10.159358Z","iopub.status.idle":"2026-09-02T12:05:43.401872Z","shell.execute_reply.started":"2026-09-02T12:05:10.159312Z","shell.execute_reply":"2026-09-02T12:05:43.401071Z"}},"outputs":[{"name":"stdout","text":"faiss 1.15.0\nIndexPQ has .pq.cp.seed : True\nSQ types available      : ['QT_8bit', 'QT_6bit', 'QT_4bit']\n\npq m=48 ok: 48 bytes/vector (32x)\npq rebuild identical: True   (False -> pin one built index per session, note it in the manifest)\n\nsq 8-bit ok: 384 bytes/vector (4x)\nsq rebuild identical: True\n\npq vs exact identical rate: 0.025\nsq vs exact identical rate: 0.935\n(both should be < 1.0 — a rate of exactly 1.0 means the index is not actually quantizing, e.g. training silently no-opped)\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# notebooks/08_ac_knob2_embedding_precision — CELL 5\n# Dense sweep over compression. No generator. ~3-5 min (PQ k-means dominates).\nimport time\nimport pandas as pd\nimport src.metrics.quality as Q\n\nM_GRID = [192, 128, 96, 64, 48, 32, 24, 16, 12, 8]     # all divide 384\nNBITS_PROBE = [(192, 4), (96, 4), (48, 4)]             # matched-footprint probe\nSQ_GRID = [8, 6, 4]\n\nexact_sets = [set(r) for r in exact_ids]\nFLAT_BYTES = I.bytes_per_vector(\"flat\")\n\n\ndef sweep_point(idx, kind, m, nbits, build_s):\n    ids, _ = I.search(idx, qv, TOP_K)\n    ann = np.mean([len(set(r) & e) / TOP_K for r, e in zip(ids, exact_sets)])\n    rec = np.mean([Q.recall_at_k(list(r), g, TOP_K)\n                   for r, g in zip(ids, gold_global)])\n    comp = np.mean([set(g) <= set(r) for r, g in zip(ids, gold_global)])\n    ident = np.mean([np.array_equal(r, e) for r, e in zip(ids, exact_ids)])\n    bpv = I.bytes_per_vector(kind, m=m, nbits=nbits)\n    return {\n        \"index\": kind, \"m\": m if m else \"-\", \"nbits\": nbits,\n        \"bytes_per_vector\": bpv,\n        \"compression\": round(FLAT_BYTES / bpv, 1),\n        \"corpus_mib\": round(bpv * len(corpus) / 2**20, 1),\n        \"ann_recall\": round(float(ann), 4),\n        \"exact_match_topk\": round(float(ident), 4),\n        \"recall@5\": round(float(rec), 4),\n        \"complete_frac\": round(float(comp), 4),\n        \"build_s\": round(build_s, 1),\n    }\n\n\nrows = [{\"index\": \"flat\", \"m\": \"-\", \"nbits\": 32,\n         \"bytes_per_vector\": FLAT_BYTES, \"compression\": 1.0,\n         \"corpus_mib\": round(FLAT_BYTES * len(corpus) / 2**20, 1),\n         \"ann_recall\": 1.0, \"exact_match_topk\": 1.0,\n         \"recall@5\": 0.768, \"complete_frac\": 0.573, \"build_s\": 0.0}]\n\nfor m in M_GRID:\n    t0 = time.time()\n    idx_ = I.build_pq_index(vecs, m=m, nbits=8)\n    rows.append(sweep_point(idx_, \"pq\", m, 8, time.time() - t0))\n    print(f\"  pq m={m:<4} done\")\n\nfor m, nb in NBITS_PROBE:\n    t0 = time.time()\n    idx_ = I.build_pq_index(vecs, m=m, nbits=nb)\n    rows.append(sweep_point(idx_, \"pq\", m,