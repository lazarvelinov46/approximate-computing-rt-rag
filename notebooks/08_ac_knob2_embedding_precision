": nbits,\n        \"bytes_per_vector\": int(d[\"bytes_per_vector\"]),\n        \"compression\": float(d[\"compression\"]),\n        \"corpus_mib\": float(d[\"corpus_mib\"]),\n        \"ann_recall\": float(d[\"ann_recall\"]),\n        \"exact_match_topk\": float(d[\"exact_match_topk\"]),\n        \"recall@5\": agg[f\"recall@{TOP_K}\"], \"complete_frac\": cf,\n        \"em\": agg[\"em\"], \"f1\": agg[\"f1\"],\n        \"em_projected\": round(cf * EM_COMPLETE + (1 - cf) * EM_INCOMPLETE, 4),\n        \"em_complete\": agg[\"em_complete\"], \"em_incomplete\": agg[\"em_incomplete\"],\n        \"em_bridge\": agg[\"em_bridge\"], \"em_comparison\": agg[\"em_comparison\"],\n        \"abstain_rate\": agg[\"abstain_rate\"],\n    })\n\nsummary2 = pd.DataFrame(records)\nsummary2[\"em_residual\"] = (summary2[\"em\"] - summary2[\"em_projected\"]).round(4)\nsummary2.to_csv(\"results/knob2_summary.csv\", index=False)\n\ncols = [\"setting\", \"compression\", \"corpus_mib\", \"ann_recall\",\n        \"exact_match_topk\", \"recall@5\", \"complete_frac\",\n        \"em\", \"em_projected\", \"em_residual\"]\nprint(summary2[cols].to_string(index=False))\n\n\ndef mcnemar(sa, sb):\n    fa = (\"results/regime2_a1_baseline_results.csv\"\n          if sa.startswith(\"regime2\") else OUT2)\n    fb = (\"results/regime2_a1_baseline_results.csv\"\n          if sb.startswith(\"regime2\") else OUT2)\n    A, B = (RP.load_results_pooled(f, setting=s) for f, s in ((fa, sa), (fb, sb)))\n    for dd in (A, B):\n        dd[\"em\"] = [Q.exact_match(p, g)\n                    for p, g in zip(dd[\"prediction\"], dd[\"gold_answer\"])]\n    mm = A.set_index(\"qid\")[[\"em\"]].join(\n        B.set_index(\"qid\")[[\"em\"]], lsuffix=\"_a\", rsuffix=\"_b\")\n    assert len(mm) == 1000\n    b = int(((mm.em_b == 1) & (mm.em_a == 0)).sum())\n    c = int(((mm.em_a == 1) & (mm.em_b == 0)).sum())\n    p = binomtest(b, b + c, 0.5).pvalue if b + c else 1.0\n    flag = \"\" if b + c >= 10 else \"   <- too few discordant to b