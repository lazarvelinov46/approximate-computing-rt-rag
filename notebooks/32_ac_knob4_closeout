],"execution_count":1},{"cell_type":"code","source":"# notebooks/32_ac_knob4_closeout — CELL 2\n# Join the three arms. Every number here is re-derived from the result CSVs\n# rather than copied from a previous notebook's console output — several of\n# those sessions were terminated early and their output is gone.\nimport json\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import binomtest\nfrom src.config import load_config\nimport src.pipeline.rag as R\nimport src.metrics.quality as Q\nfrom src.generator import eviction as EV\n\nCFG = load_config()\nTOP_K = CFG[\"retrieval\"][\"top_k\"]\nCAP = CFG[\"generation\"][\"max_new_tokens_explain\"]\nREF = \"evict_none_b1\"\n\nSHORT_CSV = \"results/knob4_short_results.csv\"\nEXPL_CSV  = \"results/knob4_explain_results.csv\"\nRET_CSV   = \"results/knob4_retention.csv\"\n\nSHORT_GRID = [\n    (REF, \"none\", 1.00),\n    (\"evict_recency_r075\", \"recency\", 0.75),\n    (\"evict_recency_r050\", \"recency\", 0.50),\n    (\"evict_recency_r025\", \"recency\", 0.25),\n    (\"evict_sink4_r075\", \"sink_recent\", 0.75),\n    (\"evict_sink4_r050\", \"sink_recent\", 0.50),\n    (\"evict_sink4_r025\", \"sink_recent\", 0.25),\n    (\"evict_random_r075_s42\", \"random\", 0.75),\n    (\"evict_random_r050_s42\", \"random\", 0.50),\n    (\"evict_random_r025_s42\", \"random\", 0.25),\n    (\"evict_attn_r075\", \"attention\", 0.75),\n    (\"evict_attn_r050\", \"attention\", 0.50),\n    (\"evict_attn_r025\", \"attention\", 0.25),\n    (\"evict_sink4_r050_naive\", \"sink_recent_naive\", 0.50),\n]\nEXPL_GRID = [(t, p, k) for t, p, k in SHORT_GRID\n             if k in (1.00, 0.50, 0.25) and p != \"sink_recent_naive\"]\n\ndef metrics(path, tag, mode):\n    d = R.load_results(path, setting=tag, mode=mode)\n    assert len(d) == 1000 and d[\"qid\"].nunique() == 1000, f\"{tag}/{mode}\"\n    a = Q.aggregate(d.to_dict(\"records\"), k=TOP_K)\n    dt = pd.to_numeric(d[\"decode_tokens\"])\n    out = {\"em\": a[\"em\"], \"f1\": a[\"f1\"], f\"recall@{TOP_K}\": a[f\"recall@{TOP_K}\"],\n           \"complete_frac\": a[\"complete_frac\"],\n           \"em_complete\": a[\"em_complete\"], \"em_incomplete\": a[\"em_incomplete\"],\n           \"em_bridge\": a[\"em_bridge\"], \"em_comparison\": a[\"em_comparison\"],\n           \"abstain_rate\": a[\"abstain_rate\"],\n           \"decode_p50\": float(dt.median()),\n           \"decode_p99\": float(dt.quantile(0.99))}\n    if mode == \"explain\":\n        hit = dt >= CAP - 1\n        pk = d[\"parsed_ok\"].astype(int)\n        em = pd.Series([r[\"em\"] for r in Q.score_rows(d.to_dict(\"records\"),\n                                                      k=TOP_K)], index=d.index)\n        out.update({\"parse_fail\": round(float((pk == 0).mean()), 4),\n                    \"trunc\": round(float(hit.mean()), 4),\n                    \"parse_given_stopped\": round(float(pk[~hit].mean()), 4),\n                    \"em_given_stopped\": round(float(em[~hit].mean()), 4)})\n    return out\n\nrows = []\nfor tag, pol, kr in SHORT_GRID:\n    rows.append({\"setting\": tag, \"policy\": pol, \"keep_ratio\": kr,\n                 \"mode\": \"short\", **metrics(SHORT_CSV, tag, \"short\")})\nfor tag, pol, kr in EXPL_GRID:\n    rows.append({\"setting\": tag, \"policy\": pol, \"keep_ratio\": kr,\n                 \"mode\": \"explain\", **metrics(EXPL_CSV, tag, \"explain\")})\nALL = pd.DataFrame(rows)\nALL.to_csv(\"results/knob4_all_settings.csv\", index=False)\nprint(f\"{len(ALL)} setting-mode rows\\n\")\n\nprint(\"EM by policy and budget:\")\nprint(ALL[ALL.policy != \"sink_recent_naive\"]\n      .pivot_table(index=[\"mode\", \"keep_ratio\"], columns=\"policy\", values=\"em\")\n      .round(3).to_string())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T12:18:02.737736Z","iopub.execute_input":"2026-09-13T12:18:02.738044Z","iopub.status.idle":"2026-09-13T12:18:09.309059Z","shell.execute_reply.started":"2026-09-13T12:18:02.738008Z","shell.execute_reply":"2026-09-13T