etrics.quality as Q\nimport src.metrics.memory as M\nfrom scripts.plot_phase2 import verdict\n\nassert version(\"transformers\") == \"5.0.0\"\nassert torch.cuda.device_count() == 2, \"need T4 x2: the 7B is split across both cards\"\nCFG_7 = load_config(model=\"qwen25_7b\")\nSEVEN = CFG_7[\"models\"][\"generator\"]\nOUTDIR = results_dir(SEVEN)\nTOP_K = CFG_7[\"retrieval\"][\"top_k\"]\n\nwith open(OUTDIR / \"baselines_summary.json\") as fh:\n    REV = json.load(fh)[\"snapshot\"]\nwith open(OUTDIR / \"prep_audit.json\") as fh:\n    FILES_W = json.load(fh)[\"weights\"][\"files\"]\nWDIR = snapshot_download(SEVEN, revision=REV, allow_patterns=list(FILES_W))\nassert all((Path(WDIR) / f).stat().st_size == v[\"size\"] for f, v in FILES_W.items())\nDM = G.device_map_for(CFG_7)\ngen, tok = G.load_generator(SEVEN, device_map=DM, weights_dir=WDIR)\nDEVS = M.model_devices(gen)\nassert DEVS == [0, 1] and gen.config.name_or_path == SEVEN\nprint(f\"{SEVEN}@{REV[:10]}  weights per card {G.check_placement(gen, DM)}\")\n\nexs = load_from_config(CFG_7)\ncorpus = C.build_corpus(verbose=False)\nassert corpus.manifest[\"sha256\"] == \\\n    C.load_manifest(\"results/corpus_a1_manifest.json\")[\"sha256\"], \"A1 corpus drifted\"\ngold_global = C.resolve_gold(corpus, exs)\nembedder = E.load_embedder(CFG_7[\"models\"][\"embedder\"])","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-11-05T09:26:07.916625Z","iopub.execute_input":"2026-11-05T09:26:07.917002Z","iopub.status.idle":"2026-11-05T09:29:24.473722Z","shell.execute_reply.started":"2026-11-05T09:26:07.916955Z","shell.execute_reply":"2026-11-05T09:29:24.473073Z"}},"outputs":[{"name":"stdout","text":"  Installing build dependencies ... \u001b[?25l\u001b[?25hdone\n  Getting requirements to build wheel ... \u001b[?25l\u001b[?25hdone\n  Preparing metadata (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n  Building wheel for hq