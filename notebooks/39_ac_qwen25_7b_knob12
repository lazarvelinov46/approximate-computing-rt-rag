ication/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"4491f31b4e204597b4d66bfdafb51b84"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/199 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"30d0b936e01e419c946bb9ae821402c5"}},"metadata":{}},{"name":"stderr","text":"BertModel LOAD REPORT from: BAAI/bge-small-en-v1.5\nKey                     | Status     |  | \n------------------------+------------+--+-\nembeddings.position_ids | UNEXPECTED |  | \n\nNotes:\n- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/366 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"9289837f34c345ed903437b95f9a9c17"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.txt:   0%|          | 0.00/232k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"86d3ff54ef5a401ba00b98745a17e575"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer.json:   0%|          | 0.00/711k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"08f60ee138c94755b3ec4cc15d427477"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"special_tokens_map.json:   0%|          | 0.00/125 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"aee21c7bc29b49c9a116e5cb63237108"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/190 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"a84af6e4fb88416b82f930eea1fdbfff"}},"metadata":{}}],"execution_count":1},{"cell_type":"code","source":"# notebooks/39_ac_qwen25_7b_knob12 — CELL 2\n# Helpers read the CSVs, so any cell can be re-run after a restart. ReplayIndex\n# answers I.search() as a FAISS index would, returning the 3B's stored top-k for\n# this setting in exs order (notebook 35). No corpus embedding needed.\nFILES = {1: (OUTDIR / \"knob1_results.csv\", \"results/knob1_results.csv\"),\n         2: (OUTDIR / \"knob2_results.csv\", \"results/knob2_results.csv\")}\nTAGS = {1: [\"knob1_hnsw_ef32\", \"knob1_hnsw_ef5\", \"knob1_ivf_nprobe1\"],\n        2: [\"knob2_pq_m192\", \"knob2_pq_m64\", \"knob2_pq_m48\", \"knob2_pq_m32\"]}\n\ndef load(path, setting):\n    df = R.load_results(str(path), setting=setting)\n    assert len(df) == 1000 and df.qid.nunique() == 1000, \\\n        f\"{setting}: {len(df)} rows, {df.qid.nunique()} unique qids\"\n    return df\n\ndef hits(df):\n    return {q: Q.exact_match(p, g) for q, p, g in zip(df.qid, df.prediction, df.gold_answer)}\n\ndef mcnemar(ref_df, set_df):\n    A, S = hits(ref_df), hits(set_df)\n    b = sum(1 for q in A if S[q] == 1 and A[q] == 0)     # setting-only correct\n    c = sum(1 for q in A if A[q] == 1 and S[q] == 0)     # reference-only correct\n    p = binomtest(b, b + c, 0.5).pvalue if b + c else 1.0\n    return {\"b\": b, \"c\": c, \"d\": b + c, \"p\": round(float(p), 4), \"verdict\": verdict(b, c, p)}\n\nclass ReplayIndex:\n    \"\"\"Minimal FAISS stand-in for I.search: row i = the 3B's stored top-k for exs[i].\"\"\"\n    def __init__(self, path, setting, examples, ntotal):\n        df = load(path, setting)\n        by_qid = {q: [int(x) for x in s.split()] for q, s in zip(df.qid, df.retrieved_ids)}\n        self.ids = np.array([by_qid[e.qid] for e in examples], dtype=\"int64\")\n        self.ntotal = ntotal\n\n    def search(self, q, k):\n        assert q.shape[0] == self.ids.shape[0], \"query count != stored rows\"\n        assert k <= self.ids.shape[1], f\"k={k} exceeds stored depth {self.ids.shape[1]}\"\n        return np.zeros((q.shape[0], k), dtype=\"float32\"), self.ids[:, :k]\n\nS_BASE = load(OUTDIR / \"regime2_a1_baseline_results.csv\", \"regime2_a1_baseline\")\nQ_BASE = load(\"results/regime2_a1_baseline_results.csv\", \"regime2_a1_baseline\")\nEM0 = {\"7b\": Q.aggregate(S_BASE.to_dict(\"records\"), k=TOP_K)[\"em\"],\n       \"3b\": Q.aggregate(Q_BASE.to_dict(\"records\"), k=TOP_K)[\"em\"]}\n\n# (b, c) published in notebooks 07 / 08 — the recomputation must reproduce them.\nQWEN_KNOWN = {\"knob1_hnsw_ef32\": (2, 11), \"knob1_hnsw_ef5\": (25, 56),\n              \"knob1_ivf_nprobe1\": (39, 139), \"knob2_pq_m64\": (47, 47),\n              \"knob2_pq_m32\": (42, 73)}\n\nREC, MEM = {}, {}\ndef check_and_compare(knob, tag):\n    s_path, q_path = FILES[knob]\n    S, Qd = load(s_path, tag), load(q_path, tag).set_index(\"qid\")\n    bad_r = sum(Qd.loc[q, \"retrieved_ids\"] != v for q, v in zip(S.qid, S.retrieved_ids))\n    bad_p = sum(int(Qd.loc[q, \"prompt_tokens\"]) != int(v) for q, v in zip(S.qid, S.prompt_tokens))\n    assert bad_r == 0 and bad_p == 0, \\\n        f\"{tag}: vs 3B, retrieved_ids differ {bad_r}, prompt_tokens differ {bad_p}\"\n    Qd = Qd.reset_index()\n    a7, a3 = (Q.aggregate(d.to_dict(\"records\"), k=TOP_K) for d in (S, Qd))\n    m7, m3 = mcnemar(S_BASE, S), mcnemar(Q_BASE, Qd)\n    if tag in QWEN_KNOWN:\n        assert (m3[\"b\"], m3[\"c\"]) == QWEN_KNOWN[tag], \\\n            f\"{tag}: 3B recomputed b={m3['b']} c={m3['c']}, published {QWEN_KNOWN[tag]}\"\n    d7, d3 = round(a7[\"em\"] - EM0[\"7b\"], 4), round(a3[\"em\"] - EM0[\"3b\"], 4)\n    REC[tag] = {\n        \"complete_frac\": a7[\"complete_frac\"],\n        \"7b\": {\"em\": a7[\"em\"], \"dEM\": d7, **m7, \"em_complete\": a7[\"em_complete\"],\n               \"em_incomplete\": a7[\"em_incomplete\"], \"abstain_rate\": a7[\"abstain_rate\"],\n               \"bang_frac\": round(float(np.mean([\"!\" in p for p in S.prediction])), 4)},\n        \"3b\": 