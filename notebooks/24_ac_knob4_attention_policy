90  ratio 1.134x  (uniform = 0.05000)\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# notebooks/24_ac_knob4_attention_policy — CELL 4  (corrected endpoint)\n# Provenance tracking. `origin` carries each stored key's ORIGINAL absolute\n# position through every index_select, which is what lets the close-out say\n# WHICH prompt tokens each policy threw away.\n#\n# NOTE: max_new_tokens=N produces N tokens but only N-1 cache appends. Prefill\n# emits the first new token; the last one's key is never computed because\n# generation stops. So the final cached position is cumulative_length - 1,\n# not prompt_len + N - 1.\nimport torch\nfrom src.generator import eviction as EV\n\nm.set_attn_implementation(\"eager\")\ncaches = {}\nfor p in (\"recency\", \"sink_recent\", \"random\", \"attention\"):\n    c = EV.make_cache(m, p, keep_ratio=R)\n    _ = gen(c)\n    caches[p] = c\n\nCUM = caches[\"recency\"].layers[0].cumulative_length\nbudget = caches[\"recency\"].layers[0].budget\nassert CUM == PROMPT_LEN + NEW - 1, f\"expected {PROMPT_LEN + NEW - 1}, got {CUM}\"\n\nprint(f\"prompt 0..{PROMPT_LEN-1}, cached decode {PROMPT_LEN}..{CUM-1}, \"\n      f\"budget {budget}\\n\")\nfor p, c in caches.items():\n    o = EV.kept_origins(c)[0]\n    assert len(o) == budget, f\"{p}: kept {len(o)} origins, budget {budget}\"\n    assert len(set(o)) == len(o), f\"{p}: duplicate origins\"\n    assert max(o) == CUM - 1, f\"{p}: newest cached token not retained\"\n    assert min(o) >= 0 and max(o) < CUM, f\"{p}: origin out of range\"\n    from_prompt = [x for x in o if x < PROMPT_LEN]\n    print(f\"{p:<12} {len(from_prompt):>2}/{budget} from the prompt   \"\n          f\"origins {o[:6]}...{o[-3:]}\")\n\n# Recency is the ground truth: its keep-set is exactly the last `budget`\n# positions, so origin tracking is verifiable against a known answer.\nrec = EV.kept_origins(caches[\"recency\"])[0]\nassert rec == list(range(CUM - budget, CUM)), \\\n    f\"recency origins are not 