tr.split().str.len()) == {k}, \\\n        f\"k={k}: stored id lists disagree with the setting name\"\n    agg = Q.aggregate(df.to_dict(\"records\"), k=k)        # k of THIS setting\n    cf = agg[\"complete_frac\"]\n    records.append({\n        \"k\": k, \"recall@k\": agg[f\"recall@{k}\"], \"complete_frac\": cf,\n        \"em\": agg[\"em\"], \"f1\": agg[\"f1\"],\n        \"em_projected\": round(cf * EM_C + (1 - cf) * EM_I, 4),\n        \"em_complete\": agg[\"em_complete\"], \"em_incomplete\": agg[\"em_incomplete\"],\n        \"em_bridge\": agg[\"em_bridge\"], \"em_comparison\": agg[\"em_comparison\"],\n        \"abstain_rate\": agg[\"abstain_rate\"],\n        \"prompt_tokens_mean\": round(float(df.prompt_tokens.mean()), 1),\n    })\n\nsummary = pd.DataFrame(records)\nsummary[\"em_residual\"] = (summary.em - summary.em_projected).round(4)\nsummary.to_csv(\"results/knob5_summary.csv\", index=False)\nprint(summary.to_string(index=False))\n\ndef mcnemar(ka, kb):\n    A, B = load(ka), load(kb)\n    for d in (A, B):\n        d[\"em\"] = [Q.exact_match(p, g) for p, g in zip(d.prediction, d.gold_answer)]\n    m = A.set_index(\"qid\")[[\"em\"]].join(B.set_index(\"qid\")[[\"em\"]],\n                                       lsuffix=\"_a\", rsuffix=\"_b\")\n    b = int(((m.em_b == 1) & (m.em_a == 0)).sum())\n    c = int(((m.em_a == 1) & (m.em_b == 0)).sum())\n    p = binomtest(b, b + c, 0.5).pvalue if b + c else 1.0\n    flag = \"\" if b + c >= 10 else \"   <- too few discordant to be informative\"\n    print(f\"k={ka:>2} vs k={kb:>2}: b={b:>3} c={c:>3} discordant={b+c:>3} \"\n          f\"p={p:.4f}{flag}\")\n    return {\"a\": ka, \"b_setting\": kb, \"b\": b, \"c\": c,\n            \"discordant\": b + c, \"p\": round(float(p), 4)}\n\nprint(\"\\n--- vs the k=5 baseline ---\")\nMC = [mcnemar(5, k) for k in (2, 3, 7, 10)]\n\nwith open(\"results/knob5_summary.json\", \"w\") as fh:\n    json.dump({\"knob\": 5, \"name\": \"top-k\", \"regime\": 1, \"mode\": \"short\",\n               \