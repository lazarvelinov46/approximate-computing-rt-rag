16Z","iopub.status.idle":"2026-09-04T09:01:30.726338Z","shell.execute_reply.started":"2026-09-04T08:56:20.300756Z","shell.execute_reply":"2026-09-04T09:01:30.725393Z"}},"outputs":[{"name":"stderr","text":"The following generation flags are not valid and may be ignored: ['temperature', 'top_p', 'top_k']. Set `TRANSFORMERS_VERBOSITY=info` for more details.\n","output_type":"stream"},{"name":"stdout","text":"setting                             sec/batch  x fp16  proj min/1000\nkv_fp16                                  22.3    1.00             30\nkv_hqq_n4_g32_r512                       29.5    1.32             39\nkv_hqq_n4_g32_r0                        178.7    8.00            237\n\n3 core settings: ~117 min\nvariant adds:    ~237 min\nDecide before cell 3: RUN_PLAN below includes the variant only if this is affordable.\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# notebooks/13_ac_knob3_explain — CELL 3\n# Set INCLUDE_VARIANT from cell 2's timing before running.\n#\n# Dropped from the pre-registered explain arm, on short-arm evidence:\n#   8-bit  — zero discordant pairs in short, cannot inform\n#   3-bit @ G32 — Pareto-dominated by 4-bit at identical 5.00 effective bits\n\nINCLUDE_VARIANT = False          # <-- set from cell 2\n\nRUN_PLAN = [\n    dict(bits=4),                                        # headline + mode contrast\n    dict(bits=2, q_group_size=16),                       # 4.00-bit Pareto point\n    dict(bits=2),                                        # collapse point\n]\nif INCLUDE_VARIANT:\n    RUN_PLAN.append(dict(bits=4, residual_length=0, allow_flush=True))\n\ndef spec_label(spec):\n    return KV.label(**{k: v for k, v in spec.items() if k != \"allow_flush\"})\n\nt_all = time.time()\nfor si, spec in enumerate(RUN_PLAN):\n    lab = spec_label(spec)\n    print(f\"\\n{'='*70}\\n[{si+1}/{len(RUN_PLAN)}] {lab}  spec={spec}\")\n    t0 = time.time()\n    R.run_pipeline(exs, CFG, embedder=embedder, generator=gen, gen_tok=to