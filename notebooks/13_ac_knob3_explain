sults/knob3_short_results.csv\"\n\nexs      = load_from_config(CFG)\nembedder = E.load_embedder(CFG[\"models\"][\"embedder\"])\ngen, tok = G.load_generator(CFG[\"models\"][\"generator\"])\n\nbase_ex = R.load_results(BASE_EXPLAIN, setting=\"baseline_explain\", mode=\"explain\")\nassert len(base_ex) == 1000, f\"explain baseline has {len(base_ex)} rows\"\nBASE_PRED = dict(zip(base_ex[\"qid\"], base_ex[\"prediction\"]))\nBASE_RET  = dict(zip(base_ex[\"qid\"], base_ex[\"retrieved_ids\"]))\nBASE_PLEN = dict(zip(base_ex[\"qid\"], base_ex[\"prompt_tokens\"]))\n\nSYSTEM_EX, MNT_EX = R._mode_settings(\"explain\", CFG, None)\nprint(f\"\\n{len(exs)} examples, max_new_tokens={MNT_EX}, \"\n      f\"{torch.cuda.get_device_name(0)}\")\nprint(f\"q_group_size={KV.Q_GROUP_SIZE}  residual_length={KV.RESIDUAL_LENGTH}\")","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-09-04T08:54:37.019498Z","iopub.execute_input":"2026-09-04T08:54:37.01978Z","iopub.status.idle":"2026-09-04T08:56:09.119935Z","shell.execute_reply.started":"2026-09-04T08:54:37.019751Z","shell.execute_reply":"2026-09-04T08:56:09.119049Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m58.4/58.4 kB\u001b[0m \u001b[31m3.5 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25h  Installing build dependencies ... \u001b[?25l\u001b[?25hdone\n  Getting requirements to build wheel ... \u001b[?25l\u001b[?25hdone\n  Preparing metadata (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m18.8/18.8 MB\u001b[0m \u001b[31m62.5 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m:00:01\u001b[0m00:01\u001b[0m\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m165.3/165.3 kB\u001b[0m \u001b[31m12.2 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u