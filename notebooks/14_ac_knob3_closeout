na=False, dtype=str)\nES = {k: em_map(g) for k, g in short_df.groupby(\"setting\")}\nEE = {k: em_map(g) for k, g in explain_df.groupby(\"setting\")}\nMETA = short_df[short_df.setting == \"kv_hqq_n8_g32_r512\"].set_index(\"qid\")\n\nprint(f\"baseline EM  short {sum(BS.values())/1000:.4f}  \"\n      f\"explain {sum(BE.values())/1000:.4f}\")\nprint(f\"settings: {len(ES)} short, {len(EE)} explain\")\nos.makedirs(\"results/figures\", exist_ok=True)","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-09-04T13:52:17.822596Z","iopub.execute_input":"2026-09-04T13:52:17.82291Z","iopub.status.idle":"2026-09-04T13:52:27.853839Z","shell.execute_reply.started":"2026-09-04T13:52:17.82288Z","shell.execute_reply":"2026-09-04T13:52:27.852752Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m18.8/18.8 MB\u001b[0m \u001b[31m72.7 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m:00:01\u001b[0m00:01\u001b[0m\n\u001b[?25h/kaggle/working/ac-rag-stack\nbaseline EM  short 0.3910  explain 0.4240\nsettings: 8 short, 3 explain\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# notebooks/14_ac_knob3_closeout — CELL 2\n# Merge the two arms and derive the columns the write-up needs: relative EM\n# cost against each mode's own baseline, and the mode gap, whose SIGN\n# inversion is the headline amplification evidence.\n\ns_sum = json.load(open(\"results/knob3_summary.json\"))\ne_sum = json.load(open(\"results/knob3_explain_summary.json\"))\nS = {r[\"setting\"]: r for r in s_sum[\"settings\"]}\nE = {r[\"setting\"]: r for r in e_sum[\"settings\"]}\n\nrows = []\nfor lab in sorted(set(S) | set(E),\n                  key=lambda l: -(S.get(l) or E[l])[\"effective_bits\"]):\n    s, e = S.get(lab), E.get(lab)\n    ref = S[\"kv_fp16\"][\"em\"]\n    ref_e = E[\"kv_fp16\"][\"em\"]\n    rows.append({\n        \"setting\": lab,\n        \"effective_bits\": (s or e)[\"effective_bits\"],\n        \"compression\": (s or e)[\"compression\"],\n        \"rmse_proxy\": (s or {}).get(\"rmse_proxy\"),\n        \"em_short\": s[\"em\"] if s else None,\n        \"em_explain\": e[\"em\"] if e else None,\n        \"rel_cost_short\": round((s[\"em\"] - ref) / ref, 4) if s else None,\n        \"rel_cost_explain\": round((e[\"em\"] - ref_e) / ref_e, 4) if e else None,\n        \"mode_gap\": round(e[\"em\"] - s[\"em\"], 4) if (s and e) else None,\n        \"identity_short\": s[\"identity_vs_fp16\"] if s else None,\n        \"identity_explain\": e[\"identity_vs_fp16\"] if e else None,\n        \"em_complete_short\": s[\"em_complete\"] if s else None,\n        \"em_complete_explain\": e[\"em_complete\"] if e else None,\n        \"abstain_short\": s[\"abstain_rate\"] if s else None,\n        \"abstain_explain\": e[\"abstain_rate\"] if e else None,\n        \"parse_fail_explain\": e.get(\"parse_fail_rate\") if e else None,\n        \"decode_at_cap_explain\": e.get(\"decode_at_cap\") if e else None,\n    })\n\ncombined = pd.DataFrame(rows)\ncombined.to_csv(\"results/knob3_combined_summary.csv\", index=False)\nprint(combined[[\"setting\", \"effective_bits\", \"compression\", \"em_short\",\n                \"em_explain\", \"mode_gap\", \"rel_cost_short\",\n                \"rel_cost_explain\"]].to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-04T13:52:27.856219Z","iopub.execute_input":"2026-09-04T13:52:27.856955Z","iopub.status.idle":"2026-09-04T13:52:27.889268Z","shell.execute_reply.started":"2026-09-04T13:52:27.856906Z","shell.execute_reply":"2026-09-04T13:52:27.888241Z"}},"outputs":[{"name":"stdout","text":"           setting  effective_bits  compression  em_short  em_explain  mode_gap  rel_cost_short  rel_cost_explain\n           kv_fp16            16.0        1.000     0.391       0.424     0.033          0.0000            0.0000\nkv_hqq_n8_g32_r512             9.0        1.778     0.391         NaN       NaN          0.0000               NaN\nkv_hqq_n3_g16_r512             6.0        2.667     0.390         NaN       NaN         -0.0026               NaN\n  kv_hqq_n4_g32_r0             5.0        3.200     0.384         NaN       NaN         -0.0179               NaN\nkv_hqq_n3_g32_r512             5.0        3.200     0.339         NaN       NaN         -0.1330               NaN\nkv_hqq_n4_g32_r512             5.0        3.200     0.385       0.416     0.031         -0.0153           -0.0189\nkv_hqq_n2_g16_r512             4.0        4.000     0.370       0.334    -0.036         -0.0537           -0.2123\nkv_hqq_n2_g32_r512             3.0        5.333     0.046       0.000    -0.046         -0.8824           -1.0000\nkv_hqq_n1_g32_r512             2.0        8.000     0.000         NaN       NaN         -1.0000               NaN\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# notebooks/14_ac_knob3_closeout — CELL 3\n# Does cache damage break RANDOM questions, or the SAME ones?\n#\n# Pool = questions the fp16 baseline gets right; only these can be broken.\n# If two settings break questions independently, expected overlap is\n# |A| * |B| / |pool|. Observed well above that means a shared fragile subset.\n#\n# CORRECTION recorded: an earlier version of the cross-mode test pooled on\n# questions the 4-bit EXPLAIN run got right, which excludes exactly the\n# questions 4-bit broke and guarantees a null. Both pools are now anchored on\n# their own fp16 baseline.\n\nimport itertools\nfrom scipy.stats import fisher_exact, mannwhitneyu\n\ndef concentration(EM, ref, settings, pool_name):\n    pool = [q for q, v in ref.items() if v == 1]\n    broke = {s: {q for q in pool if EM[s][q] == 0} for s in settings}\n    out = {\"pool_name\": pool_name, \"pool_size\": len(pool), \"broken\": {},\n           \"pairs\": []}\n    print(f\"\\n{pool_name}: pool = {len(pool)}\")\n    for s in settings:\n        out[\"broken\"][s] = len(broke[s])\n        print(f\"  {s:22s} broken {len(broke[s]):>3} ({len(broke[s])/len(pool):.3f})\")\n    for a, b in itertools.combinations(settings, 2):\n        if len(broke[a]) == len(pool) or len(broke[b]) == len(pool):\n            continue                      # degenerate: breaks everything\n        i = len(broke[a] & broke[b])\n        x = len(broke[a]) * len(broke[b]) / len(pool)\n        out[\"pairs\"].append({\"a\": a, \"b\": b, \"both\": i,\n                             \"expected_if_random\": round(x, 2),\n                             \"ratio\": round(i / x, 2) if x else None})\n        print(f\"  {a[6:18]:12s} x {b[6:18]:12s} both {i:>3}  \"\n              f\"indep {x:>5.1f}  ratio {i/x if x else 0:>4.2f}\")\n    return out, broke, pool\n\nSHORT_SET = [\"kv_hqq_n4_g32_r512\", \"kv_hqq_n3_g16_r512\",\n             \"kv_hqq_n3_g32_r512\", \"kv_hqq_n2_g16_r512\", \"kv_hqq_n2_g32_r512\"]\nEXPLAIN_SET = [\"kv_hqq_n4_g32_r512\", \"kv_hqq_n2_g16_r512\", \"kv_hqq_n2_g32_r512\"]\n\nconc_s, broke_s, pool_s = concentration(ES, BS, SHORT_SET, \"SHORT\")\nconc_e, broke_e, pool_e = concentration(EE, BE, EXPLAIN_SET, \"EXPLAIN\")\n\ndef correlates(broken_ids, kept_ids, tag):\n    B, K = META.loc[sorted(broken_ids)], META.loc[sorted(kept_ids)]\n    by = B.gold_answer.str.lower().isin([\"yes\", \"no\"]).sum()\n    ky = K.gold_answer.str.lower().isin([\"yes\", \"no\"]).sum()\n    p_yn = fisher_exact([[by, len(B)-by], [ky, len(K)-ky]])[1]\n    bb, kb = (B.qtype == \"bridge\").sum(), (K.qtype == \"bridge\").sum()\n    p_br = fisher_exact([[bb, len(B)-bb], [kb, len(K)-kb]])[1]\n    bl = B.gold_answer.str.split().str.len()\n    kl = K.gold_answer.str.split().str.len()\n    p_len = mannwhitneyu(bl, kl, alternative=\"greater\")[1]\n    print(f\"\\n{tag} (fragile n={len(B)}, robust n={len(K)})\")\n    print(f\"  yes/no gold  {by/len(B):.3f} vs {ky/len(K):.3f}   p={p_yn:.4f}\")\n    print(f\"  bridge       {bb/len(B):.3f} vs {kb/len(K):.3f}   p={p_br:.4f}\")\n    print(f\"  gold words   {bl.mean():.2f} vs {kl.mean():.2f}   p={p_len:.5f}\")\n    return {\"n_fragile\": len(B), \"n_robust\": len(K),\n            \"yes_no\": [round(by/len(B), 4), round(ky/len(K), 4), round(float(p_yn), 4)],\n            \"bridge\": [round(bb/len(B), 4), round(kb/len(K), 4), round(float(p_br), 4)],\n            \"gold_words\": [round(bl.mean(), 3), round(kl.mean(), 3), round(float(p_len), 6)]}\n\nMILD = [\"kv_hqq_n4_g32_r512\", \"kv_hqq_n3_g16_r512\", \"kv_hqq_n3_g32_r512\"]\nfrag_s = {q for q in pool_s if any(ES[m][q] == 0 for m in MILD)}\ncorr_s = correlates(frag_s, [q for q in pool_s if q not in frag_s],\n                    \"SHORT fragility correlates\")\ncorr_e = correlates(broke_e[\"kv_hqq_n4_g32_r512\"],\n                    [q for q in pool_e if q not in broke_e[\"kv_hqq_n4_g32_r512\"]],\n                    \"EXPLAIN fragility correlates (4-bit)\")\n\nboth = [q for q in pool_e if BS.get(q) == 1]\nbk = broke_e[\"kv_hqq_n4_g32_r512\"]\na = sum(1 for q in both if q in frag_s and q in bk)\nb = sum(1 for q in both if q in frag_s) - a\nc = sum(1 for q in both if q in bk) - a\nd = len(both) - a - b - c\np_tr = fisher_exact([[a, b], [c, d]])[1]\nprint(f\"\\nCROSS-MODE TRANSFER (both baselines correct, n={len(both)})\")\nprint(f\"  break at 4-bit explain | short-fragile  {a/(a+b):.3f}  (n={a+b})\")\nprint(f\"  break at 4-bit explain | short-robust   {c/(c+d):.3f}  (n={c+d})\")\nprint(f\"  Fisher p={p_tr:.4f}  -> \"\n      f\"{'significant' if p_tr < 0.05 else 'suggestive but underpowered'}\")\n\njson.dump({\"short\": conc_s, \"explain\": conc_e,\n           \"correlates_short\": corr_s, \"correlates_explain\": corr_e,\n           \"cross_mode_transfer\": {\n               \"n\": len(both), \"fragile_break_rate\": round(a/(a+b), 4),\n               \"robust_break_rate\": round(c/(c+d), 4), \"p\": round(float(p_tr), 4)},\n           \"note\": (\"an earlier version of the transfer test pooled on \"\n                    \"questions the 4-bit explain run answered correctly, which \"\n                    \"excludes the questions 4-bit broke and forces a null; \"\n                    \"both pools are now anchored on their own fp16 baseline\")},\n          open(\"results/knob3_fragility.json\", \"w\"), indent=2, default=str)\nprint(\"\\nwrote results/knob3_fragility.json\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-04T13:52:27.893625Z","iopub.execute_input":"2026-09-04T13:52:27.893941Z","iopub.status.idle":"2026-09-04T13:52:28.747796Z","shell.execute_reply.started":"2026-09-04T13:52:27.893911Z","shell.execute_reply":"2026-09-04T13:52:28.747013Z"}},"outputs":[{"name":"stdout","text":"\nSHORT: pool = 391\n  kv_hqq_n4_g32_r512     broken  11 (0.028)\n  kv_hqq_n3_g16_r512     broken   6 (0.015)\n  kv_hqq_n3_g32_r512     broken  64 (0.164)\n  kv_hqq_n2_g16_r512     broken  33 (0.084)\n  kv_hqq_n2_g32_r512     broken 347 (0.887)\n  _n4_g32_r512 x _n3_g16_r512 both   3  indep   0.2  ratio 17.77\n  _n4_g32_r512 x _n3_g32_r512 both   6  indep   1.8  ratio 3.33\n  _n4_g32_r512 x _n2_g16_r512 both   4  indep   0.9  ratio 4.31\n  _n4_g32_r512 x _n2_g32_r512 both  11  indep   9.8  ratio 1.13\n  _n3_g16_r512 x _n3_g32_r512 both   3  indep   1.0  ratio 3.05\n  _n3_g16_r512 x _n2_g16_r512 both   3  indep   0.5  ratio 5.92\n  _n3_g16_r512 x _n2_g32_r512 both   6  indep   5.3  ratio 1.13\n  _n3_g32_r512 x _n2_g16_r512 both  13  indep   5.4  ratio 2.41\n  _n3_g32_r512 x _n2_g32_r512 both  62  indep  56.8  ratio 1.09\n  _n2_g16_r512 x _n2_g32_r512 both  32  indep  29.3  ratio 1.09\n\nEXPLAIN: pool = 424\n  kv_hqq_n4_g32_r512     broken  75 (0.177)\n  kv_hqq_n2_g16_r512     broken 151 (0.356)\n  kv_hqq_n2_g32_r512     broken 424 (1.000)\n  _n4_g32_r512 x _n2_g16_r512 both  42  indep  26.7  ratio 1.57\n\nSHORT fragility correlates (fragile n=72, robust n=319)\n  yes/no gold  0.000 vs 0.132   p=0.0002\n  bridge       0.847 vs 0.718   p=0.0251\n  gold words   2.57 vs 1.82   p=0.00000\n\nEXPLAIN fragility correlates (4-bit) (fragile n=75, robust n=349)\n  yes/no gold  0.093 vs 0.100   p=1.0000\n  bridge       0.680 vs 0.808   p=0.0195\n  gold words   2.31 vs 1.99   p=0.10129\n\nCROSS-MODE TRANSFER (both baselines correct, n=304)\n  break at 4-bit explain | short-fragile  0.222  (n=54)\n  break at 4-bit explain | short-robust   0.128  (n=250)\n  Fisher p=0.0879  -> suggestive but underpowered\n\nwrote results/knob3_fragility.json\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# notebooks/14_ac_knob3_closeout — CELL 4\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\n\nc = combined.dropna(subset=[\"em_short\"]).sort_values(\"effective_bits\")\nce = combined.dropna(subset=[\"em_explain\"]).sort_values(\"effective_bits\")\n\nfig, ax = plt.subplots(figsize=(7, 4.5))\nax.plot(c.effective_bits, c.em_short, \"o-\", label=\"short (32 tokens)\")\nax.plot(ce.effective_bits, ce.em_explain, \"s-\", label=\"explain (256 tokens)\")\nax.axhline(S[\"kv_fp16\"][\"em\"], ls=\":\", lw=1, color=\"gray\")\nax.set_xlabel(\"measured effective bits per KV element\")\nax.set_ylabel(\"exact match\"); ax.set_ylim(0, 0.45)\nax.set_title(\"Knob 3: quality vs measured KV cache cost (n=1000)\")\nax.legend(); fig.tight_layout()\nfig.savefig(\"results/figures/knob3_em_vs_bits.png\", dpi=150)\n\ng = combined.dropna(subset=[\"mode_gap\"]).sort_values(\"effective_bits\")\nfig, ax = plt.subplots(figsize=(7, 4))\nax.bar([str(x) for x in g.effective_bits], g.mode_gap,\n       color=[\"tab:blue\" if v > 0 else \"tab:red\" for v in g.mode_gap])\nax.axhline(0, color=\"black\", lw=0.8)\nax.set_xlabel(\"effective bits\"); ax.set_ylabel(\"explain EM − short EM\")\nax.set_title(\"The explain advantage inverts once the cache degrades\")\nfig.tight_layout()\nfig.savefig(\"results/figures/knob3_mode_gap.png\", dpi=150)\n\nfig, axes = plt.subplots(1, 2, figsize=(11, 4))\nfor ax, col, ttl in ((axes[0], \"em_complete_short\", \"em_complete\"),\n                     (axes[1], \"abstain_short\", \"abstain rate\")):\n    d_ = combined.dropna(subset=[col]).sort_values(\"effective_bits\")\n    ax.plot(d_.effective_bits, d_[col], \"o-\")\n    ax.set_xlabel(\"effective bits\"); ax.set_title(ttl + \" (short)\")\naxes[1].set_ylim(bottom=0)\nfig.suptitle(\"Generator damage rises while abstention FALLS \"\n             \"— the opposite of knob 1\")\nfig.tight_layout()\nfig.savefig(\"results/figures/knob3_em_complete_abstain.png\", dpi=150)\n\np = combined.dropna(subset=[\"rmse_proxy\", \"em_short\"])\nfig, ax = plt.subplots(figsize=(6, 4.5))\nax.scatter(p.rmse_proxy, p.em_short)\nfor _, r in p.iterrows():\n    ax.annotate(r.setting.replace(\"kv_hqq_\", \"\").replace(\"_r512\", \"\"),\n                (r.rmse_proxy, r.em_short), fontsize=7,\n                xytext=(4, 4), textcoords=\"offset points\")\nax.set_xlabel(\"CPU reconstruction RMSE (free)\")\nax.set_ylabel(\"exact match, short (1 GPU run each)\")\nax.set_title(f\"Proxy validation: Spearman \"\n             f\"{s_sum['proxy_correlation']['spearman']:.3f}\")\nfig.tight_layout()\nfig.savefig(\"results/figures/knob3_proxy_validation.png\", dpi=150)\n\nprint(\"wrote 4 figures to results/figures/\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-04T13:52:28.748844Z","iopub.execute_input":"2026-09-04T13:52:28.74937Z","iopub.status.idle":"2026-09-04T13:52:30.044733Z","shell.execute_reply.started":"2026-09-04T13:52:28.749339Z","shell.execute_reply":"2026-09-04T13:52:30.043672Z"}},"outputs":[{"name":"stdout","text":"wrote 4 figures to results/figures/\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# notebooks/14_ac_knob3_closeout — CELL 5\nprint(open(\"results/knob3_findings.md\", \"w\").write(\"\"\"\n## Knob 3 — KV cache precision (regime 1, n=1000)\n\n**Setup.** hqq backend, per-channel (axis 0), q_group_size 32,\nresidual_length 512, transformers 5.0.0. Retrieval untouched:\ncomplete_frac and recall@5 constant across every setting.\n\n**Frontier (short / explain, relative EM cost):**\n- 8-bit @ G32 — 8.50 eff bits, 1.78x — 0.0% / not run. Zero discordant\n  pairs against fp16: bit-for-bit invisible.\n- 4-bit @ G32 — 5.00 eff bits, 3.20x — -1.5% / -1.9%. Explain McNemar\n  b=67 c=75, 142 discordant, p=0.557: an ADEQUATELY POWERED null, the\n  strongest equivalence claim in the study.\n- 2-bit @ G16 — 4.00 eff bits, 4.00x — -5.4% / -21.2%.\n- 2-bit @ G32 — 3.00 eff bits, 5.33x — collapse. Explain: 95%\n  unparseable, 42% hit the token cap, 0% empty.\n\n**Group size is a second precision axis, not a tuning detail.** At\nidentical 5.00 effective bits, 4-bit beats 3-bit 0.385 to 0.339. At\nidentical nbits=2, group 16 gives EM 0.370 against group 32's 0.046 —\none extra effective bit, eightfold difference. The nbits-only 8/4/2\nladder has no resolution between EM 0.385 and 0.046; adding group size\nfills it.\n\n**First knob to move em_complete.** 0.4415 -> 0.0000 with complete_frac\npinned, versus knob 2's maximum movement of 0.004 across 48x\ncompression. All damage is generator-side by construction.\n\n**Abstention runs OPPOSITE to knob 1.** Retrieval damage raised\nabstention 0.014 -> 0.108; cache damage lowers it 0.010 -> 0.000. A\nmodel can see missing evidence and decline. It cannot see a corrupted\ncache, so it fills the token budget with confident noise.\n\n**The explain advantage inverts.** +0.033 at fp16, +0.031 at 4-bit,\n-0.036 at 2-bit/G16, -0.046 at 2-bit/G32. Chain-of-thought helps with an\nintact cache and hurts with a degraded one. Difference-in-differences,\nso the baseline mode gap is controlled by construction.\n\n**Damage concentrates on a fragile subset, in short mode.** Pairwise\noverlap 3-18x above independent expectation. The 72 fragile questions\nhave zero yes/no answers (vs 13.2%, p=0.0002), longer gold answers\n(2.57 vs 1.82 words, p<0.00001) and more bridge type (p=0.025) —\nconsistent with exact match punishing long answers. In explain mode\nconcentration weakens to 1.57x and none of the correlates hold\n(yes/no p=1.0, length p=0.10). Cross-mode transfer 22.2% vs 12.8%,\np=0.088: suggestive, underpowered, reported as inconclusive.\n\n**Free CPU proxy validated.** Reconstruction RMSE on quantized tensors\npredicts EM at Spearman -0.919 (n=7), so dense sweeps can run on CPU and\nGPU runs spent sparsely. One rank inversion (3-bit/G32 vs 2-bit/G16)\nremains open; the RMSE surface used planted outliers, and recomputing on\nresults/knob3_real_kv_sample.pt would test whether that is an artifact.\n\n**Overhead.** Short 1.25x / 1.38x / 2.00x at 8/4/2 bits; explain 1.32x\nat 4-bit. residual_length=0 costs 8.00x in explain and was not run.\n\n**Not established.** Backend contrast is CPU-proxy only: optimum-quanto\n0.2.7 bundles Marlin kernels requiring sm_80 and cannot build on the T4.\nhqq vs quanto agree within 4% on reconstruction error at matched nbits\nand matched footprint, which is weaker than the EM-level replications in\nknobs 1 and 2.\n\"\"\"))\nprint(\"wrote results/knob3_findings.md — paste into environment.md\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-04T14:07:22.714204Z","iopub.execute_input":"2026-09-04T14:07:22.714573Z","iopub.status.idle":"2026-09-04T14:07:22.724661Z","shell.execute_reply.started":"2026-09-04T14:07:22.714543Z","shell.execute_reply":"2026-09-04T14:07:22.7235Z"}},"outputs":[{"name":"stdout","text":"3164\nwrote results/knob3_findings.md — paste into environment.md\n","output_type":"stream"}],"execution_count":5}]}