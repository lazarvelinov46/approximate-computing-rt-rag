 return out, mode\n\nCEILING = 13.0\n\ndef probe(prompts, mode, batch, kv=None):\n    plens = np.array([G.n_tokens(tok, p) for p in prompts])\n    s0 = max(range(0, len(prompts), batch), key=lambda i: plens[i:i + batch].max())\n    gc.collect(); torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats(0)\n    peak, enc = float(\"nan\"), None\n    try:\n        enc = tok(prompts[s0:s0 + batch], return_tensors=\"pt\", padding=True,\n                  **G.ENCODE_KWARGS).to(gen.device)\n        with torch.inference_mode():\n            gen.generate(**enc, **(KV.make_cache(**kv) if kv else {}),\n                         max_new_tokens=MNT[mode], min_new_tokens=MNT[mode],\n                         do_sample=False, pad_token_id=tok.pad_token_id)\n        peak = torch.cuda.max_memory_allocated(0) / 2**30\n    except torch.OutOfMemoryError:\n        pass\n    enc = None\n    gc.collect(); torch.cuda.empty_cache()\n    return int(plens[s0:s0 + batch].max()), peak\n\nPROMPTS = {lab: llama_prompts(lab) for lab in FROZEN}\nMEM = []\nfor lab, batch, kv in ((\"r1_short_k5\", B, None),\n                       (\"r1_short_k5\", B, {\"bits\": 4}),\n                       (\"r1_short_k5\", B, {\"bits\": 2, \"q_group_size\": 16}),\n                       (\"r2_short_k5\", B, None),\n                       (\"r1_explain_k5\", B, None),\n                       (\"r1_short_k10\", B, None),\n                       (\"r1_short_k10\", 8, None)):\n    ps, mode = PROMPTS[lab]\n    padded, peak = probe(ps, mode, batch, kv)\n    ok = peak == peak and peak < CEILING\n    MEM.append({\"set\": lab, \"batch\": batch, \"kv\": kv, \"padded\": padded,\n                \"peak_gib\": round(peak, 2), \"fits\": ok})\n    print(f\"{lab:<14} b{batch:<3} kv={str(kv):<34} padded {padded:>5}  \"\n          f\"peak {peak:6.2f} GiB  {'OK' if ok else 'FAIL'}\")\nAUDIT_B[\"memory\"] = MEM","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-22T08:50:17.500371Z","iopub.execute_input":"2026-09-22