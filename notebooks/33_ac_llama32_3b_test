3B-Instruct: {'n_layers': 36, 'n_kv_heads': 2, 'q_per_kv': 8, 'head_dim': 128, 'kv_bytes_per_token': 36864}\nmeta-llama/Llama-3.2-3B-Instruct: {'n_layers': 28, 'n_kv_heads': 8, 'q_per_kv': 3, 'head_dim': 128, 'kv_bytes_per_token': 114688}\n\nset            model    mean    p50    p99    max worst b16  KV@worst GiB\nr1_short_k2    qwen      335    324    590    690       690          0.40\nr1_short_k2    llama     344    335    587    678       678          1.21\nr1_short_k3    qwen      469    456    790   1135      1135          0.64\nr1_short_k3    llama     472    461    779   1073      1073          1.89\nr1_short_k5    qwen      744    726   1203   1524      1524          0.85\nr1_short_k5    llama     734    718   1173   1444      1444          2.52\nr1_short_k10   qwen     1519   1479   2626   2953      2953          1.64\nr1_short_k10   llama    1474   1437   2487   2966      2966          5.12\nr1_explain_k5  qwen      771    753   1230   1551      1551          0.99\nr1_explain_k5  llama     761    745   1200   1471      1471          2.95\nr2_short_k5    qwen      761    749   1178   1325      1325          0.75\nr2_short_k5    llama     749    741   1142   1277      1277          2.24\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# notebooks/33_ac_llama32_3b — CELL 4   [CPU]\n# Knob-4 machinery on Llama. Real rope parameters and real attention geometry\n# (24 query / 8 KV heads, head_dim 128); only depth, MLP width and vocab are\n# shrunk. No GQA grouping-ORDER test: mean over each query group, then mean\n# over KV heads, equals the flat mean for ANY grouping — it could not fail.\n# What can fail: 24 % 8, the hook on LlamaAttention under eager, and the\n# policies' invariants on this geometry.\nimport random, torch\nfrom transformers import AutoModelForCausalLM\nfrom transformers.models.llama.modeling_llama import LlamaRotaryEmbedding, rotate_half as rh_llama\nfrom transformers.models.qwen2.modeling_qwen2 import Qwen2RotaryEmbedding, rotate_half as rh_qwen\nfrom src.generator import eviction as EV\n\nEV.selftest()\nlcfg, qcfg = AutoConfig.from_pretrained(LLAMA), AutoConfig.from_pretrained(QWEN)\nrp = lcfg.rope_parameters\nprint(f\"llama rope_parameters: {rp}\")\nassert rp[\"rope_type\"] == \"llama3\" and rp[\"rope_type\"] in EV.STATIC_ROPE\n\nx = torch.randn(2, 8, 5, 128)                       # eviction.py imports qwen2's\nassert torch.equal(rh_qwen(x), rh_llama(x))          # rotate_half — same map?\n\nrotL, rotQ = LlamaRotaryEmbedding(config=lcfg), Qwen2RotaryEmbedding(config=qcfg)\nassert float(rotL.attention_scaling) == 1.0\nhd = GEOM[LLAMA][\"head_dim\"]\nplain = 1.0 / (rp[\"rope_theta\"] ** (torch.arange(0, hd, 2, dtype=torch.float32) / hd))\nn_scaled = int((~torch.isclose(rotL.inv_freq, plain)).sum())\nprint(f\"llama3 scaling moved {n_scaled}/{hd // 2} frequencies (0 = default path ran instead)\")\nassert n_scaled > 0\n\ndef rotate_to(rot, rh, k_raw, positions):\n    \"\"\"Ground truth: rotate raw keys to absolute positions via the model's rope.\"\"\"\n    cos, sin = rot(k_raw, torch.tensor(positions, dtype=torch.long)[None])\n    return k_raw * cos[:, None] + rh(k_raw) * sin[:, None]\n\ndef composition_err(rot, rh, p_from, p_to):\n    torch.manual_seed(0)\n    k_raw = torch.randn(1, 8, len(p_from), hd)\n    layer = EV._build_layer(\"sink_recent\", 0.5, EV.DEFAULT_SINK, 42, True,\n                            rot.inv_freq.detach(), 0)\n    delta = torch.tensor([b - a for a, b in zip(p_from, p_to)], dtype=torch.long)\n    composed = layer._rotate(rotate_to(rot, rh, k_raw, p_from), delta)\n    return (composed - rotate_to(rot, rh, k_raw, p_to)).abs().max().item()\n\n# A. notebook 22's positions; B. study scale — longest Llama regime-1 prompt,\n# hollow r0.25 keep-set, compared against Qwen's rope on identical positions.\ne_small = composition_err(rotL, rh_llama, [0, 1, 2, 3, 28, 29], [24, 25, 26, 27, 28, 29])\nS = int(PLENS[LLAMA][\"r1_short_k5\"].max())\nb = EV.budget_for(S, 0.25, \"random\")\nrng = random.Random(42)\np_from = sorted(rng.sample(range(S - 1), b - 1)) + [S - 1]\np_to = list(range(S - b, S))\ne_L = composition_err(rotL, rh_llama, p_from, p_to)\ne_Q = composition_err(rotQ, rh_qwen, p_from, p_to)\nprint(f\"composition max|err|: nb22 positions {e_small:.2e} | S={S} r0.25: \"\n      f\"llama3 {e_L:.2e}, qwen rope {e_Q:.2e}\")\nassert e_small < 1e-5, \"rotation composition is not exact under llama3 rope\"\nassert e_L <= 2 * e_Q + 1e-6, \"llama3 composition error exceeds what the Qwen runs tolerated\"\n\n# C. end-to-end on a tiny Llama with the real attention geometry\ntiny = AutoConfig.from_pretrained(LLAMA, num_hidden_layers=2, intermediate_size=256,\n                                  vocab_size=512)\ntorch.manual_seed(42)\nm = AutoModelForCausalLM.from_config(tiny).float().eval()\nm.generation_config.eos_token_id = None              # vocab 512: run every decode step\ngeo = G.kv_geometry(m.config)\nassert (geo[\"n_kv_heads\"], geo[\"q_per_kv\"], geo[\"head_dim\"]) == (8, 3, 128), geo\nassert torch.equal(m.model.rotary_emb.inv_freq, rotL.inv_freq)\n\nPROMPT_LEN, NEW = 64, 12\nids = torch.randint(0, 512, (1, PROMPT_LEN))\nmask = torch.ones_like(ids)\n\ndef gen(cache=None):\n    with EV.attention_scoring(m, cache), torch.no_grad():\n        out = m.generate(input_ids=ids, attention_mask=mask, past_key_values=cache,\n                         max_new_tokens=NEW, do_sample=False, pad_token_id=0)\n    return out[:, PROMPT_LEN:]\n\nassert EV.make_cache(m, \"recency\", 1.0) is None       # keep_ratio 1.0 = untouched path\nEV_ROWS = {}\nfor policy in (\"recency\", \"sink_recent\", \"random\", \"attention\"):\n    m.set_attn_implementation(\"eager\" if policy == \"attention\" else \"sdpa\")\n    c = EV.make_cache(m, policy, 0.5)\n    out = gen(c)\n    L0, want = c.layers[0], EV.budget_for(PROMPT_LEN, 0.5, policy)\n    phase_ok = all(bool((l.phase.diff() == 1).all())\n                   and int(l.phase[-1]) == l.cumulative_length - 1 for l in c.layers)\n    rec = {\"budget\": int(L0.budget), \"stored\": int(L0.keys.shape[-2]),\n           \"evicted\": int(L0.evicted), \"rotations\": int(L0.rotations), \"phase_ok\": phase_ok,\n           \"deterministic\": bool(torch.equal(out, gen(EV.make_cache(m, policy, 0.5))))}\n    if policy == \"attention\":\n        rec[\"scores_finite\"] = all(bool(torch.isfinite(l.scores / l.n_obs.clamp(min=1)).all())\n                                   and bool((l.n_obs > 0).all()) for l in c.layers)\n        rec[\"layer_keepsets_differ\"] = (set(c.layers[0]._last_keep.tolist())\n                                        != set(c.layers[1]._last_keep.tolist()))\n    EV_ROWS[policy] = rec\n    print(f\"{policy:<12} {rec}\")\n    assert rec[\"budget\"] == want and rec[\"stored\"] == want and rec[\"evicted\"] > 0\n    assert phase_ok and rec[\"deterministic\"]\n    assert (rec[\"rotations\"] == 0) if policy == \"recency\" else (rec[\"rotations\"] > 0)\n    if policy == \"attention\":\n        assert rec[\"scores_finite\"]\nm.set_attn_implementation(\"sdpa\")\n\nAUDIT[\"rope\"] = {\"rope_parameters\": rp, \"n_scaled_freqs\": n_scaled, \"S\": S,\n                 \"err_nb22_positions\": e_small, \"err_llama3_study_scale\": e_L,\n                 \"err_qwen_study_scale\": e_Q}\nAUDIT[\"eviction_tiny_llama\"] = EV_ROWS","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T22:42:12.613892Z","iopub.execute_input":"2026-09-21T22:42:12.614334Z","iopub.status.idle":"2026-09-21T22:42:19.845779Z","shell.execute_reply.started":"2026-09-21T22:42:12.614299Z","shell.execute_reply":"2026-09-21T22:42:19.844829Z"}},"outputs":[{"name":"stdout","text":"eviction selftest OK\nllama rope_parameters: {'factor': 32.0, 'high_freq_factor': 4.0, 'low_freq_factor': 1.0, 'original_max_position_embeddings': 8192, 'rope_type': 'llama3', 'rope_theta': 500000.0}\nllama3 scaling moved 35/64 frequencies (0 = default path ran instead)\ncomposition max|err|: nb22 positions 2.21e-06 | S=1444 r0.25: llama3 3.26e-04, qwen rope 2.73e-04\nrecency      {'budget': 32, 'stored': 32, 'evicted': 43, 'rotations': 0, 'phase_ok': True, 'deterministic': True}\nsink_recent  {'budget': 32, 'stored': 32, 'evicted': 43, 'rotations': 12, 'phase_ok': True, 'deterministic': True}\nrandom       {'budget': 32, 'stored': 32, 'evicted': 43, 'rotations': 11, 'phase_ok': True, 'deterministic': True}\nattention    {'budget': 32, 'stored': 32, 'evicted': 43, 'rotations': 11, 'phase_ok': True, 'deterministic': True, 'scores_finite': True, 'layer_keepsets_differ': True}\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# notebooks/33_ac_llama32_3b — CELL 5   [CPU]\n# Knob 3 on Llama geometry. (a) channel alignment for every real batch via\n# kv_cache.channels_per_group, whose defaults are QWEN's (2 KV heads) — the\n# geometry is passed explicitly. (b) every planned setting through the real\n# QuantizedCache update path at the worst real batch, both padded-length\n# parities. (c) a control that MUST show misalignment, so (b) can fail.\nfrom transformers import QuantizedCache\nfrom src.generator import kv_cache as KV\n\nKV.selftest()\nB = CFG_L[\"generation\"][\"batch_size\"]\nKNOB3 = [(8, 32), (4, 32), (3, 32), (2, 32), (2, 16)]            # (nbits, group)\n\nALIGN = {}\nfor model in (LLAMA, QWEN):\n    g, tag = GEOM[model], model.split(\"/\")[-1]\n    for G_ in (32, 16):\n        per_batch, s = KV.batch_alignment([int(x) for x in PLENS[model][\"r1_short_k5\"]], B,\n                                          q_group_size=G_, num_kv_heads=g[\"n_kv_heads\"],\n                                          head_dim=g[\"head_dim\"])\n        off = [(bi, bs, S_, cpg) for bi, bs, S_, cpg in per_batch if cpg != 1]\n        ALIGN[f\"{tag}_g{G_}\"] = {\"frac_true_per_channel\": s[\"frac_true_per_channel\"],\n                                 \"misaligned_batches\": off}\n        print(f\"{tag:<24} G={G_:<3} per-channel {s['frac_true_per_channel']:.4f}  \"\n              f\"misaligned (batch, size, padded, chan/grp): {off or 'none'}\")\nfor G_ in (32, 16):\n    assert ALIGN[f\"Llama-3.2-3B-Instruct_g{G_}\"][\"frac_true_per_channel\"] == 1.0\n\nKVH, HD = GEOM[LLAMA][\"n_kv_heads\"], GEOM[LLAMA][\"head_dim\"]\nS_W = int(max(PLENS[LLAMA][\"r1_short_k5\"][i:i + B].max() for i in range(0, 1000, B)))\n\ndef spike(t, channels=(7, 31, 64, 99), gain=20.0):\n    out = t.clone()\n    out[..., list(channels)] *= gain\n    return out\n\ndef rmse_through_cache(cfg, nbits, group, batch, seq, n_kv):\n    torch.manual_seed(42)\n    k = spike(torch.randn(batch, n_kv, seq, HD, dtype=torch.float16))\n    cache = QuantizedCache(backend=\"hqq\", config=cfg, nbits=nbits, axis_key=0, axis_value=0,\n                           q_group_size=group, residual_length=KV.RESIDUAL_LENGTH)\n    cache.update(k, k.clone(), layer_idx=0)                       # prefill: quantized once\n    step = torch.randn(batch, n_kv, 1, HD, dtype=torch.float16)\n    cache.update(step, step.clone(), layer_idx=0)                 # decode: fp16 residual\n    lay = cache.layers[0]\n    rec = lay._dequantize(lay._quantized_keys).float()\n    assert rec.shape == k.shape and torch.isfinite(rec).all()\n    return float((rec - k.float()).pow(2).mean().sqrt())\n\nHQQ = {}\nprint(f\"\\nworst real batch: {B} x {KVH} KV heads x {S_W} tokens x {HD}\")\nfor nbits, group in KNOB3:\n    lab = KV.label(nbits, q_group_size=group)\n    (e0, c0), (e1, c1) = [(rmse_through_cache(lcfg, nbits, group, B, s, KVH),\n                           KV.channels_per_group(B, s, group, KVH, HD)) for s in (S_W, S_W + 1)]\n    HQQ[lab] = {\"rmse\": [round(e0, 5), round(e1, 5)], \"chan_per_group\": [c0, c1],\n                \"eff_bits\": KV.effective_bits(nbits, group)}\n    print(f\"{lab:<20} eff {KV.effective_bits(nbits, group):.2f} b | RMSE {e0:.4f} / {e1:.4f} \"\n          f\"(padded {S_W} / {S_W + 1}) | chan/grp {c0} / {c1}\")\n    assert c0 == c1 == 1 and abs(e0 - e1) / e0 < 0.05\n\n# (c) Qwen geometry, final 8-row batch, G=32: odd padded length -> 2 chan/grp.\nq_even, q_odd = (rmse_through_cache(qcfg, 4, 32, 8, s, 2) for s in (744, 745))\nprint(f\"\\ncontrol qwen b8 G32 n4: RMSE even {q_even:.4f} / odd {q_odd:.4f}  chan/grp \"\n      f\"{KV.channels_per_group(8, 744, 32, 2, HD)} / {KV.channels_per_group(8, 745, 32, 2, HD)}\")\nassert q_odd > 1.1 * q_even, \"misalignment control did not show — the parity test is uninformative\"\nAUDIT[\"knob3\"] = {\"alignment\": ALIGN, \"hqq_llama\": HQQ, \"control_qwen_b8_g32\": [q_even, q_odd]}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T22:42:19.846906Z","iopub.execute_input":"2026-09-21T22:42:19.847265Z","iopub.status.idle":"2026-09-21T22:48:45.75318Z","shell.execute_reply.started":"2026-09-21T22:42:19.847237Z","shell.execute_reply":"2026-09-21T22:48:45.751743Z"}},"outputs":[{"name":"stdout","text":"kv_cache selftest OK\nLlama-3.2-3B-Instruct    G=32  per-channel 1.0000  misaligned (batch, size, padded, chan/grp): none\nLlama-3.2-3B-Instruct    G=16  per-channel 1.0000  misaligned (batch, size, padded, chan/grp): none\nQwen2.5-3B-Instruct      G=32  per-channel 1.0000  misaligned (batch, size, padded, chan/grp): none\nQwen2.5-3B-Instruct      G=16  per-channel 1.0000  misaligned (batch, size, padded, chan/grp): none\n\nworst real batch: 16 x 8 KV heads x 1444 tokens x 128\nkv_hqq_n8_g32_r512   eff 9.00 b | RMSE 0.0160 / 0.0160 (padded 1444 / 1445) | chan/grp 1 / 1\nkv_hqq_n4_g32_r512   eff 5.00 b | RMSE 0.2811 / 0.2808 (padded 1444 / 1445) | chan/grp 1 / 1\nkv_hqq_n3_g32_r512   eff 5.00 b | RMSE 0.6079 / 0.6074 (padded 1444 / 1445) | chan/grp 1 / 1\nkv_hqq_n2_g32_r512   eff 3.00 b | RMSE 1.4314 / 1.4309 (padded 1444 / 1445) | chan/grp 1 / 1\nkv_hqq_n2_g16_r512   eff 4.00 b | RMSE 1.1860 / 1.1865 (padded 1444 / 1445) | chan/grp 1 / 1\n\ncontrol qwen b8 G32 n4: RMSE even 0.2822 / odd 0.3278  chan/grp 1 / 2\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"# notebooks/33_ac_llama32_3b — C