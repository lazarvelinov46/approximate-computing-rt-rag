.to(model.device)\n    with torch.inference_mode():\n        out = model.generate(**enc, max_new_tokens=mnt, do_sample=False,\n                             pad_token_id=tk.pad_token_id,\n                             output_logits=True, return_dict_in_generate=True)\n    finite = all(bool(torch.isfinite(l).all()) for l in out.logits)\n    texts = tk.batch_decode(out.sequences[:, enc[\"input_ids\"].shape[-1]:],\n                            skip_special_tokens=True)\n    return [t.strip() for t in texts], finite\n\nP_SHORT = dev_prompts(tok, \"short\")\nmirror, _ = gen_with_logits(gen, tok, P_SHORT[:B], MNT[\"short\"])\nassert mirror == G.generate_batch(gen, tok, P_SHORT[:B], MNT[\"short\"]), \\\n    \"gen_with_logits diverged from generate_batch\"\n\nDEV_SHORT, bad_batches = [], []\nfor i in range(0, len(P_SHORT), B):\n    texts, finite = gen_with_logits(gen, tok, P_SHORT[i:i + B], MNT[\"short\"])\n    DEV_SHORT += texts\n    if not finite:\n        bad_batches.append(i // B)\nprint(f\"(a) dev-200 short fp16 b16: batches with non-finite logits: {bad_batches or 'none'}\")\n\ndef fp16_vs_fp32(name, n=64):\n    tk = tok if name == LLAMA else G.load_tokenizer(name)\n    ps = dev_prompts(tk, \"short\")[:n]\n    m16 = gen if name == LLAMA else G.load_generator(name, device=0)[0]\n    a = [G.generate_batch(m16, tk, [p], MNT[\"short\"])[0] for p in ps]\n    if m16 is not gen:\n        del m16\n    m32 = G.load_generator(name, dtype=torch.float32, device=1)[0]\n    b = [G.generate_batch(m32, tk, [p], MNT[\"short\"])[0] for p in ps]\n    del m32\n    gc.collect()\n    for d in (0, 1):\n        with torch.cuda.device(d):\n            torch.cuda.empty_cache()\n    diffs = [(x, y) for x, y in zip(a, b) if x != y]\n    return 1 - len(diffs) / n, diffs\n\nAGREE = {}\nfor name in (LLAMA, QWEN):\n    rate, diffs = fp16_vs_fp32(name)\n    AGREE[name.split(\"/\")[-1]] = {\"agreement\": round(rate, 4), \"diffs\": diffs[:10]}\n    print(f\"(b) {name}: fp16 == fp32 on {rate:.1%} of 64 dev prompts\")\n    for x, y in diffs[:5]:\n        print(f\"      fp16 {x!r:<40} fp32 {y!r}\")\nAUDIT_B[\"fp16\"] = {\"nonfinite_batches\": bad_batches, \"agreement_b1_64\": AGREE}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-22T08:53:14.006589Z","iopub.execute_input":"2026-09-22T08:53:14.006953Z","iopub.status.idle":"2026-09-22T09:01:53.15151Z","shell.execute_reply.started":"2026-09-22T08:53:14.006926Z","shell.execute_reply":"2026-09-22T09:01:53.150685Z"}},"outputs":[{"name":"stdout","text":"(a) dev-200 short fp16 b16: batches with non-finite logits: none\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/254 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"4a96241548ee48c6b74e80624688f82c"}},"metadata":{}},{"name":"stdout","text":"(b) meta-llama/Llama-3.2-3B-Instruct: fp16 == fp32 on 98.4% of 64 dev prompts\n      fp16 '[1]'                                    fp32 '[1] \\n[2]'\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/661 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"40339e17f4ba4ee0a1637152b0e14057"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"9df70d38efd5498eacfcc9aa8c750934"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.json: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"5152944620aa43bdb5c4cf3b9d86c941"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"merges.txt: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8ff853c496ba40278d8f8d5b863ded2b"}},"me