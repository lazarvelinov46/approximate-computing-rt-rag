_config()\nCFG_L = load_config(model=\"llama32_3b\")\nQWEN, LLAMA = CFG_Q[\"models\"][\"generator\"], CFG_L[\"models\"][\"generator\"]\n\nchk = copy.deepcopy(CFG_L)\nchk[\"models\"][\"generator\"] = QWEN\nassert chk == CFG_Q, \"the overlay changed more than the generator\"\nprint(f\"{QWEN} -> {results_dir(QWEN)}\\n{LLAMA} -> {results_dir(LLAMA)}\")\n\n# results/ is a gitignore WHITELIST — a non-whitelisted model dir never pushes.\nos.makedirs(results_dir(LLAMA), exist_ok=True)\nprobe = results_dir(LLAMA) / \"_probe.csv\"\nprobe.touch()\nignored = subprocess.run([\"git\", \"check-ignore\", \"-q\", str(probe)]).returncode == 0\nprobe.unlink()\nassert not ignored, \"results/llama32_3b/ is gitignored — whitelist it in .gitignore\"\nprint(\"results/llama32_3b/ is pushable\")","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-09-21T22:39:33.185789Z","iopub.execute_input":"2026-09-21T22:39:33.186322Z","iopub.status.idle":"2026-09-21T22:39:53.041192Z","shell.execute_reply.started":"2026-09-21T22:39:33.186286Z","shell.execute_reply":"2026-09-21T22:39:53.03976Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m58.4/58.4 kB\u001b[0m \u001b[31m1.6 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25h  Installing build dependencies ... \u001b[?25l\u001b[?25hdone\n  Getting requirements to build wheel ... \u001b[?25l\u001b[?25hdone\n  Preparing metadata (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m18.8/18.8 MB\u001b[0m \u001b[31m51.3 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m:00:01\u001b[0m00:01\u001b[0m\n\u001b[?25h  Building wheel for hqq (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n/kaggle/working/ac-rag-stack\n\u001b[33mf3f9dd7\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD -> \u001b[m\u001b[1;32mmain\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/main\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/HEAD\u001b[m\u001b[33m)\u001b[m Moved llama yaml into models\n{'transformers': '5.0.0', 'tokenizers': '0.22.2', 'torch': '2.10.0+cpu', 'hqq': '0.2.8.post1', 'faiss-cpu': '1.15.1', 'sentence-transformers': '5.4.1', 'datasets': '5.0.0'}\nQwen/Qwen2.5-3B-Instruct -> /kaggle/working/ac-rag-stack/results\nmeta-llama/Llama-3.2-3B-Instruct -> /kaggle/working/ac-rag-stack/results/llama32_3b\nresults/llama32_3b/ is pushable\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# notebooks/33_ac_llama32_3b — CELL 2   [CPU]\n# Qwen must be untouched by the model.py changes (date pin, no added special\n# tokens). Every frozen Qwen prompt is rebuilt from its STORED retrieved_ids —\n# no embedder, no GPU — and checked four ways, all of which must be 0.\nimport numpy as np\nfrom src.data.loader import load_from_config\nfrom src.data import corpus as C\nimport src.generator.model as G\nimport src.pipeline.rag as R\n\nAUDIT = {\"versions\": VERSIONS}\n\nexs = load_from_config(CFG_Q)\nBY_QID = {e.qid: e for e in exs}\ncorpus = C.build_corpus(verbose=False)\nassert corpus.manifest[\"sha256\"] == \\\n    C.load_manifest(\"results/corpus_a1_manifest.json\")[\"sha256\"], \"A1 corpus drifted\"\n\ndef passages(e, ids, regime):\n    return [e.paragraphs[i] for i in ids] if regime == 1 else [corpus.texts[i] for i in ids]\n\ndef legacy_prompt(tok, question, paras, system):\n    \"\"\"build_prompt exactly as it was before the date pin.\"\"\"\n    user = f\"Context:\\n{G.build_context(paras)}\\n\\nQuestion: {question}\"\n    return tok.apply_chat_template(\n        [{\"role\": \"system\", \"content\": system}, {\"role\": \"user\", \"content\": user}],\n        tokenize=False, add_generation_prompt=True)\n\n# label -> (csv, setting, mode, regime)\nFROZEN = {\n    \"r1_short_k5\":   (\"results/baseline_1k_results.csv\",         \"baseline\",            \"short\",   1),\n    \"r1_explain_k5\": (\"results/baseline_explain_1k_results.csv\", \"baseline_explain\",    \"explain\", 1),\n    \"r1_short_k10\":  (\"results/knob5_results.csv\",               \"topk_10\",             \"short\",   1),\n    \"r2_short_k5\":   (\"results/regime2_a1_baseline_results.csv\", \"regime2_a1_baseline\", \"short\",   2),\n}\nSYSTEM_OF = {\"short\": G.SYSTEM, \"explain\": G.SYSTEM_EXPLAIN}\n\ntokQ = G.load_tokenizer(QWEN)\nFROZEN_ROWS = {}\nfor label, (path, setting, mode, regime) in FROZEN.items():\n    df = R.load_results(path, setting=setting)\n    assert len(df) == 1000 and df.qid.nunique() == 1000, f\"{label}: {len(df)} rows\"\n    FROZEN_ROWS[label] = df\n    es = [BY_QID[q] for q in df.qid]\n    paras = [passages(e, [int(x) for x in s.split()], regime)\n             for e, s in zip(es, df.retrieved_ids)]\n    new = [G.build_prompt(tokQ, e.question, p, system=SYSTEM_OF[mode]) for e, p in zip(es, paras)]\n    old = [legacy_prompt(tokQ, e.question, p, SYSTEM_OF[mode]) for e, p in zip(es, paras)]\n    texts = df.raw_generation if mode == \"explain\" else df.prediction\n    res = {\n        \"string\":        sum(a != b for a, b in zip(new, old)),\n        \"prompt_tokens\": sum(G.n_tokens(tokQ, p) != int(t)\n                             for p, t in zip(new, df.prompt_tokens)),\n        \"ids\":           sum(a != b for a, b in zip(tokQ(new)[\"input_ids\"],\n                                                    tokQ(new, **G.ENCODE_KWARGS)[\"input_ids\"])),\n        \"decode_tokens\": sum(G.n_tokens(tokQ, t) != int(d)\n                             for t, d in zip(texts, df.decode_tokens)),\n    }\n    AUDIT.setdefault(\"qwen_identity\", {})[label] = res\n    print(f\"{label:<14} \" + \"  \".join(f\"{k} {v}\" for k, v in res.items()))\n    assert not any(res.values()), f\"{label}: the Qwen path changed\"\nprint(\"\\nQwen byte-identical: strings, ids, prompt_tokens, decode_tokens\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T22