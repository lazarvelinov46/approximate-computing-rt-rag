nimport src.retriever.embed as E\nimport src.pipeline.rag as R\nimport src.metrics.quality as Q\n\nassert version(\"transformers\") == \"5.0.0\"\nassert torch.cuda.device_count() == 2, \"need T4 x2 (gpu1 hosts the fp32 reference)\"\n\nCFG_Q, CFG_L = load_config(), load_config(model=\"llama32_3b\")\nQWEN, LLAMA = CFG_Q[\"models\"][\"generator\"], CFG_L[\"models\"][\"generator\"]\nOUTDIR = results_dir(LLAMA)\nB = CFG_L[\"generation\"][\"batch_size\"]\nTOP_K = CFG_L[\"retrieval\"][\"top_k\"]\nMNT = {\"short\": CFG_L[\"generation\"][\"max_new_tokens\"],\n       \"explain\": CFG_L[\"generation\"][\"max_new_tokens_explain\"]}\nSYSTEM_OF = {\"short\": G.SYSTEM, \"explain\": G.SYSTEM_EXPLAIN}\nAUDIT_B = {}\n\nexs = load_from_config(CFG_L)\nBY_QID = {e.qid: e for e in exs}\ncorpus = C.build_corpus(verbose=False)\nassert corpus.manifest[\"sha256\"] == \\\n    C.load_manifest(\"results/corpus_a1_manifest.json\")[\"sha256\"], \"A1 corpus drifted\"\n\nfrozen = {e.qid for e in exs}\npool = load_hotpotqa(subset_size=800, seed=7, verbose=False)\ndev = [e for e in pool if e.qid not in frozen][:200]            # notebook 02's dev sample\nassert len(dev) == 200\n\ngen, tok = G.load_generator(LLAMA)                               # fp16, gpu0\nW_GIB = torch.cuda.memory_allocated(0) / 2**30\nsnap = getattr(gen.config, \"_commit_hash\", None) or HfApi().model_info(LLAMA).sha\nAUDIT_B.update(snapshot=snap, weights_gib=round(W_GIB, 2),\n               attn_impl=gen.config._attn_implementation)\nprint(f\"{LLAMA}\\n  snapshot {snap}\\n  weights {W_GIB:.2f} GiB on gpu0, \"\n      f\"dtype {gen.dtype}, attn {gen.config._attn_implementation}\")\n\nembedder = E.load_embedder(CFG_L[\"models\"][\"embedder\"])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-22T10:01:17.637111Z","iopub.execute_input":"2026-09-22T10:01:17.638023Z","iopub.status.idle":"2026-09-22T10:02:56.487171Z","shell.execute_reply.started":"2026-09-22T10:01:17.63798Z","shell.execute_reply":"2026-09-22T10:02:56