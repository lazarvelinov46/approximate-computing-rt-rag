short)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/661 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"3883cdb09efe4fc3b4baf8b98c2f7f33"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"81a0e0560bb647bd9740d44e914ff5b3"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.json: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"1166fd513ee14f819fadd03513a4f7ec"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"merges.txt: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"def3729106824afa94fd2492a5aef8f5"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer.json: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"9e9603bb38224c56a1cd184acce5aaab"}},"metadata":{}},{"name":"stdout","text":"r1_short_k5    string 0  prompt_tokens 0  ids 0  decode_tokens 0\nr1_explain_k5  string 0  prompt_tokens 0  ids 0  decode_tokens 0\nr1_short_k10   string 0  prompt_tokens 0  ids 0  decode_tokens 0\nr2_short_k5    string 0  prompt_tokens 0  ids 0  decode_tokens 0\n\nQwen byte-identical: strings, ids, prompt_tokens, decode_tokens\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# notebooks/33_ac_llama32_3b — CELL 3   [CPU]\n# Llama tokenizer as load_generator configures it, the pinned template, the\n# double BOS the old tokenization produces, and prompt lengths / worst-batch\n# KV for every prompt set in the run plan.\nimport datetime\nfrom transformers import AutoConfig, GenerationConfig\n\ntokL = G.load_tokenizer(LLAMA)\neos = GenerationConfig.from_pretrained(LLAMA).eos_token_id\neos = eos if isinstance(eos, list) else [eos]\nprint(f\"bos {tokL.bos_token!r} {tokL.bos_token_id} | eos {tokL.eos_token!r} {tokL.eos_token_id} | \"\n      f\"pad {tokL.pad_token!r} {tokL.pad_token_id} | generation eos {eos}\")\nassert tokL.eos_token_id in eos, \"tokenizer eos is not a generation stop id\"\nassert tokL.pad_token in tokL.all_special_tokens, \"pad not special — batch_decode would keep it\"\n\nrow = FROZEN_ROWS[\"r1_short_k5\"].iloc[0]\ne0 = BY_QID[row.qid]\np0 = passages(e0, [int(x) for x in row.retrieved_ids.split()], 1)\nnew, old = G.build_prompt(tokL, e0.question, p0), legacy_prompt(tokL, e0.question, p0, G.SYSTEM)\ntoday = datetime.datetime.now().strftime(\"%d %b %Y\")\nassert f\"Today Date: {G.TEMPLATE_KWARGS['date_string']}\" in new\nassert f\"Today Date: {today}\" in old, \"unpinned render did not inject today's date — inspect the template\"\nprint(new[:new.index(\"Context:\")] + \"...\\n\")\n\nbos = tokL.bos_token_id\nids_old = tokL(new)[\"input_ids\"]\nids_new = tokL(new, **G.ENCODE_KWARGS)[\"input_ids\"]\nprint(f\"BOS count: old tokenization {ids_old.count(bos)}, ENCODE_KWARGS {ids_new.count(bos)}\")\nassert ids_new[0] == bos and ids_new.count(bos) == 1\nAUDIT[\"llama_tokenizer\"] = {\"bos\": tokL.bos_token, \"eos\": tokL.eos_token, \"pad\": tokL.pad_token,\n                            \"generation_eos\": eos, \"bos_old\": ids_old.count(bos),\n                            \"bos_new\": ids_new.count(bos),\n                            \"date_string\": G.TEMPLATE_KWARGS[\"date_string\"]}\n\nGEOM = {m: G.kv_geometry(AutoConfig.from_pretrained(m)) for m in (QWEN, LLAMA)}\nfor m, g in GEOM.items():\n    print(f\"{m}: {g}\")\n\nB = CFG_L[\"generation\"][\"batch_size\"]\nMNT = {\"short\": CFG_L[\"generation\"][\"max_new_tokens\"],\n       \"explain\": CFG_L[\"generation\"][\"max_new_tokens_explain\"]}\n# (name, frozen source, k slice). k=2/3 are prefixes of the k=5 ranking, which\n# knob 5 verified equal search(k=j) exactly.\nSETS = [(\"r1_short_k2\", \"r1_short_k5\", 2), (\"r1_short_k3\", \"r1_short_k5\", 3),\n        (\"r1_short_k5\", \"r1_short_k5\", None), (\"r1_short_k10\", \"r1_short_k10\", None),\n        (\"r1_explain_k5\", \"r1_explain_k5\", None), (\"r2_short_k5\", \"r2_short_k5\", None)]\n\nPLENS = {QWEN: {}, LLAMA: {}}\nLEN_ROWS = []\nprint(f\"\\n{'set':<14} {'model':<6} {'mean':>6} {'p50':>6} {'p99':>6} {'max':>6} \"\n      f\"{'worst b16':>9} {'KV@worst GiB':>13}\")\nfor name, src, k in SETS:\n    _, _, mode, regime = FROZEN[src]\n    df = FROZEN_ROWS[src]\n    es = [BY_QID[q] for q in df.qid]\n    paras = [passages(e, [int(x) for x in s.split()][:k], regime)\n             for e, s in zip(es, df.retrieved_ids)]\n    for model, tok, short in ((QWEN, tokQ, \"qwen\"), (LLAMA, tokL, \"llama\")):\n        pl = np.array([G.n_tokens(tok, G.build_prompt(tok, e.question, p, system=SYSTEM_OF[mode]))\n                       for e, p in zip(es, paras)])\n        PLENS[model][name] = pl\n        worst = int(max(pl[i:i + B].max() for i in range(0, len(pl), B)))\n        kv = GEOM[model][\"kv_bytes_per_token\"] * B * (worst + MNT[mode]) / 2**30\n        rec = {\"set\": name, \"model\": short, \"mean\": round(float(pl.mean()), 1),\n               \"p50\": int(np.percentile(pl, 50)), \"p99\": int(np.percentile(pl, 99)),\n               \"max\": int(pl.max()), \"worst_chunk_b16\": worst, \"kv_gib_worst\": round(kv, 2)}\n        LEN_ROWS.append(rec)\n        print(f\"{name:<14} {short:<6} {rec['mean']:>6.0f} {rec['p50']:>6} {rec['p99']:>6} \"\n              f\"{rec['max']:>6} {worst:>9} {kv:>13.2f}\")\nAUDIT[\"geometry\"] = {m.split(\"/\")[-1]: g for m, g in GEOM.items()}\nAUDIT[\"lengths\"] = LEN_ROWS","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T22:41:31.643582Z","iopub.execute_input":"2026-09-21T22:41:31.644169Z","iopub.status.idle":"2026-09-21T22:42:12.611158Z","shell.execute_reply.started":"2026-09-21T22:41:31.644121Z","shell.e