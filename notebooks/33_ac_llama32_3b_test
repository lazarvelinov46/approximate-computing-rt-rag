{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# notebooks/33_ac_llama32_3b — CELL 1   [PART A: CPU]\n# Kaggle: Accelerator = None, Internet = On, Add-ons → Secrets → HF_TOKEN ON\n# (the account with Meta's license accepted — the tokenizer is gated too).\n# Part B (GPU smoke) is appended to this notebook later and run on T4 x2.\n# hqq BEFORE transformers is imported: is_hqq_available() is cached at import.\n!pip install -q datasets sentence-transformers faiss-cpu hqq \"transformers==5.0.0\"\n\nimport os\nos.environ[\"HF_HOME\"] = \"/kaggle/temp/hf_cache\"\nos.environ[\"TOKENIZERS_PARALLELISM\"] = \"false\"\n\nfrom kaggle_secrets import UserSecretsClient\nfrom huggingface_hub import login\nlogin(token=UserSecretsClient().get_secret(\"HF_TOKEN\"))\n\nREPO_URL = \"https://github.com/lazarvelinov46/approximate-computing-rt-rag.git\"\nDEST     = \"/kaggle/working/ac-rag-stack\"\nif os.path.isdir(DEST):\n    !git -C \"{DEST}\" pull -q\nelse:\n    !git clone -q \"{REPO_URL}\" \"{DEST}\"\n%cd {DEST}\nimport sys\nif \".\" not in sys.path:\n    sys.path.insert(0, \".\")\n!git log --oneline -1\n\nimport copy, json, subprocess\nfrom importlib.metadata import version\n\nVERSIONS = {p: version(p) for p in (\"transformers\", \"tokenizers\", \"torch\", \"hqq\",\n                                    \"faiss-cpu\", \"sentence-transformers\", \"datasets\")}\nprint(VERSIONS)\nassert VERSIONS[\"transformers\"] == \"5.0.0\", \"every Qwen result was produced on 5.0.0\"\n\nfrom src.config import load_config, results_dir\nCFG_Q = load_config()\nCFG_L = load_config(model=\"llama32_3b\")\nQWEN, LLAMA = CFG_Q[\"models\"][\"generator\"], CFG_L[\"models\"][\"generator\"]\n\nchk = copy.deepcopy(CFG_L)\nchk[\"models\"][\"generator\"] = QWEN\nassert chk == CFG_Q, \"the overlay changed more than the generator\"\nprint(f\"{QWEN} -> {results_dir(QWEN)}\\n{LLAMA} -> {results_dir(LLAMA)}\")\n\n# results/ is a gitignore WHITELIST — a non-whitelisted model dir never pushes.\nos.makedirs(results_dir(LLAMA), exist_ok=True)\nprobe = results_dir(LLAMA) / \"_probe.csv\"\nprobe.touch()\nignored = subprocess.run([\"git\", \"check-ignore\", \"-q\", str(probe)]).returncode == 0\nprobe.unlink()\nassert not ignored, \"results/llama32_3b/ is gitignored — whitelist it in .gitignore\"\nprint(\"results/llama32_3b/ is pushable\")","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-09-21T22:39:33.185789Z","iopub.execute_input":"2026-09-21T22:39:33.186322Z","iopub.status.idle":"2026-09-21T22:39:53.041192Z","shell.execute_reply.started":"2026-09-21T22:39:33.186286Z","shell.execute_reply":"2026-09-21T22:39:53.03976Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/33_ac_llama32_3b — CELL 2   [CPU]\n# Qwen must be untouched by the model.py changes (date pin, no added special\n# tokens). Every frozen Qwen prompt is rebuilt from its STORED retrieved_ids —\n# no embedder, no GPU — and checked four ways, all of which must be 0.\nimport numpy as np\nfrom src.data.loader import load_from_config\nfrom src.data import corpus as C\nimport src.generator.model as G\nimport src.pipeline.rag as R\n\nAUDIT = {\"versions\": VERSIONS}\n\nexs = load_from_config(CFG_Q)\nBY_QID = {e.qid: e for e in exs}\ncorpus = C.build_corpus(verbose=False)\nassert corpus.manifest[\"sha256\"] == \\\n    C.load_manifest(\"results/corpus_a1_manifest.json\")[\"sha256\"], \"A1 corpus drifted\"\n\ndef passages(e, ids, regime):\n    return [e.paragraphs[i] for i in ids] if regime == 1 else [corpus.texts[i] for i in ids]\n\ndef legacy_prompt(tok, question, paras, system):\n    \"\"\"build_prompt exactly as it was before the date pin.\"\"\"\n    user = f\"Context:\\n{G.build_context(paras)}\\n\\nQuestion: {question}\"\n    return tok.apply_chat_template(\n        [{\"role\": \"system\", \"content\": system}, {\"role\": \"user\", \"content\": user}],\n        tokenize=False, add_generation_prompt=True)\n\n# label -> (csv, setting, mode, regime)\nFROZEN = {\n    \"r1_short_k5\":   (\"results/baseline_1k_results.csv\",         \"baseline\",            \"short\",   1),\n    \"r1_explain_k5\": (\"results/baseline_explain_1k_results.csv\", \"baseline_explain\",    \"explain\", 1),\n    \"r1_short_k10\":  (\"results/knob5_results.csv\",               \"topk_10\",             \"short\",   1),\n    \"r2_short_k5\":   (\"results/regime2_a1_baseline_results.csv\", \"regime2_a1_baseline\", \"short\",   2),\n}\nSYSTEM_OF = {\"short\": G.SYSTEM, \"explain\": G.SYSTEM_EXPLAIN}\n\ntokQ = G.load_tokenizer(QWEN)\nFROZEN_ROWS = {}\nfor label, (path, setting, mode, regime) in FROZEN.items():\n    df = R.load_results(path, setting=setting)\n    assert len(df) == 1000 and df.qid.nunique() == 1000, f\"{label}: {len(df)} rows\"\n    FROZEN_ROWS[label] = df\n    es = [BY_QID[q] for q in df.qid]\n    paras = [passages(e, [int(x) for x in s.split()], regime)\n             for e, s in zip(es, df.retrieved_ids)]\n    new = [G.build_prompt(tokQ, e.question, p, system=SYSTEM_OF[mode]) for e, p in zip(es, paras)]\n    old = [legacy_prompt(tokQ, e.question, p, SYSTEM_OF[mode]) for e, p in zip(es, paras)]\n    texts = df.raw_generation if mode == \"explain\" else df.prediction\n    res = {\n        \"string\":        sum(a != b for a, b in zip(new, old)),\n        \"prompt_tokens\": sum(G.n_tokens(tokQ, p) != int(t)\n                             for p, t in zip(new, df.prompt_tokens)),\n        \"ids\":           sum(a != b for a, b in zip(tokQ(new)[\"input_ids\"],\n                                                    tokQ(new, **G.ENCODE_KWARGS)[\"input_ids\"])),\n        \"decode_tokens\": sum(G.n_tokens(tokQ, t) != int(d)\n                             for t, d in zip(texts, df.decode_tokens)),\n    }\n    AUDIT.setdefault(\"qwen_identity\", {})[label] = res\n    print(f\"{label:<14} \" + \"  \".join(f\"{k} {v}\" for k, v in res.items()))\n    assert not any(res.values()), f\"{label}: the Qwen path changed\"\nprint(\"\\nQwen byte-identical: strings, ids, prompt_tokens, decode_tokens\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T22:39:53.043709Z","iopub.execute_input":"2026-09-21T22:39:53.044141Z","iopub.status.idle":"2026-09-21T22:41:31.641798Z","shell.execute_reply.started":"2026-09-21T22:39:53.0441Z","shell.execute_reply":"2026-09-21T22:41:31.640433Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/33_ac_llama32_3b — CELL 3   [CPU]\n# Llama tokenizer as load_generator configures it, the pinned template, the\n# double BOS the old tokenization produces, and prompt lengths / worst-batch\n# KV for every prompt set in the run plan.\nimport datetime\nfrom transformers import AutoConfig, GenerationConfig\n\ntokL = G.load_tokenizer(LLAMA)\neos = GenerationConfig.from_pretrained(LLAMA).eos_token_id\neos = eos if isinstance(eos, list) else [eos]\nprint(f\"bos {tokL.bos_token!r} {tokL.bos_token_id} | eos {tokL.eos_token!r} {tokL.eos_token_id} | \"\n      f\"pad {tokL.pad_token!r} {tokL.pad_token_id} | generation eos {eos}\")\nassert tokL.eos_token_id in eos, \"tokenizer eos is not a generation stop id\"\nassert tokL.pad_token in tokL.all_special_tokens, \"pad not special — batch_decode would keep it\"\n\nrow = FROZEN_ROWS[\"r1_short_k5\"].iloc[0]\ne0 = BY_QID[row.qid]\np0 = passages(e0, [int(x) for x in row.retrieved_ids.split()], 1)\nnew, old = G.build_prompt(tokL, e0.question, p0), legacy_prompt(tokL, e0.question, p0, G.SYSTEM)\ntoday = datetime.datetime.now().strftime(\"%d %b %Y\")\nassert f\"Today Date: {G.TEMPLATE_KWARGS['date_string']}\" in new\nassert f\"Today Date: {today}\" in old, \"unpinned render did not inject today's date — inspect the template\"\nprint(new[:new.index(\"Context:\")] + \"...\\n\")\n\nbos = tokL.bos_token_id\nids_old = tokL(new)[\"input_ids\"]\nids_new = tokL(new, **G.ENCODE_KWARGS)[\"input_ids\"]\nprint(f\"BOS count: old tokenization {ids_old.count(bos)}, ENCODE_KWARGS {ids_new.count(bos)}\")\nassert ids_new[0] == bos and ids_new.count(bos) == 1\nAUDIT[\"llama_tokenizer\"] = {\"bos\": tokL.bos_token, \"eos\": tokL.eos_token, \"pad\": tokL.pad_token,\n                            \"generation_eos\": eos, \"bos_old\": ids_old.count(bos),\n                            \"bos_new\": ids_new.count(bos),\n                            \"date_string\": G.TEMPLATE_KWARGS[\"date_string\"]}\n\nGEOM = {m: G.kv_geometry(AutoConfig.from_pretrained(m)) for m in (QWEN, LLAMA)}\nfor m, g in GEOM.items():\n    print(f\"{m}: {g}\")\n\nB = CFG_L[\"generation\"][\"batch_size\"]\nMNT = {\"short\": CFG_L[\"generation\"][\"max_new_tokens\"],\n       \"explain\": CFG_L[\"generation\"][\"max_new_tokens_explain\"]}\n# (name, frozen source, k slice). k=2/3 are prefixes of the k=5 ranking, which\n# knob 5 verified equal search(k=j) exactly.\nSETS = [(\"r1_short_k2\", \"r1_short_k5\", 2), (\"r1_short_k3\", \"r1_short_k5\", 3),\n        (\"r1_short_k5\", \"r1_short_k5\", None), (\"r1_short_k10\", \"r1_short_k10\", None),\n        (\"r1_explain_k5\", \"r1_explain_k5\", None), (\"r2_short_k5\", \"r2_short_k5\", None)]\n\nPLENS = {QWEN: {}, LLAMA: {}}\nLEN_ROWS = []\nprint(f\"\\n{'set':<14} {'model':<6} {'mean':>6} {'p50':>6} {'p99':>6} {'max':>6} \"\n      f\"{'worst b16':>9} {'KV@worst GiB':>13}\")\nfor name, src, k in SETS:\n    _, _, mode, regime = FROZEN[src]\n    df = FROZEN_ROWS[src]\n    es = [BY_QID[q] for q in df.qid]\n    paras = [passages(e, [int(x) for x in s.split()][:k], regime)\n             for e, s in zip(es, df.retrieved_ids)]\n    for model, tok, short in ((QWEN, tokQ, \"qwen\"), (LLAMA, tokL, \"llama\")):\n        pl = np.array([G.n_tokens(tok, G.build_prompt(tok, e.question, p, system=SYSTEM_OF[mode]))\n                       for e, p in zip(es, paras)])\n        PLENS[model][name] = pl\n        worst = int(max(pl[i:i + B].max() for i in range(0, len(pl), B)))\n        kv = GEOM[model][\"kv_bytes_per_token\"] * B * (worst + MNT[mode]) / 2**30\n        rec = {\"set\": name, \"model\": short, \"mean\": round(float(pl.mean()), 1),\n               \"p50\": int(np.percentile(pl, 50)), \"p99\": int(np.percentile(pl, 99)),\n               \"max\": int(pl.max()), \"worst_chunk_b16\": worst, \"kv_gib_worst\": round(kv, 2)}\n        LEN_ROWS.append(rec)\n        print(f\"{name:<14} {short:<6} {rec['mean']:>6.0f} {rec['p50']:>6} {rec['p99']:>6} \"\n              f\"{rec['max']:>6} {worst:>9} {kv:>13.2f}\")\nAUDIT[\"geometry\"] = {m.split(\"/\")[-1]: g for m, g in GEOM.items()}\nAUDIT[\"lengths\"] = LEN_ROWS","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T22:41:31.643582Z","iopub.execute_input":"2026-09-21T22:41:31.644169Z","iopub.status.idle":"2026-09-21T22:42:12.611158Z","shell.execute_reply.started":"2026-09-21T22:41:31.644121Z","shell.execute_reply":"2026-09-21T22:42:12.609946Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/33_ac_llama32_3b — CELL 4   [CPU]\n# Knob-4 machinery on Llama. Real rope parameters and real attention geometry\n# (24 query / 8 KV heads, head_dim 128); only depth, MLP width and vocab are\n# shrunk. No GQA grouping-ORDER test: mean over each query group, then mean\n# over KV heads, equals the flat mean for ANY grouping — it could not fail.\n# What can fail: 24 % 8, the hook on LlamaAttention under eager, and the\n# policies' invariants on this geometry.\nimport random, torch\nfrom transformers import AutoModelForCausalLM\nfrom transformers.models.llama.modeling_llama import LlamaRotaryEmbedding, rotate_half as rh_llama\nfrom transformers.models.qwen2.modeling_qwen2 import Qwen2RotaryEmbedding, rotate_half as rh_qwen\nfrom src.generator import eviction as EV\n\nEV.selftest()\nlcfg, qcfg = AutoConfig.from_pretrained(LLAMA), AutoConfig.from_pretrained(QWEN)\nrp = lcfg.rope_parameters\nprint(f\"llama rope_parameters: {rp}\")\nassert rp[\"rope_type\"] == \"llama3\" and rp[\"rope_type\"] in EV.STATIC_ROPE\n\nx = torch.randn(2, 8, 5, 128)                       # eviction.py imports qwen2's\nassert torch.equal(rh_qwen(x), rh_llama(x))          # rotate_half — same map?\n\nrotL, rotQ = LlamaRotaryEmbedding(config=lcfg), Qwen2RotaryEmbedding(config=qcfg)\nassert float(rotL.attention_scaling) == 1.0\nhd = GEOM[LLAMA][\"head_dim\"]\nplain = 1.0 / (rp[\"rope_theta\"] ** (torch.arange(0, hd, 2, dtype=torch.float32) / hd))\nn_scaled = int((~torch.isclose(rotL.inv_freq, plain)).sum())\nprint(f\"llama3 scaling moved {n_scaled}/{hd // 2} frequencies (0 = default path ran instead)\")\nassert n_scaled > 0\n\ndef rotate_to(rot, rh, k_raw, positions):\n    \"\"\"Ground truth: rotate raw keys to absolute positions via the model's rope.\"\"\"\n    cos, sin = rot(k_raw, torch.tensor(positions, dtype=torch.long)[None])\n    return k_raw * cos[:, None] + rh(k_raw) * sin[:, None]\n\ndef composition_err(rot, rh, p_from, p_to):\n    torch.manual_seed(0)\n    k_raw = torch.randn(1, 8, len(p_from), hd)\n    layer = EV._build_layer(\"sink_recent\", 0.5, EV.DEFAULT_SINK, 42, True,\n                            rot.inv_freq.detach(), 0)\n    delta = torch.tensor([b - a for a, b in zip(p_from, p_to)], dtype=torch.long)\n    composed = layer._rotate(rotate_to(rot, rh, k_raw, p_from), delta)\n    return (composed - rotate_to(rot, rh, k_raw, p_to)).abs().max().item()\n\n# A. notebook 22's positions; B. study scale — longest Llama regime-1 prompt,\n# hollow r0.25 keep-set, compared against Qwen's rope on identical positions.\ne_small = composition_err(rotL, rh_llama, [0, 1, 2, 3, 28, 29], [24, 25, 26, 27, 28, 29])\nS = int(PLENS[LLAMA][\"r1_short_k5\"].max())\nb = EV.budget_for(S, 0.25, \"random\")\nrng = random.Random(42)\np_from = sorted(rng.sample(range(S - 1), b - 1)) + [S - 1]\np_to = list(range(S - b, S))\ne_L = composition_err(rotL, rh_llama, p_from, p_to)\ne_Q = composition_err(rotQ, rh_qwen, p_from, p_to)\nprint(f\"composition max|err|: nb22 positions {e_small:.2e} | S={S} r0.25: \"\n      f\"llama3 {e_L:.2e}, qwen rope {e_Q:.2e}\")\nassert e_small < 1e-5, \"rotation composition is not exact under llama3 rope\"\nassert e_L <= 2 * e_Q + 1e-6, \"llama3 composition error exceeds what the Qwen runs tolerated\"\n\n# C. end-to-end on a tiny Llama with the real attention geometry\ntiny = AutoConfig.from_pretrained(LLAMA, num_hidden_layers=2, intermediate_size=256,\n                                  vocab_size=512)\ntorch.manual_seed(42)\nm = AutoModelForCausalLM.from_config(tiny).float().eval()\nm.generation_config.eos_token_id = None              # vocab 512: run every decode step\ngeo = G.kv_geometry(m.config)\nassert (geo[\"n_kv_heads\"], geo[\"q_per_kv\"], geo[\"head_dim\"]) == (8, 3, 128), geo\nassert torch.equal(m.model.rotary_emb.inv_freq, rotL.inv_freq)\n\nPROMPT_LEN, NEW = 64, 12\nids = torch.randint(0, 512, (1, PROMPT_LEN))\nmask = torch.ones_like(ids)\n\ndef gen(cache=None):\n    with EV.attention_scoring(m, cache), torch.no_grad():\n        out = m.generate(input_ids=ids, attention_mask=mask, past_key_values=cache,\n                         max_new_tokens=NEW, do_sample=False, pad_token_id=0)\n    return out[:, PROMPT_LEN:]\n\nassert EV.make_cache(m, \"recency\", 1.0) is None       # keep_ratio 1.0 = untouched path\nEV_ROWS = {}\nfor policy in (\"recency\", \"sink_recent\", \"random\", \"attention\"):\n    m.set_attn_implementation(\"eager\" if policy == \"attention\" else \"sdpa\")\n    c = EV.make_cache(m, policy, 0.5)\n    out = gen(c)\n    L0, want = c.layers[0], EV.budget_for(PROMPT_LEN, 0.5, policy)\n    phase_ok = all(bool((l.phase.diff() == 1).all())\n                   and int(l.phase[-1]) == l.cumulative_length - 1 for l in c.layers)\n    rec = {\"budget\": int(L0.budget), \"stored\": int(L0.keys.shape[-2]),\n           \"evicted\": int(L0.evicted), \"rotations\": int(L0.rotations), \"phase_ok\": phase_ok,\n           \"deterministic\": bool(torch.equal(out, gen(EV.make_cache(m, policy, 0.5))))}\n    if policy == \"attention\":\n        rec[\"scores_finite\"] = all(bool(torch.isfinite(l.scores / l.n_obs.clamp(min=1)).all())\n                                   and bool((l.n_obs > 0).all()) for l in c.layers)\n        rec[\"layer_keepsets_differ\"] = (set(c.layers[0]._last_keep.tolist())\n                                        != set(c.layers[1]._last_keep.tolist()))\n    EV_ROWS[policy] = rec\n    print(f\"{policy:<12} {rec}\")\n    assert rec[\"budget\"] == want and rec[\"stored\"] == want and rec[\"evicted\"] > 0\n    assert phase_ok and rec[\"deterministic\"]\n    assert (rec[\"rotations\"] == 0) if policy == \"recency\" else (rec[\"rotations\"] > 0)\n    if policy == \"attention\":\n        assert rec[\"scores_finite\"]\nm.set_attn_implementation(\"sdpa\")\n\nAUDIT[\"rope\"] = {\"rope_parameters\": rp, \"n_scaled_freqs\": n_scaled, \"S\": S,\n                 \"err_nb22_positions\": e_small, \"err_llama3_study_scale\": e_L,\n                 \"err_qwen_study_scale\": e_Q}\nAUDIT[\"eviction_tiny_llama\"] = EV_ROWS","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T22:42:12.613892Z","iopub.execute_input":"2026-09-21T22:42:12.614334Z","iopub.status.idle":"2026-09-21T22:42:19.845779Z","shell.execute_reply.started":"2026-09-21T22:42:12.614299Z","shell.execute_reply":"2026-09-21T22:42:19.844829Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/33_ac_llama32_3b — CELL 5   [CPU]\n# Knob 3 on Llama geometry. (a) channel alignment for every real batch via\n# kv_cache.channels_per_group, whose defaults are QWEN's (2 KV heads) — the\n# geometry is passed explicitly. (b) every planned setting through the real\n# QuantizedCache update path at the worst real batch, both padded-length\n# parities. (c) a control that MUST show misalignment, so (b) can fail.\nfrom transformers import QuantizedCache\nfrom src.generator import kv_cache as KV\n\nKV.selftest()\nB = CFG_L[\"generation\"][\"batch_size\"]\nKNOB3 = [(8, 32), (4, 32), (3, 32), (2, 32), (2, 16)]            # (nbits, group)\n\nALIGN = {}\nfor model in (LLAMA, QWEN):\n    g, tag = GEOM[model], model.split(\"/\")[-1]\n    for G_ in (32, 16):\n        per_batch, s = KV.batch_alignment([int(x) for x in PLENS[model][\"r1_short_k5\"]], B,\n                                          q_group_size=G_, num_kv_heads=g[\"n_kv_heads\"],\n                                          head_dim=g[\"head_dim\"])\n        off = [(bi, bs, S_, cpg) for bi, bs, S_, cpg in per_batch if cpg != 1]\n        ALIGN[f\"{tag}_g{G_}\"] = {\"frac_true_per_channel\": s[\"frac_true_per_channel\"],\n                                 \"misaligned_batches\": off}\n        print(f\"{tag:<24} G={G_:<3} per-channel {s['frac_true_per_channel']:.4f}  \"\n              f\"misaligned (batch, size, padded, chan/grp): {off or 'none'}\")\nfor G_ in (32, 16):\n    assert ALIGN[f\"Llama-3.2-3B-Instruct_g{G_}\"][\"frac_true_per_channel\"] == 1.0\n\nKVH, HD = GEOM[LLAMA][\"n_kv_heads\"], GEOM[LLAMA][\"head_dim\"]\nS_W = int(max(PLENS[LLAMA][\"r1_short_k5\"][i:i + B].max() for i in range(0, 1000, B)))\n\ndef spike(t, channels=(7, 31, 64, 99), gain=20.0):\n    out = t.clone()\n    out[..., list(channels)] *= gain\n    return out\n\ndef rmse_through_cache(cfg, nbits, group, batch, seq, n_kv):\n    torch.manual_seed(42)\n    k = spike(torch.randn(batch, n_kv, seq, HD, dtype=torch.float16))\n    cache = QuantizedCache(backend=\"hqq\", config=cfg, nbits=nbits, axis_key=0, axis_value=0,\n                           q_group_size=group, residual_length=KV.RESIDUAL_LENGTH)\n    cache.update(k, k.clone(), layer_idx=0)                       # prefill: quantized once\n    step = torch.randn(batch, n_kv, 1, HD, dtype=torch.float16)\n    cache.update(step, step.clone(), layer_idx=0)                 # decode: fp16 residual\n    lay = cache.layers[0]\n    rec = lay._dequantize(lay._quantized_keys).float()\n    assert rec.shape == k.shape and torch.isfinite(rec).all()\n    return float((rec - k.float()).pow(2).mean().sqrt())\n\nHQQ = {}\nprint(f\"\\nworst real batch: {B} x {KVH} KV heads x {S_W} tokens x {HD}\")\nfor nbits, group in KNOB3:\n    lab = KV.label(nbits, q_group_size=group)\n    (e0, c0), (e1, c1) = [(rmse_through_cache(lcfg, nbits, group, B, s, KVH),\n                           KV.channels_per_group(B, s, group, KVH, HD)) for s in (S_W, S_W + 1)]\n    HQQ[lab] = {\"rmse\": [round(e0, 5), round(e1, 5)], \"chan_per_group\": [c0, c1],\n                \"eff_bits\": KV.effective_bits(nbits, group)}\n    print(f\"{lab:<20} eff {KV.effective_bits(nbits, group):.2f} b | RMSE {e0:.4f} / {e1:.4f} \"\n          f\"(padded {S_W} / {S_W + 1}) | chan/grp {c0} / {c1}\")\n    assert c0 == c1 == 1 and abs(e0 - e1) / e0 < 0.05\n\n# (c) Qwen geometry, final 8-row batch, G=32: odd padded length -> 2 chan/grp.\nq_even, q_odd = (rmse_through_cache(qcfg, 4, 32, 8, s, 2) for s in (744, 745))\nprint(f\"\\ncontrol qwen b8 G32 n4: RMSE even {q_even:.4f} / odd {q_odd:.4f}  chan/grp \"\n      f\"{KV.channels_per_group(8, 744, 32, 2, HD)} / {KV.channels_per_group(8, 745, 32, 2, HD)}\")\nassert q_odd > 1.1 * q_even, \"misalignment control did not show — the parity test is uninformative\"\nAUDIT[\"knob3\"] = {\"alignment\": ALIGN, \"hqq_llama\": HQQ, \"control_qwen_b8_g32\": [q_even, q_odd]}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-21T22:42:19.846906Z","iopub.execute_input":"2026-09-21T22:42:19.847265Z","iopub.status.idle":"2026-09-21T22:48:45.75318Z","shell.execute_reply.started":"2026-09-21T22:42:19.847237Z","shell.execute_reply":"2026