            for e, r, p in zip(dev, retr_dev, preds)]\n\nABSTAIN_LIKE = re.compile(\n    r\"\\b(not (mentioned|provided|stated|specified|given)|no information|cannot|\"\n    r\"can't|unable to|does not (say|mention|specify)|unknown)\\b\", re.I)\n\ndef fmt(preds):\n    w = np.array([len(p.split()) for p in preds])\n    low = [p.strip().lower() for p in preds]\n    frac = lambda xs: round(float(np.mean(xs)), 3)\n    return {\"words_mean\": round(float(w.mean()), 2),\n            \"words_p90\": float(np.percentile(w, 90)),\n            \"gt5_words\": frac(w > 5),\n            \"empty\": int(sum(not p.strip() for p in preds)),\n            \"answer_prefix\": frac([l.startswith((\"answer:\", \"the answer\", \"answer is\"))\n                                   for l in low]),\n            \"ends_period\": frac([p.rstrip().endswith(\".\") for p in preds]),\n            \"multiline\": frac([\"\\n\" in p for p in preds]),\n            \"abstain_listed\": frac([Q.normalize_answer(p) in Q._ABSTAIN for p in preds]),\n            \"abstain_like\": frac([bool(ABSTAIN_LIKE.search(p)) for p in preds])}\n\nqwen_base = R.load_results(\"results/baseline_1k_results.csv\", setting=\"baseline\")\nF_SHORT = {\"llama_dev200\": fmt(DEV_SHORT), \"qwen_frozen1000\": fmt(list(qwen_base.prediction))}\nfor k, v in F_SHORT.items():\n    print(f\"{k:<16} {v}\")\nagg = Q.aggregate(dev_rows(DEV_SHORT), k=TOP_K)\nprint(f\"\\nllama dev-200 short: EM {agg['em']:.3f}  F1 {agg['f1']:.3f}  \"\n      f\"em_complete {agg['em_complete']:.3f}  em_incomplete {agg['em_incomplete']:.3f}\")\n\nlong_ = [p for p in DEV_SHORT if len(p.split()) > 3]\nprint(f\"\\nmost common openings of the {len(long_)} predictions > 3 words:\")\nfor k, v in Counter(\" \".join(p.split()[:2]) for p in long_).most_common(8):\n    print(f\"  {v:>3}  {k!r}\")\n\nrng = random.Random(42)\nprint(\"\\n20 random dev predictions (EM, pred | gold):\")\nfor i in sorted(rng.sample(range(200), 20)):\n    print(f\"  {int(Q.exact_match(DEV_SHORT[i], d