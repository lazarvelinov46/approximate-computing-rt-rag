rrect.\"\"\"\n    assert set(A) == set(B), f\"{label}: qid sets differ\"\n    b = sum(1 for q in A if A[q] == 1 and B[q] == 0)\n    c = sum(1 for q in A if A[q] == 0 and B[q] == 1)\n    d = b + c\n    p = binomtest(b, d, 0.5).pvalue if d else 1.0\n    v = verdict(b, c, p)\n    print(f\"{label:<48} b={b:>3} c={c:>3} d={d:>4} p={p:.4f}  {v}\")\n    return {\"b\": b, \"c\": c, \"discordant\": d, \"p\": round(float(p), 4),\n            \"verdict\": v, \"metric\": key}\n\nEM = {tag: em_map(DF[tag]) for tag, _, _ in EXPECTED}\nBASE_EM = em_map(be)\n\nMC = {}\nprint(\"--- GATE: is the batch-1 explain reference equivalent to frozen? ---\")\nMC[\"ref_vs_frozen\"] = mcnemar(BASE_EM, EM[REF],\n                              \"frozen baseline_explain vs evict_none_b1\")\nprint(\"  30/1000 predictions differ vs 2/1000 in short mode.\")\nprint(\"  A SIGNIFICANT result here does not invalidate the arm — every\")\nprint(\"  eviction setting is compared to evict_none_b1, the matched\")\nprint(\"  condition — but it must be reported, not assumed away.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-12T22:44:42.406614Z","iopub.execute_input":"2026-09-12T22:44:42.406939Z","iopub.status.idle":"2026-09-12T22:44:43.386505Z","shell.execute_reply.started":"2026-09-12T22:44:42.406883Z","shell.execute_reply":"2026-09-12T22:44:43.385959Z"}},"outputs":[{"name":"stdout","text":"--- GATE: is the batch-1 explain reference equivalent to frozen? ---\nfrozen baseline_explain vs evict_none_b1         b=  4 c=  8 d=  12 p=0.3877  UNINFORMATIVE (d=12 < 30)\n  30/1000 predictions differ vs 2/1000 in short mode.\n  A SIGNIFICANT result here does not invalidate the arm — every\n  eviction setting is compared to evict_none_b1, the matched\n  condition — but it must be reported, not assumed away.\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"# notebooks/31_ac_knob4_explain_closeout — CELL 6\n# Paired tests on EM and, separately, on parsed_ok. EM alone 