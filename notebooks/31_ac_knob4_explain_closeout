:1},{"cell_type":"code","source":"# notebooks/31_ac_knob4_explain_closeout — CELL 2\n# INTEGRITY CHECK before any analysis. Several explain runs spanned sessions\n# and some were terminated early, so the console output is incomplete. The CSV\n# is the source of truth; this cell verifies it is complete and uncontaminated.\nimport pandas as pd\nimport numpy as np\nfrom src.config import load_config\nimport src.pipeline.rag as R\nimport src.metrics.quality as Q\nfrom src.generator import eviction as EV\n\nCFG = load_config()\nTOP_K = CFG[\"retrieval\"][\"top_k\"]\nCAP = CFG[\"generation\"][\"max_new_tokens_explain\"]\nOUT = \"results/knob4_explain_results.csv\"\nBASE_EXPLAIN = \"results/baseline_explain_1k_results.csv\"\nREF = \"evict_none_b1\"\n\nEXPECTED = [\n    (REF,                     \"none\",        1.00),\n    (\"evict_recency_r025\",    \"recency\",     0.25),\n    (\"evict_sink4_r025\",      \"sink_recent\", 0.25),\n    (\"evict_random_r025_s42\", \"random\",      0.25),\n    (\"evict_attn_r025\",       \"attention\",   0.25),\n    (\"evict_recency_r050\",    \"recency\",     0.50),\n    (\"evict_sink4_r050\",      \"sink_recent\", 0.50),\n    (\"evict_random_r050_s42\", \"random\",      0.50),\n    (\"evict_attn_r050\",       \"attention\",   0.50),\n]\n\nraw = pd.read_csv(OUT, keep_default_na=False, dtype=str)\nprint(f\"{OUT}: {len(raw)} rows, {raw['setting'].nunique()} settings\")\nprint(f\"modes present: {sorted(raw['mode'].unique())}\")\nassert set(raw[\"mode\"].unique()) == {\"explain\"}, \\\n    \"short-mode rows in the explain CSV — resume keys on `setting` alone\"\n\nfound = set(raw[\"setting\"].unique())\nwant = {t for t, _, _ in EXPECTED}\nprint(f\"\\nmissing settings: {sorted(want - found) or 'none'}\")\nprint(f\"unexpected settings: {sorted(found - want) or 'none'}\")\n\n# --- per-setting completeness --------------------------------------------\n# A session killed mid-run then resumed can leave DUPLICATE qids: the flush\n# writes rows, the next