n(tag)\n    bad = sum(QRET[ret_key][q] != v for q, v in zip(df.qid, df.retrieved_ids))\n    assert bad == 0, f\"{tag}: retrieved_ids differ from Qwen on {bad} questions\"\n    rec = {}\n    if batch1:\n        base = load_run(\"baseline\")\n        plen = dict(zip(base.qid, base.prompt_tokens))\n        pred = dict(zip(base.qid, base.prediction))\n        bad = sum(plen[q] != v for q, v in zip(df.qid, df.prompt_tokens))\n        assert bad == 0, f\"{tag}: prompt_tokens differ from Llama baseline on {bad} questions\"\n        rec[\"identity_vs_baseline\"] = round(float(np.mean(\n            [pred[q] == p for q, p in zip(df.qid, df.prediction)])), 4)\n    agg = Q.aggregate(df.to_dict(\"records\"), k=TOP_K)\n    rec.update({k: agg[k] for k in (\"em\", \"f1\", f\"recall@{TOP_K}\", \"complete_frac\",\n                                    \"em_complete\", \"em_incomplete\", \"em_bridge\",\n                                    \"em_comparison\", \"abstain_rate\")})\n    rec[\"gap\"] = round(agg[\"em_complete\"] - agg[\"em_incomplete\"], 4)\n    rec[\"bare_cite\"] = round(float(np.mean([is_bare(p) for p in df.prediction])), 4)\n    rec[\"decode_mean\"] = round(float(df.decode_tokens.mean()), 2)\n    print(f\"{tag}: \" + \"  \".join(f\"{k} {v}\" for k, v in rec.items()))\n    return rec\n\ndef em_hits(df):\n    return {q: Q.exact_match(p, g) for q, p, g in zip(df.qid, df.prediction, df.gold_answer)}\n\ndef mcnemar(ref_tag, set_tag):\n    A, S = em_hits(load_run(ref_tag)), em_hits(load_run(set_tag))\n    b = sum(1 for q in A if S[q] == 1 and A[q] == 0)     # setting-only correct\n    c = sum(1 for q in A if A[q] == 1 and S[q] == 0)     # reference-only correct\n    p = binomtest(b, b + c, 0.5).pvalue if b + c else 1.0\n    v = verdict(b, c, p)\n    print(f\"  {ref_tag} vs {set_tag}: b={b} c={c} d={b + c} p={p:.4f}  {v}\")\n    return {\"b\": b, \"c\": c, \"d\": b + c, \"p\": round(float(p), 4), \"verdict\": v}\n\nrun = dict(embedder=embedder, generator=gen, gen_tok=tok, mode=\"