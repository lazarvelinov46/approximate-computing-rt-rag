:\n        print(f\"  [{i}] sdpa : {a[i][:70]}\")\n        print(f\"      eager: {b[i][:70]}\")\n\ngen.set_attn_implementation(\"sdpa\")\n\n# The batch axis, measured on the same slice, so the two deviations knob 4\n# would take are separated rather than confounded.\na16, _, _ = results[BATCH]\na1,  _, _ = results[1]\ndbatch = [i for i, (x, y) in enumerate(zip(a16, a1)) if x != y]\nprint(f\"\\nsdpa batch {BATCH} vs batch 1: {len(dbatch)} / {len(prompts)} differ \"\n      f\"[knob 5 measured batch 8 vs 16 at 0/1000 discordant EM]\")\n\nprint(f\"\\n-> eager confound exists: {len(results[BATCH][2]) > 0}\")\nprint(f\"-> batch-1 deviation visible: {len(dbatch) > 0}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T13:13:26.967927Z","iopub.execute_input":"2026-09-07T13:13:26.968555Z","iopub.status.idle":"2026-09-07T13:14:35.44971Z","shell.execute_reply.started":"2026-09-07T13:13:26.968525Z","shell.execute_reply":"2026-09-07T13:14:35.448869Z"}},"outputs":[{"name":"stderr","text":"/tmp/ipykernel_58/3319742068.py:23: UserWarning: Memory efficient kernel not used because: (Triggered internally at /pytorch/aten/src/ATen/native/transformers/cuda/sdp_utils.cpp:960.)\n  torch.nn.functional.scaled_dot_product_attention(q, k, v, is_causal=True)\n/tmp/ipykernel_58/3319742068.py:23: UserWarning: Memory Efficient attention has been runtime disabled. (Triggered internally at /pytorch/aten/src/ATen/native/transformers/sdp_utils_cpp.h:552.)\n  torch.nn.functional.scaled_dot_product_attention(q, k, v, is_causal=True)\n/tmp/ipykernel_58/3319742068.py:23: UserWarning: Flash attention kernel not used because: (Triggered internally at /pytorch/aten/src/ATen/native/transformers/cuda/sdp_utils.cpp:962.)\n  torch.nn.functional.scaled_dot_product_attention(q, k, v, is_causal=True)\n/tmp/ipykernel_58/3319742068.py:23: UserWarning: Flash attention only supports gpu architectures in the range [sm80, sm121]. Attempting to run on a sm 7.5 gpu. (Triggered internally at /pytorc