0 and hasattr(obj, \"__dict__\"):\n        total = sum(tensor_bytes(v, seen) for v in vars(obj).values())\n    return total\n\nfp16_ref = B * KVH * PROMPT * HD * 2 * 2      # K and V, fp16, one layer\nprint(f\"\\n=== (b) measured bytes, one layer, {B}x{PROMPT} tokens ===\")\nprint(f\"fp16 reference: {fp16_ref/2**20:.2f} MiB\")\nprint(f\"{'backend':7s} {'nbits':>5} {'MiB':>9} {'ratio':>7} {'eff bits':>9}\")\nfor backend, bits in ((\"hqq\", 8), (\"hqq\", 4), (\"hqq\", 3), (\"hqq\", 2),\n                      (\"quanto\", 4), (\"quanto\", 2)):\n    r = run(backend, bits, 512, 0)\n    lay = r[\"layer\"]\n    got = tensor_bytes(lay._quantized_keys) + tensor_bytes(lay._quantized_values)\n    if got == 0:\n        print(f\"{backend:7s} {bits:>5}   MEASUREMENT FAILED — inspect \"\n              f\"{type(lay._quantized_keys).__name__} manually\")\n        continue\n    eff = got * 8 / (B * KVH * PROMPT * HD * 2)\n    print(f\"{backend:7s} {bits:>5} {got/2**20:>9.2f} {fp16_ref/got:>7.2f}x {eff:>9.2f}\")\n\nprint(\"\\nEffective bits above nominal = scale/zero metadata. This measured column,\")\nprint(\"not the nominal nbits, is the compression axis for the Phase 4 Pareto plot.\")\n\n# --- (c) the cache_config mutation ---------------------------------------\nprint(\"\\n=== (c) cache_config reuse ===\")\nshared = {\"backend\": \"hqq\", \"nbits\": 4, \"residual_length\": 512}\nprint(\"before:\", shared)\n_ = shared.pop(\"backend\", \"quanto\")      # exactly what generate() does\nshared[\"config\"] = \"<model config injected>\"\nprint(\"after :\", shared)\nprint(\"-> 'backend' is gone. A second generate() call with this same dict would\")\nprint(\"   silently fall back to quanto. make_cache must return a FRESH dict.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/09_ac_knob3_env_audit — CELL 7\n# (i)   fixed byte accounting that sees through quanto's tensor subclass\n# (ii)  does axis change the footprint? (it should