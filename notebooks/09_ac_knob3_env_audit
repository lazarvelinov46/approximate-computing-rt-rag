`2`, `4`] but got 8\nquanto       8  128        -  FAIL ValueError: `nbits` for `quanto` backend has to be one of [`2`, `4`] but got 8\nhqq          1    0  float16  OK  seq=201 quantized=True residual=1\nhqq          1  128  float16  OK  seq=201 quantized=True residual=1\nhqq          2    0  float16  OK  seq=201 quantized=True residual=1\nhqq          2  128  float16  OK  seq=201 quantized=True residual=1\nhqq          3    0  float16  OK  seq=201 quantized=True residual=1\nhqq          3  128  float16  OK  seq=201 quantized=True residual=1\nhqq          4    0  float16  OK  seq=201 quantized=True residual=1\nhqq          4  128  float16  OK  seq=201 quantized=True residual=1\nhqq          8    0  float16  OK  seq=201 quantized=True residual=1\nhqq          8  128  float16  OK  seq=201 quantized=True residual=1\n\nquanto usable nbits @ residual_length=0   : [2, 4]\nquanto usable nbits @ residual_length=128 : [2, 4]\nhqq    usable nbits @ residual_length=0   : [1, 2, 3, 4, 8]\nhqq    usable nbits @ residual_length=128 : [1, 2, 3, 4, 8]\n\nWatch two columns, not just OK/FAIL:\n  quantized=False  -> constructed but never quantized: the setting is a no-op\n  residual @ res=0 -> must be 0 or None; anything else means fp16 leaked through\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# notebooks/09_ac_knob3_env_audit — CELL 5\n# Provenance artifact. Written to tolerate a kernel restart between cells:\n# missing cell-1 state is recorded as such rather than crashing, but a run\n# without the version pin is INCOMPLETE and cell 1 must be rerun.\n\nimport inspect, json, os, re\nimport transformers, transformers.cache_utils as CU\nfrom transformers import GenerationConfig\n\nG = globals()\ngc_ = GenerationConfig()\n\nATTN_HITS = []\nfor name in sorted(n for n in dir(CU) if re.search(r\"quant|dynamiccache\", n, re.I)):\n    obj = getattr(CU, name)\n    if not inspect.isclass(obj):\n        continue\n    try:\n        src = inspect.getsource(obj)\n    except (TypeError, OSError):\n        continue\n    for ln in src.splitlines():\n        if re.search(r\"attn_implementation|eager|sdpa|flash\", ln, re.I):\n            ATTN_HITS.append(f\"{name}: {ln.strip()}\")\n\nAUDIT = {\n    \"task\": \"P2-5a knob 3 environment audit\",\n    \"regime\": 1,\n    \"transformers_version\": transformers.__version__,\n    \"transformers_before_install\": G.get(\"TRANSFORMERS_BEFORE\", \"NOT CAPTURED — rerun cell 1\"),\n    \"versions_after_install\": G.get(\"VERSIONS\", \"NOT CAPTURED — rerun cell 1\"),\n    \"core_stack_drifted\": G.get(\"drift\", \"NOT CAPTURED — rerun cell 1\"),\n    \"api_shape\": (\"unified transformers.QuantizedCache(backend, config, nbits, \"\n                  \"axis_key, axis_value, q_group_size, residual_length); \"\n                  \"QuantizedCacheConfig / QuantoQuantizedCache / \"\n                  \"HQQQuantizedCache all ABSENT in this release\"),\n    \"library_defaults\": {\"nbits\": 4, \"axis_key\": 0, \"axis_value\": 0,\n                         \"q_group_size\": 64, \"residual_length\": 128},\n    \"quant_names_in_cache_utils\": sorted(n for n in dir(CU)\n                                         if re.search(r\"quant\", n, re.I)),\n    \"generation_config_surface\": {\n        \"has_cache_implementation\": hasattr(gc_, \"cache_implementation\"),\n        \"has_cache_config\": hasattr(gc_, \"cache_config\"),\n    },\n    \"legality_matrix\": G.get(\"LEGALITY\", \"NOT CAPTURED — rerun cell 4\"),\n    \"attention_implementation_hits\": ATTN_HITS,\n    \"open_on_gpu_day\": [\n        \"byte-identity of the bits=16 path vs results/baseline_1k_results.csv\",\n        \"wall-clock overhead factor of quantized decode vs fp16\",\n    ],\n}\n\nos.makedirs(\"results\", exist_ok=True)\nwith open(\"results/knob3_env_audit.json\", \"w\") as fh:\n    json.dump(AUDIT, fh, indent=2, default=str)\n\nincomplete = [k for k, v in AUDIT.items() if isinstance(v, str) and \"NOT CAPTURED\" in v]\nprint(\"wrote results/knob3_env_audit.json\")\nprint(\"transformers:\", AUDIT[\"transformers_version\"])\nif incomplete:\n    print(\"INCOMPLETE — rerun and refill:\", incomplete)\nprint(\"COMMIT AND PUSH BEFORE TERMINATING — /kaggle/working does not survive.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/09_ac_knob3_env_audit — CELL 6\n# Three questions cell 4 was too short or too narrow to answer:\n#   (a) flush behaviour over REALISTIC decode lengths, at batch 16\n#   (b) the ACTUAL byte cost of the quantized store — measured, not derived,\n#       the same discipline knob 2 used for bytes_per_vector\n#   (c) whether generate()'s cache_config mutation really breaks reuse\n\nimport torch\nfrom transformers import AutoConfig, QuantizedCache\n\nmcfg = AutoConfig.from_pretrained(\"Qwen/Qwen2.5-3B-Instruct\")\nKVH = mcfg.num_key_value_heads\nHD  = getattr(mcfg, \"head_dim\", None) or mcfg.hidden_size // mcfg.num_attention_heads\nB, PROMPT = 16, 744          # frozen batch size, measured mean prompt length\n\ndef run(backend, nbits, residual_length, decode_steps):\n    \"\"\"Prefill then decode_steps single-token updates on layer 0.\"\"\"\n    cache = QuantizedCache(backend=backend, config=mcfg, nbits=nbits,\n                           axis_key=0, axis_value=0, q_group_size=64,\n                           residual_length=residual_length)\n    layer = cache.layers[0]\n\n    flushes = {\"n\": 0}\n    raw_quantize = layer._quantize\n    def counting_quantize(tensor, axis):\n        flushes[\"n\"] += 1\n        return raw_quantize(tensor, axis)\n    layer._quantize = counting_quantize\n\n    k = torch.randn(B, KVH, PROMPT, HD, dtype=torch.float16)\n    cache.update(k, torch.randn_like(k), layer_idx=0)\n    prefill_quantize_calls = flushes[\"n\"]           # expect 2: keys + values\n\n    for _ in range(decode_steps):\n        k1 = torch.randn(B, KVH, 1, HD, dtype=torch.float16)\n        cache.update(k1, torch.randn_like(k1), 