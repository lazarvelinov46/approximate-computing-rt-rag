tion_config.cache_implementation in [\"static\", \"hybrid\", \"sliding_window\"] or (\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# notebooks/09_ac_knob3_env_audit — CELL 4\n# Functional legality matrix against the REAL API. Construction alone may not\n# validate nbits (the layer is built lazily), so each combination is exercised\n# with a prefill-then-decode update, which is the path a sweep actually takes.\n#\n# Deliberately mirrors the knob-2 discipline: a setting that constructs but\n# silently fails to quantize is the KV analogue of \"pq vs exact identical\n# rate = 1.0\". So we assert the quantized store is populated, not just that\n# no exception was raised.\n\nimport itertools, torch\nfrom transformers import AutoConfig, QuantizedCache\n\nMODEL = \"Qwen/Qwen2.5-3B-Instruct\"\nmcfg = AutoConfig.from_pretrained(MODEL)          # config.json only, no weights\nHEAD_DIM = getattr(mcfg, \"head_dim\", None) or mcfg.hidden_size // mcfg.num_attention_heads\nprint(f\"{MODEL}: {mcfg.num_hidden_layers}L, {mcfg.num_key_value_heads} kv-heads, \"\n      f\"head_dim {HEAD_DIM}\")\n\nPREFILL, DECODE = 200, 1     # 200 > residual_length=128, so the flush is exercised\n\ndef exercise(backend, nbits, residual_length, dtype):\n    \"\"\"-> dict describing what happened.\"\"\"\n    rec = {\"ok\": False, \"dtype\": str(dtype), \"error\": None,\n           \"quantized_populated\": None, \"residual_len_after\": None}\n    try:\n        cache = QuantizedCache(backend=backend, config=mcfg, nbits=nbits,\n                               axis_key=0, axis_value=0, q_group_size=64,\n                               residual_length=residual_length)\n        shape = (1, mcfg.num_key_value_heads, PREFILL, HEAD_DIM)\n        k = torch.randn(*shape, dtype=dtype)\n        v = torch.randn(*shape, dtype=dtype)\n        cache.update(k, v, layer_idx=0)                       # prefill\n        k2 = torch.randn(1, mcfg.num_key_value_heads, DECODE, HEAD_DIM, dtype=dtype)\n        v2 = torch.randn_like(k2)\n        out_k, _ = cache.update(k2, v2, layer_idx=0)          # one decode step\n\n        layer = cache.layers[0] if getattr(cache, \"layers\", None) else None\n        qk = getattr(layer, \"_quantized_keys\", None) if layer else None\n        resid = getattr(layer, \"keys\", None) if layer else None\n\n        rec.update(\n            ok=True,\n            returned_seq_len=int(out_k.shape[-2]),\n            quantized_populated=qk is not None,\n            residual_len_after=(int(resid.shape[-2])\n                                if resid is not None and hasattr(resid, \"shape\")\n                                and resid.dim() == 4 else None),\n        )\n    except Exception as e:\n        rec[\"error\"] = f\"{type(e).__name__}: {e}\"\n    return rec\n\n\nLEGALITY = {}\nprint(\"\\n=== functional legality (CPU) ===\")\nprint(f\"{'backend':8s} {'nbits':>5} {'res':>4}  {'dtype':>7}  result\")\nfor backend, nbits, res in itertools.product((\"quanto\", \"hqq\"),\n                                             (1, 2, 3, 4, 8),\n                                             (0, 128)):\n    rec = None\n    for dtype in (torch.float16, torch.float32):   # fp16 on CPU is patchy\n        rec = exercise(backend, nbits, res, dtype)\n        if rec[\"ok\"]:\n            break\n    LEGALITY[f\"{backend}_nbits{nbits}_res{res}\"] = rec\n    if rec[\"ok\"]:\n        print(f\"{backend:8s} {nbits:>5} {res:>4}  {rec['dtype'][6:]:>7}  \"\n              f\"OK  seq={rec['returned_seq_len']} \"\n              f\"quantized={rec['quantized_populated']} \"\n              f\"residual={rec['residual_len_after']}\")\n    else:\n        print(f\"{backend:8s} {nbits:>5} {res:>4}  {'-':>7}  FAIL {rec['error'][:110]}\")\n\ndef usable(backend, res):\n    return sorted({int(k.split(\"nbits\")[1].split(\"_\")[0])\n                   for k, v in LEGALITY.items()\n                   if v[\"ok\"] and k.startswith(backend) and k.endswith(f\"res{res}\")})\n\nprint(f\"\\nqu