\"\"\n    cache = QuantizedCache(backend=backend, config=mcfg, nbits=nbits,\n                           axis_key=0, axis_value=0, q_group_size=64,\n                           residual_length=residual_length)\n    layer = cache.layers[0]\n\n    flushes = {\"n\": 0}\n    raw_quantize = layer._quantize\n    def counting_quantize(tensor, axis):\n        flushes[\"n\"] += 1\n        return raw_quantize(tensor, axis)\n    layer._quantize = counting_quantize\n\n    k = torch.randn(B, KVH, PROMPT, HD, dtype=torch.float16)\n    cache.update(k, torch.randn_like(k), layer_idx=0)\n    prefill_quantize_calls = flushes[\"n\"]           # expect 2: keys + values\n\n    for _ in range(decode_steps):\n        k1 = torch.randn(B, KVH, 1, HD, dtype=torch.float16)\n        cache.update(k1, torch.randn_like(k1), layer_idx=0)\n\n    resid = layer.keys\n    resid_len = int(resid.shape[-2]) if resid.dim() == 4 else 0\n    return {\n        \"quantize_calls_total\": flushes[\"n\"],\n        \"flushes_during_decode\": (flushes[\"n\"] - prefill_quantize_calls) // 2,\n        \"residual_len_final\": resid_len,\n        \"layer\": layer,\n    }\n\nprint(\"=== (a) flush behaviour at realistic decode lengths, batch 16 ===\")\nprint(f\"{'backend':7s} {'nbits':>5} {'res':>5} {'decode':>7} {'flushes':>8} {'resid':>6}\")\nfor backend, nbits in ((\"hqq\", 4), (\"quanto\", 4)):\n    for residual_length in (0, 128, 512):\n        for decode_steps in (4, 92, 224):       # short p50, explain p50, explain p99\n            r = run(backend, nbits, residual_length, decode_steps)\n            print(f\"{backend:7s} {nbits:>5} {residual_length:>5} {decode_steps:>7} \"\n                  f\"{r['flushes_during_decode']:>8} {r['residual_len_final']:>6}\")\n\nprint(\"\\nRead this as: residual_length=512 must show 0 flushes in EVERY row, and\")\nprint(\"residual_length=128 must show flushes at decode=224 but not at decode=92 —\")\nprint(\"that split is the per-question heterogeneity that rules the default out.\")\n\n# --- (b) measured bytes of the quantized store ---------------------------\ndef tensor_bytes(obj, seen=None):\n    \"\"\"Recursively total the storage of every tensor reachable from obj.\"\"\"\n    if seen is None:\n        seen = set()\n    if isinstance(obj, torch.Tensor):\n        if id(obj) in seen:\n            return 0\n        seen.add(id(obj))\n        return obj.numel() * obj.element_size()\n    if isinstance(obj, (tuple, list)):\n        return sum(tensor_bytes(o, seen) for o in obj)\n    if isinstance(obj, dict):\n        return sum(tensor_bytes(v, seen) for v in obj.values())\n    total = 0\n    for attr in (\"_data\", \"_scale\", \"_zeropoint\", \"_shift\", \"_qtype\"):\n        if hasattr(obj, attr):\n            total += tensor_bytes(getattr(obj, attr), seen)\n    if total == 0 and hasattr(obj, \"__dict__\"):\n        total = sum(tensor_bytes(v, seen) for v in vars(obj).values())\n    return total\n\nfp16_ref = B * KVH * PROMPT * HD * 2 * 2      # K and V, fp16, one layer\nprint(f\"\\n=== (b) measured bytes, one layer, {B}x{PROMPT} tokens ===\")\nprint(f\"fp16 reference: {fp16_ref/2**20:.2f} MiB\")\nprint(f\"{'backend':7s} {'nbits':>5} {'MiB':>9} {'ratio':>7} {'eff bits':>9}\")\nfor backend, bits in ((\"hqq\", 8), (\"hqq\", 4), (\"hqq\", 3), (\"hqq\", 2),\n                      (\"quanto\", 4), (\"quanto\", 2)):\n    r = run(backend, bits, 512, 0)\n    lay = r[\"layer\"]\n    got = tensor_bytes(lay._quantized_keys) + tensor_bytes(lay._quantized_values)\n    if got == 0:\n        print(f\"{backend:7s} {bits:>5}   MEASUREMENT FAILED — inspect \"\n              f\"{type(lay._quantized_keys).__name__} manually\")\n        continue\n    eff = got * 8 / (B * KVH * PROMPT * HD * 2)\n    print(f\"{backend:7s} {bits:>5} {got/2**20:>9.2f} {fp16_ref/got:>7.2f}x {eff:>9.2f}\")\n\nprint(\"\\nEffective bits above nominal = scale/zero metadata. This measured column,\")\nprint(\"not the nominal nbits, is the compression axis for the Phase 4 Pareto plot.\")\n\n# --- (c) the cache_config mutation ---------------------------------------\nprint(\"\\n=== (c) cache_config reuse ===\")\nshared = {\"backend\": \"hqq\", \"nbits\": 4, \"residual_length\": 512}\nprint(\"before:\", shared)\n_ = shared.pop(\"backend\", \"quanto\")      # exactly what generate() does\nshared[\"config\"] = \"<model config injected>\"\nprint(\"after :\", shared)\nprint(\"-> 'backend' is gone. A second generate() call with this same dict would\")\nprint(\"   silently fall back to quanto. make_cache must return a FRESH dict.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-02T22:06:54.332496Z","iopub.execute_input":"2026-09-02T22:06:54.333046Z","iopub.status.idle":"2026-09-02T22:16:36.47259Z","shell.execute_reply.started":"2026-09-02T22:06:54.333007Z","shell.execute_reply":"2026-09-02T22:16:36.470889Z"}},"outputs":[{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\nWARNING:huggingface_hub.utils._http:Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n","output_type":"stream"},{"name":"stdout","text":"=== (a) flush behaviour at realistic decode lengths, batch 16 ===\nbackend nbits   res  decode  flushes  resid\nhqq         4     0       4        2      0\nhqq         4     0      92       46      0\nhqq         4     0     224      112      0\nhqq         4   128       4        0      4\nhqq         4   128      92        0     92\nhqq         4   128     224        1     96\nhqq         4   512       4        0      4\nhqq         4   512      92        0     92\nhqq         4   512     224        0    224\nquanto      4     0       4        2      0\nquanto      4     0      92       46      0\nquanto      4     0     224      112      0\nquanto      4   128       4        0      4\nquanto      4   128      92        0     92\nquanto      