nmcfg = AutoConfig.from_pretrained(\"Qwen/Qwen2.5-3B-Instruct\")\nKVH = mcfg.num_key_value_heads\nHD  = getattr(mcfg, \"head_dim\", None) or mcfg.hidden_size // mcfg.num_attention_heads\n\ndef tensor_bytes(obj, seen=None):\n    \"\"\"Total real storage. Tensor SUBCLASSES must be unpacked before the plain\n    isinstance branch: quanto's quantized tensor reports numel/element_size of\n    the logical fp16 view, which is what produced the bogus 1.00x last cell.\"\"\"\n    if seen is None:\n        seen = set()\n    if id(obj) in seen:\n        return 0\n    if hasattr(obj, \"__tensor_flatten__\"):\n        seen.add(id(obj))\n        try:\n            names = obj.__tensor_flatten__()[0]\n            return sum(tensor_bytes(getattr(obj, n), seen) for n in names)\n        except Exception:\n            pass\n    if isinstance(obj, torch.Tensor):\n        if type(obj) is not torch.Tensor:\n            inner = [getattr(obj, a) for a in\n                     (\"_data\", \"_scale\", \"_zeropoint\", \"_shift\", \"_qtype\")\n                     if hasattr(obj, a)]\n            if inner:\n                seen.add(id(obj))\n                return sum(tensor_bytes(t, seen) for t in inner)\n        seen.add(id(obj))\n        return obj.numel() * obj.element_size()\n    if isinstance(obj, (tuple, list)):\n        return sum(tensor_bytes(o, seen) for o in obj)\n    if isinstance(obj, dict):\n        return sum(tensor_bytes(v, seen) for v in obj.values())\n    if hasattr(obj, \"__dict__\"):\n        return sum(tensor_bytes(v, seen) for v in vars(obj).values())\n    return 0\n\n\ndef quantize_once(backend, nbits, axis, tensor):\n    \"\"\"Push one tensor through the real update path -> (layer, dequantized).\"\"\"\n    cache = QuantizedCache(backend=backend, config=mcfg, nbits=nbits,\n                           axis_key=axis, axis_value=axis,\n                           q_group_size=64, residual_length=512)\n    cache.update(tensor, tensor.clone(), layer_idx=0)\n    lay = cache.layers[0]\n    return lay, lay._dequantize(lay._quantized_keys)\n\n\nB, S = 1, 256\nplain = torch.randn(B, KVH, S, HD, dtype=torch.float16)\nspiky = plain.clone()\nspiky[..., [7, 31, 64, 99]] *= 20.0        # planted outlier channels\n\nprint(\"stored type per backend:\")\nfor backend, nbits, axis in ((\"hqq\", 4, 0), (\"quanto\", 4, 0)):\n    lay, _ = quantize_once(backend, nbits, axis, plain)\n    print(f\"  {backend:7s} -> {type(lay._quantized_keys).__name__}\")\n\nfp16_ref = B * KVH * S * HD * 2\nprint(f\"\\n=== (i)+(ii) measured footprint, keys only, fp16 ref {fp16_ref/2**20:.3f} MiB ===\")\nprint(f\"{'backend':7s} {'nbits':>5} {'axis':>5} {'MiB':>8} {'ratio':>7} {'eff bits':>9}\")\nBYTES = {}\nfor backend, allowed_axes in ((\"hqq\", (0, 1)), (\"quanto\", (0, -1))):\n    bits_list = (8, 4, 3, 2) if backend == \"hqq\" else (4, 2)\n    for nbits in bits_list:\n        for axis in allowed_axes:\n            try:\n                lay, _ = quantize_once(backend, nbits, axis, plain)\n                got = tensor_bytes(lay._quantized_keys)\n                eff = got * 8 / (B * KVH * S * HD)\n                BYTES[(backend, nbits, axis)] = got\n                print(f\"{backend:7s} {nbits:>5} {axis:>5} {got/2**20:>8.3f} \"\n                      f\"{fp16_ref/got:>7.2f}x {eff:>9.2f}\")\n            except Exception as e:\n                print(f\"{backend:7s} {nbits:>5} {axis:>5}  FAIL {type(e).__name__}: {e}\")\n\nprint(\"\\n=== (iii) reconstruction RMSE, plain vs planted outlier channels ===\")\nprint(f\"{'backend':7s} {'nbits':>5} {'axis':>5} {'RMSE plain':>12} {'RMSE spiky':>12}\")\nfor backend, allowed_axes in ((\"hqq\", (0, 1)), (\"quanto\", (0, -1))):\n    bits_list = (4, 2) if backend == \"hqq\" else (4, 2)\n    for nbits in bits_list:\n        for axis in allowed_axes:\n            try:\n                errs = []\n                for t in (plain, spiky):\n                    _, rec = quantize_once(backend, nbits, axis, t)\n                    errs.append(float((rec.float() - t.float()).pow(2).mean().sqrt()))\n                print(f\"{backend:7s} {nbits:>5} {axis:>5} {errs[0]:>12.5f} {errs[1]:>12.5f}\")\n            except Exception as e:\n                print(f\"{backend:7s} {nbits:>5} {axis:>5}  FAIL {type(e).__name__}: {e}\")\n\nprint(\"\\nReading this: footprint should NOT vary with axis (group count is fixed),\")\nprint(\"so axis is a pure error/quality choice. If hqq axis=1 beats axis=0 on the\")\nprint(\"spiky column, HF's recommendation is reproduced and axis=1 gets frozen for\")\nprint(\"hqq — overriding the library default, which we would otherwise have\")\nprint(\"inherited silently.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-02T22:45:04.777802Z","iopub.execute_input":"2026-09-02T22:45:04.781101Z","iopub.status.idle":"2026-09-02T22:45:05.754362Z","shell.execute_reply.started":"2026-09-02T22:45:04.780991Z","shell.execute_reply":"2026-09-02T22:45:05.752604Z"}},"outputs":[{"name":"stdout","text":"stored type per backend:\n  hqq     -> tuple\n  quanto  -> WeightQBitsTensor\n\n=== (i)+(ii) measured footprint, keys only, fp16 ref 0.125 MiB ===\nbackend nbits  axis      MiB   ratio  eff bits\nhqq         8     0    0.066    1.88x      8.50\nhqq         8     1    0.066    1.88x      8.50\nhqq         4     0    0.035    3.56x      4.50\nhqq         4     1    0.035    3.56x      4.50\nhqq         3     0    0.031    4.00x      4.00\nhqq         3     1  FAIL RuntimeError: The size of tensor a (0) must match the size of tensor b (1024) at non-singleton dimension 0\nhqq         2     0    0.020    6.40x      2.50\nhqq         2     1    0.020    6.40x      2.50\nquanto      4     0    0.035    3.56x      4.50\nquanto      4    -1    0.035    3.56x      4.50\nquanto      2     0    0.020    6.40x      2.50\nquanto      2    -1    0.020    6.40x      2.50\n\n=== (iii) reconstruction RMSE, plain vs planted outlier channels ===\nbackend nbits  axis   RMSE plain   RMSE spiky\nhqq         4     0     