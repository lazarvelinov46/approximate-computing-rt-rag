   pass\n\ndef find(name):\n    for modname in MODULES:\n        try:\n            obj = getattr(importlib.import_module(modname), name, None)\n        except Exception:\n            continue\n        if obj is not None:\n            return obj, modname\n    return None, None\n\nFOUND = {}\nprint(\"=== class discovery ===\")\nfor name in CANDIDATES:\n    obj, where = find(name)\n    if obj is None:\n        print(f\"  {name:32s} ABSENT\")\n        continue\n    FOUND[name] = obj\n    print(f\"  {name:32s} in {where}\")\n    try:\n        params = inspect.signature(obj.__init__).parameters\n        for p in params.values():\n            if p.name in (\"self\", \"args\", \"kwargs\"):\n                continue\n            d = (repr(p.default) if p.default is not inspect.Parameter.empty\n                 else \"REQUIRED\")\n            print(f\"      {p.name:20s} = {d}\")\n    except (TypeError, ValueError):\n        print(\"      <signature unavailable>\")\n\n# The parameters that silently become experimental setup. Read the validation\n# rules and defaults out of the source rather than recalling them.\nKEYS = re.compile(r\"nbits|residual_length|q_group_size|axis_key|axis_value|\"\n                  r\"backend|compute_dtype\", re.I)\n\nprint(\"\\n=== source lines touching the free parameters ===\")\nfor name, obj in FOUND.items():\n    try:\n        src_file, src = inspect.getsourcefile(obj), inspect.getsource(obj)\n    except (TypeError, OSError):\n        continue\n    hits = [ln.strip() for ln in src.splitlines() if KEYS.search(ln)]\n    if not hits:\n        continue\n    print(f\"\\n--- {name}  ({src_file}) ---\")\n    for ln in hits[:40]:\n        print(\"   \", ln)\n    if len(hits) > 40:\n        print(f\"    ... {len(hits) - 40} more\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/09_ac_knob3_env_audit — CELL 3\n# Read the implementation before touching it. Three questions:\n#   1. which backend-specific layer classes exist, and what nbits do they allow\n#   2. what axis=0 actually quantizes over (the docstring claims per-channel)\n#   3. how generate() wires cache_implementation / cache_config to QuantizedCache\n\nimport inspect, re\nimport transformers.cache_utils as CU\n\nQUANT_NAMES = sorted(n for n in dir(CU) if re.search(r\"quant\", n, re.I))\nprint(\"=== quantization-related names in transformers.cache_utils ===\")\nprint(\" \", QUANT_NAMES)\n\ndef dump(obj, label, limit=90):\n    try:\n        src = inspect.getsource(obj)\n    except (TypeError, OSError) as e:\n        print(f\"\\n--- {label}: source unavailable ({e}) ---\")\n        return\n    lines = src.splitlines()\n    print(f\"\\n--- {label}  ({len(lines)} lines) ---\")\n    for ln in lines[:limit]:\n        print(\"   \", ln)\n    if len(lines) > limit:\n        print(f\"    ... {len(lines) - limit} more\")\n\n# The backend dispatch: which layer class each backend string maps to.\ndump(CU.QuantizedCache.__init__, \"QuantizedCache.__init__\")\n\n# Every quantization class in the module. The backend-specific ones carry the\n# nbits validation and the _quantize implementation that defines what axis\n# means, which is the parameter I described wrongly a moment ago.\nfor name in QUANT_NAMES:\n    obj = getattr(CU, name)\n    if inspect.isclass(obj):\n        dump(obj, name)\n\nprint(\"\\n=== generate() wiring ===\")\nimport transformers.generation.utils as GU\ntry:\n    gsrc = inspect.getsource(GU).splitlines()\nexcept OSError:\n    gsrc = []\nhits = [ln.strip() for ln in gsrc\n        if re.search(r\"cache_implementation|cache_config|QuantizedCache|\"\n                     r\"\\\"quantized\\\"|'quantized'\", ln)]\nfor ln in hits[:60]:\n    print(\"   \", ln)\nif len(hits) > 60:\n    print(f\"    ... {len(hits) - 60} more\")\nif not hits:\n    print(\"   nothing in generation.utils — check transformers.generation.configuration_utils\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# notebooks/09_ac_knob3_env_audit — CELL 4\n# Functional legality matrix against the REAL API. Construction alone may not\n# validate nbits (the layer is built lazily), so each combination is exercised\n# with a prefill-then-decode update, which is the path a sweep actually takes.\n#\n# Deliberately mirrors the knob-2 discipline: a setting that constructs but\n# silently fails to quantize is the KV analogue of \"pq vs exact identical\n# rate = 1.0\". So we assert the quantized store is populated, not just that\n# no exception was raised.\n\nimport itertools, torch\nfrom transformers import AutoConfig, QuantizedCache\n\nMODEL = \"Qwen/Qwen2.5-3B-Instruct\"\nmcfg = AutoConfig.from_pretrained(MODEL)          # config.json only, no weights\nHEAD_DIM = getattr(mcfg, \"head_dim\", None) or mcfg.hidden_size // mcfg.num_attention_heads\nprint(f\"{MODEL}: {mcfg.num_hidden_layers}L, {mcfg.num_key_value_heads} kv-heads, \"\n      f\"head_dim {HEAD_DIM}\")\n\nPREFILL, DECODE = 200, 1     # 200 > residual_length=128, so the flush is exercised\n\ndef exercise(backend, nbits, residual_length, dtype):\n    \"\"\"-> dict describing what happened.\"\"\"\n    rec = {\"ok\": False, \"dtype\": str(dtype), \"error\": None,\n           \"quantized_populated\": None, \"residual_len_after\": None}\n    try:\n        cache = QuantizedCache(backend=backend, config=mcfg, nbits=nbits,\n                               axis_key=0, axis_value=0, q_group_size=64,\n                               residual_length=residual_length)\n        shape = (1, mcfg.num_key_value_heads, PREFILL, HEAD_DIM)\n        k = torch.randn(*shape, dtype=dtype)\n        v = torch.randn(*shape, dtype=dtype)\n        cache.update(k, v, layer_idx=0)                       # prefill\n        k2 = torch.randn(1, mcfg.num_key_value_heads, DECODE, HEAD_DIM, dtype=dtype)\n        v2 = torch.randn_like(k2)\n        out_k, _ = cache.update(k2, v2, layer_idx=0)          # one decode step\n\n        layer = cache.layers[0] if getattr(cache, \"layers\", None) else None\n        qk = getattr(layer, \"_quantized_keys\", None) if layer else None\n        resid = getattr(layer, \"keys\", None) if layer else None\n\n        rec.update(\n            ok=True,\n            returned_seq_len=int(out_k.shape[-2]),\n            quantized_populated=qk is not None,\n            residual_len_after=(int(resid.shape[-2])\n                                if resid is not None and hasattr(resid, \"shape\")\n                                and resid.dim() == 4 else None),\n        )\n    except Exception as e:\n        rec[\"error\"] = f\"{type(e).__name__}: {e}\"\n    return rec\n\n\nLEGALITY = {}\nprint(\"\\n=== functional legality (CPU) ===\")\nprint(f\"{'backend':8s} {'nbits':>5} {'res':>4}  {'dtype':>7}  result\")\nfor backend, nbits, res in itertools.product((\"quanto\", \"hqq\"),\n                                             (1, 2, 3, 4, 8),\n                                             (0, 128)):\n    rec = None\n    for dtype in (torch.float16, torch.float32):   # fp16 on CPU is patchy\n        rec = exercise(backend, nbits, res, dtype)\n        if rec[\"ok\"]:\n            break\n    LEGALITY[f\"{backend}_nbits{nbits}_res{res}\"] = rec\n    if rec[\"ok\"]:\n        print(f\"{backend:8s} {nbits:>5} {res:>4}  {rec['dtype'][6:]:>7}  \"\n              f\"OK  seq={rec['returned_seq_len']} \"\n              f\"quantized={rec['quantized_populated']} \"\n              f\"residual={rec['residual_len_after']}\")\n    else:\n        print(f\"{backend:8s} {nbits:>5} {res:>4}  {'-':>7}  FAIL {rec['error'][:110]}\")\n\ndef usable(backend, res):\n    return sorted({int(k.split(\"nbits\")[1].split(\"_\")[0])\n                   for k, v in LEGALITY.items()\n                   if v[\"ok\"] and k.startswith(backend) and k.endswith(f\"res{res}\")})\n\nprint(f\"\\nquanto usable nbits @ residual_length=0   : {usable('quanto', 0) or 'NONE'}\")\nprint(f\"quanto usable nbits @ residual_length=128 : 