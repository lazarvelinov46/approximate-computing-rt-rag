n#     the quantized path changed the fp16 path, every knob-3 McNemar would be\n#     measuring the code change rather than the cache.\n# (b) The whole alignment analysis assumed len(tok.encode(p)) equals the\n#     padded length the cache sees at prefill. Assert it rather than assume it.\n\nbase = R.load_results(\"results/baseline_1k_results.csv\",\n                      setting=\"baseline\", mode=\"short\")\nbase_pred = dict(zip(base[\"qid\"], base[\"prediction\"]))\n\nMNT = CFG[\"generation\"][\"max_new_tokens\"]\nbatches = [list(range(i, min(i + BATCH, len(exs)))) for i in range(0, len(exs), BATCH)]\n\nprint(\"=== (b) padded length ===\")\nfor bi, idxs in enumerate(batches):\n    enc = tok([prompts[i] for i in idxs], return_tensors=\"pt\", padding=True)\n    actual = enc[\"input_ids\"].shape[-1]\n    expected = max(plens[i] for i in idxs)\n    cpg = KV.channels_per_group(len(idxs), actual, KV.Q_GROUP_SIZE)\n    print(f\"  batch {bi}: encode-max {expected}, padded {actual}, \"\n          f\"match {actual == expected}, channels/group {cpg}\")\n    assert actual == expected, (\n        f\"padded length {actual} != max(plens) {expected}; every \"\n        f\"channels_per_group figure computed from prompt_tokens is shifted\")\n    assert cpg == 1, f\"group {KV.Q_GROUP_SIZE} did not give per-channel grouping\"\n\nprint(\"\\n=== (a) fp16 byte-identity ===\")\nfp16_out, mismatches = [], []\nfor bi, idxs in enumerate(batches):\n    got = G.generate_batch(gen, tok, [prompts[i] for i in idxs], MNT, kv=None)\n    fp16_out.extend(got)\n    for i, txt in zip(idxs, got):\n        ref = base_pred.get(exs[i].qid)\n        if ref is None:\n            mismatches.append((exs[i].qid, \"NOT IN BASELINE\", txt))\n        elif ref != txt:\n            mismatches.append((exs[i].qid, ref, txt))\n\nprint(f\"  {len(fp16_out) - len(mismatches)}/{len(fp16_out)} identical to baseline\")\nfor qid, ref, got in mismatches[:5]:\n    print(f\"  {qid}\\n    baseline: {ref!r}\\n    now     : {got!r}\")\nassert not mismatches, \"fp16 path changed — do NOT proceed to the sweep\"\nprint(\"  fp16 path unchanged\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T18:36:39.442318Z","iopub.execute_input":"2026-09-03T18:36:39.443112Z","iopub.status.idle":"2026-09-03T18:36:52.681809Z","shell.execute_reply.started":"2026-09-03T18:36:39.443059Z","shell.execute_reply":"2026-09-03T18:36:52.68108Z"}},"outputs":[{"name":"stderr","text":"The following generation flags are not valid and may be ignored: ['temperature', 'top_p', 'top_k']. Set `TRANSFORMERS_VERBOSITY=info` for more details.\n","output_type":"stream"},{"name":"stdout","text":"=== (b) padded length ===\n  batch 0: encode-max 1105, padded 1105, match True, channels/group 1\n  batch 1: encode-max 1143, padded 1143, match True, channels/group 1\n\n=== (a) fp16 byte-identity ===\n  32/32 identical to baseline\n  fp16 path unchanged\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# notebooks/11_ac_knob3_smoke — CELL 3\n# Sanity: a quantized cache must CHANGE the output. A setting that silently\n# fails to apply looks exactly like a setting that causes no damage, and the\n# second is the result we expect — so the null is only interpretable if we\n# have shown the knob can move something.\n#\n# Overhead: every decode step dequantizes the whole store, so short mode\n# (~4 steps) and explain mode (~92 steps) will differ sharply. The explain\n# arm is only affordable if this factor is small.\n\ndef run_timed(spec, max_new_tokens, n_batches=2, warmup=True):\n    idx0 = batches[0]\n    if warmup:\n        G.generate_batch(gen, tok, [prompts[i] for i in idx0][:4],\n                         max_new_tokens, kv=spec)\n    torch.cuda.synchronize()\n    t0 = time.time()\n    out = []\n    for idxs in batches[:n_batches]:\n        out.extend(G.generate_batch(gen, tok, [prompts[i] for i in idxs],\n                                    max_new_tokens, kv=spec))\n    torch.cuda.synchronize()\n    return out, time.time() - t0\n\ndef identity(a, b):\n    return round(sum(x == y for x, y in zip(a, b)) / len(a), 4)\n\nprint(\"=== short mode, 2 batches ===\")\nprint(f\"{'setting':28s} {'sec':>7} {'x fp16':>7} {'identical':>10}\")\n_, t16 = run_timed(None, MNT)\nprint(f\"{'kv_fp16':28s} {t16:>7.1f} {1.0:>7.2f} {1.0:>10.4f}\")\n\nSHORT_TIMING = {\"kv_fp16\": {\"sec\": round(t16, 2), \"factor\": 1.0, \"identity\": 1.0}}\nfor spec in (dict(bits=8), dict(bits=4), dict(bits=2)):\n    out, t = run_timed(spec, MNT)\n    lab, idn = KV.label(**spec), identity(fp16_out, out)\n    SHORT_TIMING[lab] = {\"sec\": round(t, 2), \"factor\": round(t / t16, 2),\n                         \"identity\": idn}\n    print(f\"{lab:28s} {t:>7.1f} {t/t16:>7.2f} {idn:>10.4f}\")\n\nassert SHORT_TIMING[KV.label(bits=2)][\"identity\"] < 1.0, (\n    \"2-bit produced output identical to fp16 — the cache is not being applied\")\n\nprint(\"\\n=== explain mode, 1 batch ===\")\nMNTE = CFG[\"generation\"].get(\"max_new_tokens_explain\", 256)\nprompts_ex = [G.build_prompt(tok, e.question, [e.paragraphs[i] for i in r],\n                             system=G.SYSTEM_EXPLAIN)\n              for e, r in zip(exs, retrieved)]\nsaved, prompts = prompts, prompts_ex\nEXPLAIN_TIMING = {}\n_, e16 = run_timed(None, MNTE, n_batches=1)\nEXPLAIN_TIMING[\"kv_fp16\"] = {\"sec\": round(e16, 2), \"factor\": 1.0}\nprint(f\"{'kv_fp16':28s} {e16:>7.1f} {1.0:>7.2f}\")\nfor spec in (dict(bits=4),):\n    _, t = run_timed(spec, MNTE, n_batches=1)\n    EXPLAIN_TIMING[KV.label(**spec)] = {\"sec\": round(t, 2),\n                                        \"factor\": round(t / e16, 2)}\n    print(f\"{KV.label(**spec):28s} {t:>7.1f} {t/e16:>7.2f}\")\nprompts = saved\n\nf = EXPLAIN_TIMING[KV.label(bits=4)][\"factor\"]\nprint(f\"\\nprojected explain arm: 3 settings x 29.6 min x {f:.2f} = \"\n      f\"{3 * 29.6 * f:.0f} min\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T18:36:52.682985Z","iopub.exe