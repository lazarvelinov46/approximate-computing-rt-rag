,{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/199 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"e6f5b235909241a085483b245d451826"}},"metadata":{}},{"name":"stderr","text":"BertModel LOAD REPORT from: BAAI/bge-small-en-v1.5\nKey                     | Status     |  | \n------------------------+------------+--+-\nembeddings.position_ids | UNEXPECTED |  | \n\nNotes:\n- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/366 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"aff29f848e7e4bbbb242cdf2412c01d0"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.txt:   0%|          | 0.00/232k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"cb3c57d3f6ce469f9f54c496babaec8a"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer.json:   0%|          | 0.00/711k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"dd9c79b928d446c9a6546610581ca732"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"special_tokens_map.json:   0%|          | 0.00/125 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c4ef3242852d4e02a647383418e8f068"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/190 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"d45b0f87937840b79484187388d267c7"}},"metadata":{}}],"execution_count":1},{"cell_type":"code","source":"# notebooks/40_ac_qwen25_7b_knob345 — CELL 2\n# Plan, references and checks. The preflight at the bottom is CPU-only: it\n# validates every label and every 3B comparison before any GPU run.\n# References: knob 3 and k=2/3 -> baseline; every knob-4 setting -> evict_none_b1\n# (fp32 eager == sdpa 32/32, notebook 37 cell 10; same as the 3B); k=10 at\n# batch 8 -> topk_05_b8 (k=10 b16 OOM, notebook 37 cell 7).\nFNAME = {\"baseline\": \"baseline_1k_results.csv\", \"kv_\": \"knob3_short_results.csv\",\n         \"evict_\": \"knob4_short_results.csv\", \"topk_\": \"knob5_results.csv\"}\n\ndef path_for(model, tag):\n    key = \"baseline\" if tag == \"baseline\" else next(\n        p for p in (\"kv_\", \"evict_\", \"topk_\") if tag.startswith(p))\n    return (OUTDIR if model == \"7b\" else Path(\"results\")) / FNAME[key]\n\ndef _load(path, tag):\n    df = R.load_results(str(path), setting=tag)\n    assert len(df) == 1000 and df.qid.nunique() == 1000, \\\n        f\"{path.name}:{tag}: {len(df)} rows, {df.qid.nunique()} unique qids\"\n    return df\n\n@functools.lru_cache(maxsize=None)\ndef q3b(tag):\n    return _load(path_for(\"3b\", tag), tag)\n\ndef s7b(tag):                            # never cached: files grow during the sweep\n    return _load(path_for(\"7b\", tag), tag)\n\ndef hits(df):\n    return {q: Q.exact_match(p, g) for q, p, g in zip(df.qid, df.prediction, df.gold_answer)}\n\ndef mcnemar(ref_df, set_df):\n    A, S = hits(ref_df), hits(set_df)\n    b = sum(1 for q in A if S[q] == 1 and A[q] == 0)     # setting-only correct\n    c = sum(1 for q in A if A[q] == 1 and S[q] == 0)     # reference-only correct\n    p = binomtest(b, b + c, 0.5).pvalue if b + c else 1.0\n    return {\"b\": b, \"c\": c, \"d\": b + c, \"p\": round(float(p), 4), \"verdict\": verdict(b, c, p)}\n\ndef evi(policy, keep_ratio):\n    return {\"batch_size\": 1, \"evict\": {\"policy\": policy, \"keep_ratio\": keep_ratio}}\n\nB1 = \"evict_none_b1\"\n# tag -> (7B reference, 3B tag, 3B reference, 3B retrieval tag, run kwargs)\nPLAN = {\n    \"kv_hqq_n8_g32_r512\":    (\"baseline\", \"kv_hqq_n8_g32_r512\", \"baseline\", \"baseline\", {\"kv\": {\"bits\": 8}}),\n    \"kv_hqq_n4_g32_r512\":    (\"baseline\", \"kv_hqq_n4_g32_r512\", \"baseline\", \"baseline\", {\"kv\": {\"bits\": 4}}),\n    \"kv_hqq_n3_g32_r512\":    (\"baseline\", \"kv_hqq_n3_g32_r512\", \"baseline\", \"baseline\", {\"kv\": {\"bits\": 3}}),\n    \"kv_hqq_n2_g32_r512\":    (\"baseline\", \"kv_hqq_n2_g32_r512\", \"baseline\", \"baseline\", {\"kv\": {\"bits\": 2}}),\n    \"kv_hqq_n2_g16_r512\":    (\"baseline\", \"kv_hqq_n2_g16_r512\", \"baseline\", \"baseline\",\n                              {\"kv\": {\"bits\": 2, \"q_group_size\": 16}}),\n    \"evict_recency_r050\":    (B1, \"evict_recency_r050\",    B1, \"baseline\", evi(\"recency\", 0.50)),\n    \"evict_sink4_r050\":      (B1, \"evict_sink4_r050\",      B1, \"baseline\", evi(\"sink_recent\", 0.50)),\n    \"evict_random_r050_s42\": (B1, \"evict_random_r050_s42\", B1, \"baseline\", evi(\"random\", 0.50)),\n    \"evict_attn_r050\":       (B1, \"evict_attn_r050\",       B1, \"baseline\", evi(\"attention\", 0.50)),\n    \"evict_random_r025_s42\": (B1, \"evict_random_r025_s42\", B1, \"baseline\", evi(\"random\", 0.25)),\n    \"evict_attn_r025\":       (B1, \"evict_attn_r025\",       B1, \"baseline\", evi(\"attention\", 0.25)),\n    \"topk_02\":               (\"baseline\", \"topk_02\", \"baseline\", \"topk_02\", {\"top_k\": 2}),\n    \"topk_03\":               (\"baseline\", \"topk_03\", \"baseline\", \"topk_03\", {\"top_k\": 3}),\n    \"topk_05_b8\":            (\"baseline\", None, None, \"baseline\", {\"top_k\": 5, \"batch_size\": 8}),\n    \"topk_10_b8\":            (\"topk_05_b8\", \"topk_10\", \"baseline\", \"topk_10\",\n                              {\"top_k\": 10, \"batch_size\": 8}),\n}\n\nREC, MEM = {}, {}\ndef check(tag):\n    ref, qtag, qref, qret, kw = PLAN[tag]\n    k = kw.get(\"top_k\", TOP_K)\n    S, SR, QR3 = s7b(tag), s7b(ref), q3b(qret).set_index(\"qid\")\n    # Identical prompts (notebook 37): retrieval AND token counts equal the 3B's per question.\n    bad_r = sum(QR3.loc[q, \"retrieved_ids\"] != v for q, v in zip(S.qid, S.retrieved_ids))\n    bad_p = sum(int(QR3.loc[q, \"prompt_tokens\"]) != int(v) for q, v in zip(S.qid, S.prompt_tokens))\n    assert bad_r == 0 and bad_p == 0, \\\n        f\"{tag}: vs 3B {qret}, retrieved_ids differ {bad_r}, prompt_tokens differ {bad_p}\"\n    ref_pred = dict(zip(SR.qid, SR.prediction))\n    a7 = Q.aggregate(S.to_dict(\"records\"), k=k)\n    a7r = Q.aggregate(SR.to_dict(\"records\"), k=TOP_K)\n    m7 = mcnemar(SR, S)\n    dec = S.decode_tokens.astype(float)\n    rec = {\"ref_7b\": ref,\n           \"7b\": {\"em\": a7[\"em\"], \"dEM\": round(a7[\"em\"] - a7r[\"em\"], 4), **m7,\n                  \"identity_vs_ref\": round(float(np.mean(\n                      [ref_pred[q] == p for q, p in zip(S.qid, S.prediction)])), 4),\n                  \"complete_frac\": a7[\"complete_frac\"], \"em_complete\": a7[\"em_complete\"],\n                  \"em_incomplete\": a7[\"em_incomplete\"], \"abstain_rate\": a7[\"abstain_rate\"],\n                  \"decode_mean\": round(float(dec.mean()), 2),\n                  \"trunc_frac\": round(float((dec >= MNT_SHORT - 1).mean()), 4),\n                  \"bang_frac\": round(float(np.mean([\"!\" in p for p in S.prediction])), 4)}}\n    line = (f\"{tag:<22} 7B EM {a7['em']:.3f} {rec['7b']['dEM']:+.3f} \"\n            f\"b={m7['b']:>3} c={m7['c']:>3} p={m7['p']:.4f} {m7['verdict']:<13} \"\n            f\"ident {rec['7b']['identity_vs_ref']:.3f} trunc {rec['7b']['trunc_frac']:.3f}\")\n    if qtag:\n        Qd, QR = q3b(qtag), q3b(qref)\n        a3 = Q.aggregate(Qd.to_dict(\"records\"), k=k)\n        a3r = Q.aggregate(QR.to_dict(\"records\"), k=TOP_K)\n        m3 = mcnemar(QR, Qd)\n        rec.update(tag_3b=qtag, ref_3b=qref,\n                   **{\"3b\": {\"em\": a3[\"em\"], \"dEM\": round(a3[\"em\"] - a3r[\"em\"], 4), **m3}})\n        rec[\"ddEM_point\"] = round(rec[\"7b\"][\"dEM\"] - rec[\"3b\"][\"dEM\"], 4)\n        line += (f\" | 3B EM {a3['em']:.3f} {rec['3b']['dEM']:+.3f} p={m3['p']:.4f} \"\n                 f\"{m3['verdict']:<12} | dd {rec['ddEM_point']:+.3f}\")\n    REC[tag] = rec\n    print(line)\n\ndef run_setting(tag):\n    kw = PLAN[tag][4]\n    attn = kw.get(\"evict\", {}).get(\"policy\") == \"attention\"\n    t0 = time.time()\n    M.reset_peaks(DEVS)\n    with (EV.fp32_eager(gen) if attn else contextlib.nullcontext()):\n        R.run_pipeline(exs, CFG_7, embedder=embedder, generator=gen, gen_tok=tok,\n                       mode=\"short\", setting=tag, out_csv=str(path_for(\"7b\", tag)),\n                       resume=True, progress=False, **kw)\n    assert gen.config._attn_implementation == \"sdpa\", \"attn impl not restored\"\n    MEM[tag] = M.snapshot(DEVS)\n    check(tag)\n    print(f\"  {(time.time() - t0) / 60:.1f} min | {M.fmt(MEM[tag])}\"\n          f\"\\n  >>> COMMIT AND PUSH {path_for('7b', tag).name} <<<\")\n\n# --- preflight (CPU) --------------------------------------------------------\nQWEN_EM = {\"kv_hqq_n8_g32_r512\": 0.391, \"kv_hqq_n4_g32_r512\": 0.385,\n           \"kv_hqq_n3_g32_r512\": 0.339, \"kv_hqq_n2_g32_r512\": 0.046,\n           \"kv_hqq_n2_g16_r512\": 0.370, \"evict_recency_r050\": 0.161,\n           \"evict_sink4_r050\": 0.282, \"evict_random_r050_s42\": 0.320,\n           \"evict_attn_r050\": 0.337, \"evict_random_r025_s42\": 0.087,\n           \"evict_attn_r025\": 0.299, \"topk_02\": 0.366, \"topk_03\": 0.379, \"topk_10\": 0.428}\nQWEN_P = {\"topk_10\": 0.0014}\n\nfor ref in (\"baseline\", B1):\n    s7b(ref)\nfor tag, (ref, qtag, qref, qret, kw) in PLAN.items():\n    if \"kv\" in kw:\n        assert KV.label(**kw[\"kv\"]) == tag, f\"{tag}: KV.label gives {KV.label(**kw['kv'])}\"\n    if \"evict\" in kw:\n        assert EV.label(**kw[\"evict\"]) == tag, f\"{tag}: EV.label gives {EV.label(**kw['evict'])}\"\n    q3b(qret)\n    if qtag:\n        em = Q.aggregate(q3b(qtag).to_dict(\"records\"), k=kw.get(\"top_k