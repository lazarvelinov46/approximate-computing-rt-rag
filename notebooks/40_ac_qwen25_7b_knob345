{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.16","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# notebooks/40_ac_qwen25_7b_knob345 — CELL 1\n# Kaggle: Accelerator = GPU T4 x2, Internet On, HF_TOKEN secret ON.\n# Qwen2.5-7B, regime-1 knobs: 3 (KV precision), 4 (KV eviction), 5 (top-k).\n# Short, n=1000, the 3B's setting labels. ~5 h; every run resumes.\n!pip install -q datasets sentence-transformers faiss-cpu hqq \"transformers==5.0.0\"\n\nimport os\nos.environ[\"HF_HOME\"] = \"/kaggle/temp/hf_cache\"\nos.environ[\"TOKENIZERS_PARALLELISM\"] = \"false\"\n\nfrom kaggle_secrets import UserSecretsClient\nfrom huggingface_hub import login, snapshot_download\nlogin(token=UserSecretsClient().get_secret(\"HF_TOKEN\"))\n\nREPO_URL = \"https://github.com/lazarvelinov46/approximate-computing-rt-rag.git\"\nDEST     = \"/kaggle/working/ac-rag-stack\"\nif os.path.isdir(DEST):\n    !git -C \"{DEST}\" pull -q\nelse:\n    !git clone -q \"{REPO_URL}\" \"{DEST}\"\n%cd {DEST}\nimport sys\nif \".\" not in sys.path:\n    sys.path.insert(0, \".\")\n!git log --oneline -1\n\nimport contextlib, functools, json, time\nfrom importlib.metadata import version\nfrom pathlib import Path\nimport numpy as np\nimport torch\nfrom scipy.stats import binomtest\n\nfrom src.config import load_config, results_dir\nfrom src.data.loader import load_from_config\nimport src.generator.model as G\nfrom src.generator import kv_cache as KV, eviction as EV\nimport src.retriever.embed as E\nimport src.pipeline.rag as R\nimport src.metrics.quality as Q\nimport src.metrics.memory as M\nfrom scripts.plot_phase2 import verdict\n\nassert version(\"transformers\") == \"5.0.0\"\nassert torch.cuda.device_count() == 2, \"need T4 x2: the 7B is split across both cards\"\nassert hasattr(EV, \"fp32_eager\"), \"eviction.py without the fp32 eager fix\"\nCFG_7 = load_config(model=\"qwen25_7b\")\nSEVEN = CFG_7[\"models\"][\"generator\"]\nOUTDIR = results_dir(SEVEN)\nTOP_K = CFG_7[\"retrieval\"][\"top_k\"]\nMNT_SHORT = CFG_7[\"generation\"][\"max_new_tokens\"]\n\nwith open(OUTDIR / \"baselines_summary.json\") as fh:\n    REV = json.load(fh)[\"snapshot\"]\nwith open(OUTDIR / \"prep_audit.json\") as fh:\n    FILES_W = json.load(fh)[\"weights\"][\"files\"]\nWDIR = snapshot_download(SEVEN, revision=REV, allow_patterns=list(FILES_W))\nassert all((Path(WDIR) / f).stat().st_size == v[\"size\"] for f, v in FILES_W.items())\nDM = G.device_map_for(CFG_7)\ngen, tok = G.load_generator(SEVEN, device_map=DM, weights_dir=WDIR)\nDEVS = M.model_devices(gen)\nassert DEVS == [0, 1] and gen.config.name_or_path == SEVEN\nprint(f\"{SEVEN}@{REV[:10]}  weights per card {G.check_placement(gen, DM)}\")\n\nexs = load_from_config(CFG_7)\nembedder = E.load_embedder(CFG_7[\"models\"][\"embedder\"])","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-11-10T09:36:48.561277Z","iopub.execute_input":"2026-11-10T09:36:48.561578Z","iopub.status.idle":"2026-11-10T09:39:38.930495Z","shell.execute_reply.started":"2026-11-10T09:36:48.561544Z","shell.execute_reply":"2026-11-10T09:39:38.929839Z"}},"outputs":[{"name":"stdout","text":"  Installing build dependencies ... \u001b[?25l\u001b[?25hdone\n  Getting requirements to build wheel ... \u001b[?25l\u001b[?25hdone\n  Preparing metadata (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n  Building wheel for hqq (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n/kaggle/working/ac-rag-stack\n\u001b[33m28f6899\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m