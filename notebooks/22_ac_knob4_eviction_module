— CELL 2  (corrected rope precondition)\n# Module test on a tiny random-init Qwen2. Same code paths as the 3B, no\n# download, no GPU. Every assertion here is a property the sweep depends on.\nimport torch, random\nfrom transformers import Qwen2Config, Qwen2ForCausalLM\nfrom transformers.cache_utils import Cache, DynamicLayer\nfrom src.generator import eviction as EV\n\nEV.selftest()\n\ntorch.manual_seed(42)\ntiny = Qwen2Config(vocab_size=256, hidden_size=64, intermediate_size=128,\n                   num_hidden_layers=2, num_attention_heads=4,\n                   num_key_value_heads=2, max_position_embeddings=256,\n                   use_sliding_window=False, tie_word_embeddings=False)\nm = Qwen2ForCausalLM(tiny).eval()\n\n# --- rope preconditions for exact rotation composition ---------------------\n# R(d).R(p) = R(p+d) holds only if inv_freq is FIXED for the whole run.\n# 'dynamic' and 'longrope' recompute it from the sequence length mid-generation,\n# which would mean re-rotating under a different frequency basis than the one\n# the key was stored with. The rest build inv_freq once.\nSTATIC_ROPE = (\"default\", \"linear\", \"yarn\", \"llama3\")\nrp = getattr(tiny, \"rope_parameters\", None) or {}\nrope_type = rp.get(\"rope_type\", \"default\")\nscaling = float(m.model.rotary_emb.attention_scaling)\ninv_freq = m.model.rotary_emb.inv_freq\nhead_dim = getattr(tiny, \"head_dim\", tiny.hidden_size // tiny.num_attention_heads)\n\nprint(f\"rope_type={rope_type}  theta={rp.get('rope_theta')}  \"\n      f\"attention_scaling={scaling}  inv_freq={tuple(inv_freq.shape)}  \"\n      f\"head_dim={head_dim}\")\nassert rope_type in STATIC_ROPE, \\\n    f\"rope_type={rope_type!r} recomputes inv_freq mid-generation; \" \\\n    f\"rotation composition is not exact. Re-derive before proceeding.\"\nassert 2 * inv_freq.numel() == head_dim, \\\n    \"partial rotary factor: only part of head_dim is rotated, and _rotate \" \\\n    \"assumes the full width. Re-derive the cos/sin construction.\"\n\nPROMPT_LEN, NEW = 40, 10\nids = torch.randint(1, 256, (1, PROMPT_LEN))\nmask = torch.ones(1, PROMPT_LEN, dtype=torch.long)\n\ndef gen(cache):\n    with torch.no_grad():\n        out = m.generate(input_ids=ids, attention_mask=mask,\n                         past_key_values=cache, use_cache=True,\n                         max_new_tokens=NEW, do_sample=False, pad_token_id=0)\n    return out[:, PROMPT_LEN:]\n\nbase = gen(None)\nprint(f\"baseline (fp16 DynamicCache): {base[0].tolist()}\")\n\n# --- 1. policy='none' must be byte-identical to the Phase 1 path -----------\nassert EV.make_cache(policy=\"none\") is None\nassert (gen(EV.make_cache(policy=\"none\")) == base).all()\n\n# --- 2. budget past the horizon must reproduce the baseline exactly --------\nBIG = PROMPT_LEN + NEW + 10\nfor p in (\"recency\", \"sink_recent\", \"random\"):\n    c = EV.make_cache(m, p, budget=BIG)\n    assert (gen(c) == base).all(), f\"{p} at budget {BIG} diverged from baseline\"\n    assert c.layers[0].evicted == 0\nprint(f\"budget {BIG} (never fires): all three policies match baseline\")\n\n# --- 3. recency needs no rotation; the delta is identically zero -----------\nc = EV.make_cache(m, \"recency\", budget=16)\nout_rec = gen(c)\nassert c.layers[0].evicted > 0, \"eviction never fired\"\nassert c.layers[0].rotations == 0, \\\n    \"recency rotated something — the keep-set was not a suffix\"\nprint(f\"recency b=16: evicted={c.layers[0].evicted}, rotations=0\")\n\n# --- 4. the phase invariant: stored keys occupy a contiguous arange --------\nfor p in (\"recency\", \"sink_recent\", \"random\"):\n    c = EV.make_cache(m, p, budget=16)\n    gen(c)\n    for li, layer in enumerate(c.layers):\n        ph = layer.phase\n        assert (ph.diff() == 1).all(), f\"{p} layer {li}: phase has a hole {ph}\"\n        assert int(ph[-1]) == layer.cumulative_length - 1, \\\n            f\"{p} layer {li}: newest key moved off its true position\"\nprint(\"phase invariant holds for all policies — kv_offset is now honest\")\n\n# --- 5. shifting must actually change the answer for a hollow keep-set -----\nshifted = gen(EV.make_cache(m, \"sink_recent\", budget=16))\nnaive_c = EV.make_cache(m, \"sink_recent\", budget=16, shift_rope=False,\n                        allow_naive=True)\nnaive = gen(naive_c)\nassert naive_c.layers[0].rotations == 0\nprint(f\"sink_recent shifted: {shifted[0].tolist()}\")\nprint(f\"sink_recent naive  : {naive[0].tolist()}\")\nprint(f\"shifted == naive: {bool((shifted == naive).all())}  (expect False)\")\n\n# --- 6. random is reproducible across constructions ------------------------\na = gen(EV.make_cache(m, \"random\", budget=16, seed=42))\nb = gen(EV.make_cache(m, \"random\", budget=16, seed=42))\nassert (a == b).all(), \"seeded random is not reproducible\"\nd = gen(EV.make_cache(m, \"random\", budget=16, seed=7))\nprint(f\"random seed 42 reproducible: True   seed 7 differs: \"\n      f\"{not bool((a == d).all())}\")\n\n# --- 7. a fresh Cache per call — a reused one carries the last batch's keys -\nc = EV.make_cache(m, \"recency\", budget=16)\nfirst = gen(c)\nsecond = gen(c)\nprint(f\"\\nreusing one Cache object corrupts the next call: \"\n      f\"{not bool((first == second).all())}  (why make_cache returns fresh)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T12:34:30.661341Z","iopub.execute_input":"2026-09-07T12:34:30.662292Z","iopub.status.idle":"2026-09-07T12:34:31.106483Z","shell.execute_reply.started":"2026-09-07T12:34:30.662255Z","shell.execute_reply":"2026-09-07T12:34:31.105272Z"}},"outputs":[{"name":"stdout","text":"eviction selftest OK\nrope_type=default  theta=10000.0  attention_scaling=1.0  inv_freq=(8,)  head_dim=16\nbaseline (fp16 DynamicCache): [153, 60, 142, 32, 86, 143, 39, 82, 39, 82]\nbudget 60 (never fires): all three policies match baseline\nrecency b=16: evicted=33, rotations=0\nphase invariant holds for all policies — kv_offset is now honest\nsink_recent shifted: [153, 60, 142, 74, 229, 220