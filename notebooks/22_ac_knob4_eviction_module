 budget=16).layers[0]\n\nP1 = [0, 1, 2, 3, 28, 29]          # a hollow keep-set, as sink_recent produces\nP2 = [24, 25, 26, 27, 28, 29]      # packed contiguously backwards from newest\ndelta = torch.tensor([b - a for a, b in zip(P1, P2)], dtype=torch.long)\n\ncomposed = layer._rotate(rotate_to(k_raw, P1), delta)\ndirect   = rotate_to(k_raw, P2)\nerr = (composed - direct).abs().max().item()\nprint(f\"delta applied      : {delta.tolist()}\")\nprint(f\"max |composed - direct| = {err:.3e}\")\nassert torch.allclose(composed, direct, atol=1e-5), \\\n    \"rotation composition is NOT exact — the whole shift design is invalid\"\n\n# a zero delta must be an exact no-op, which is why recency costs nothing\nzero = layer._rotate(rotate_to(k_raw, P2), torch.zeros(L, dtype=torch.long))\nassert torch.allclose(zero, direct, atol=1e-6)\nprint(\"zero delta is an exact no-op\")\n\n# --- B. the rotation path actually fires for a hollow keep-set -------------\nc_sh = EV.make_cache(m, \"sink_recent\", budget=16)\n_ = gen(c_sh)\nc_na = EV.make_cache(m, \"sink_recent\", budget=16, shift_rope=False,\n                     allow_naive=True)\n_ = gen(c_na)\nprint(f\"\\nshifted: rotations={c_sh.layers[0].rotations}  \"\n      f\"evicted={c_sh.layers[0].evicted}\")\nprint(f\"naive  : rotations={c_na.layers[0].rotations}  \"\n      f\"evicted={c_na.layers[0].evicted}\")\nassert c_sh.layers[0].rotations > 0, \"shift path never fired\"\nassert c_na.layers[0].rotations == 0\n\n# the two branches must leave DIFFERENT state: naive keeps a hollow phase\nph_sh, ph_na = c_sh.layers[0].phase, c_na.layers[0].phase\nassert (ph_sh.diff() == 1).all(), \"shifted phase is not contiguous\"\nassert not (ph_na.diff() == 1).all(), \"naive phase has no hole — nothing ablated\"\nprint(f\"shifted phase contiguous: True    naive phase holes: \"\n      f\"{(ph_na.diff() != 1).sum().item()}\")\n\n# --- C. compare LOGITS, not tokens ----------------------------------------\ndef logits_of(cache):\n    with torch.no_grad():\n        out = m.generate(input_ids=ids, attention_mask=mask,\n                         past_key_values=cache, use_cache=True,\n                         max_new_tokens=NEW, do_sample=False, pad_token_id=0,\n                         return_dict_in_generate=True, output_logits=True)\n    return torch.stack(out.logits)\n\nlg_sh = logits_of(EV.make_cache(m, \"sink_recent\", budget=16))\nlg_na = logits_of(EV.make_cache(m, \"sink_recent\", budget=16,\n                                shift_rope=False, allow_naive=True))\nlg_base = logits_of(None)\nprint(f\"\\nmax |logit| shifted vs naive   : \"\n      f\"{(lg_sh - lg_na).abs().max().item():.4f}\")\nprint(f\"max |logit| shifted vs baseline: \"\n      f\"{(lg_sh - lg_base).abs().max().item():.4f}\")\nassert not torch.allclose(lg_sh, lg_na), \\\n    \"shifted and naive produce identical logits — rotation had no effect\"\n\n# --- D. reusing a Cache fails LOUDLY --------------------------------------\nc = EV.make_cache(m, \"recency\", budget=16)\n_ = gen(c)\ntry:\n    _ = gen(c)\nexcept (IndexError, ValueError, RuntimeError) as e:\n    print(f\"\\nreuse raises {type(e).__name__} — stale cumulative_length={c.layers[0].cumulative_length} \"\n          f\"makes generate slice input_ids empty. Loud, not silent.\")\nelse:\n    raise AssertionError(\"reusing a Cache should not have succeeded\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T12:39:21.161923Z","iopub.execute_input":"2026-09-07T12:39:21.163096Z","iopub.status.idle":"2026-09-07T12:39:21.369392Z","shell.execute_reply.started":"2026-09-07T12:39:21.163054Z","shell.execute_reply":"2026-09-07T12:39:21.368273Z"}},"outputs":[{"name":"stdout","text":"delta applied      : [24, 24, 24, 24, 0, 0]\nmax |composed - direct| = 5.811e-07\nzero delta is an exact no-op\n\nshifted: rotations=10  evicted=33\nnaive  : rotations=0  evicted=33\nshifted phase contiguous: True    naive phase holes: 1\n\nmax |logit| shifted vs naive   : 0.0031\nmax |logit| shifted vs baseline: 0.6652\n\nreuse raises IndexError — stale cumulative_length=49 makes generate slice input_ids empty. Loud, not silent.\n","output_type":"stream"}],"execution_count":5}]}