_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/199 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"86b3f462660e42509ee0e37fa8f24364"}},"metadata":{}},{"name":"stderr","text":"BertModel LOAD REPORT from: BAAI/bge-small-en-v1.5\nKey                     | Status     |  | \n------------------------+------------+--+-\nembeddings.position_ids | UNEXPECTED |  | \n\nNotes:\n- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/366 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"5a4dc904b6e24925bf7ae9d97bc96f47"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.txt: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"96edca5b5948475eae5f2573848a23c0"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer.json: 0.00B [00:00, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"f1e506ece06d4fad989c3dc100d3189f"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"special_tokens_map.json:   0%|          | 0.00/125 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"48e4b9ceffd34196946327f75b691018"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/190 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"3a4b3c9bccfb494ea165182ed1444a12"}},"metadata":{}}],"execution_count":1},{"cell_type":"code","source":"# notebooks/36_ac_llama32_3b_knob345 — CELL 2\n# Plan, references and checks. The preflight at the bottom is CPU-only: it\n# validates every label and every Qwen comparison before any GPU run.\nCITE = re.compile(r\"^\\s*(\\[\\d+\\][\\s,;]*)+\")\ndef is_bare(p):\n    return bool(CITE.match(p)) and not CITE.sub(\"\", p).strip()\n\nFNAME = {\"baseline\": \"baseline_1k_results.csv\", \"kv_\": \"knob3_short_results.csv\",\n         \"evict_\": \"knob4_short_results.csv\", \"topk_\": \"knob5_results.csv\"}\n\ndef path_for(model, tag):\n    key = \"baseline\" if tag == \"baseline\" else next(\n        p for p in (\"kv_\", \"evict_\", \"topk_\") if tag.startswith(p))\n    return (OUTDIR if model == \"llama\" else Path(\"results\")) / FNAME[key]\n\ndef _load(path, tag):\n    df = R.load_results(str(path), setting=tag)\n    assert len(df) == 1000 and df.qid.nunique() == 1000, \\\n        f\"{path.name}:{tag}: {len(df)} rows, {df.qid.nunique()} unique qids\"\n    return df\n\n@functools.lru_cache(maxsize=None)\ndef qwen(tag):\n    return _load(path_for(\"qwen\", tag), tag)\n\ndef llama(tag):                          # never cached: files grow during the sweep\n    return _load(path_for(\"llama\", tag), tag)\n\ndef hits(df):\n    return {q: Q.exact_match(p, g) for q, p, g in zip(df.qid, df.prediction, df.gold_answer)}\n\ndef mcnemar(ref_df, set_df):\n    A, S = hits(ref_df), hits(set_df)\n    b = sum(1 for q in A if S[q] == 1 and A[q] == 0)     # setting-only correct\n    c = sum(1 for q in A if A[q] == 1 and S[q] == 0)     # reference-only correct\n    p = binomtest(b, b + c, 0.5).pvalue if b + c else 1.0\n    return {\"b\": b, \"c\": c, \"d\": b + c, \"p\": round(float(p), 4), \"verdict\": verdict(b, c, p)}\n\ndef evi(policy, keep_ratio):\n    return {\"batch_size\": 1, \"evict\": {\"policy\": policy, \"keep_ratio\": keep_ratio}}\n\nB1, B1E = \"evict_none_b1\", \"evict_none_b1_eager\"\n# tag -> (llama reference, qwen tag, qwen reference, qwen retrieval tag, run kwargs)\nPLAN = {\n    \"kv_hqq_n8_g32_r512\":    (\"baseline\", \"kv_hqq_n8_g32_r512\", \"baseline\", \"baseline\", {\"kv\": {\"bits\": 8}}),\n    \"kv_hqq_n4_g32_r512\":    (\"baseline\", \"kv_hqq_n4_g32_r512\", \"baseline\", \"baseline\", {\"kv\": {\"bits\": 4}}),\n    \"kv_hqq_n3_g32_r512\":    (\"baseline\", \"kv_hqq_n3_g32_r512\", \"baseline\", \"baseline\", {\"kv\": {\"bits\": 3}}),\n    \"kv_hqq_n2_g32_r512\":    (\"baseline\", \"kv_hqq_n2_g32_r512\", \"baseline\", \"baseline\", {\"kv\": {\"bits\": 2}}),\n    \"kv_hqq_n2_g16_r512\":    (\"baseline\", \"kv_hqq_n2_g16_r512\", \"baseline\", \"baseline\",\n                              {\"kv\": {\"bits\": 2, \"q_group_size\": 16}}),\n    \"evict_recency_r050\":    (B1,  \"evict_recency_r050\",    B1, \"baseline\", evi(\"recency\", 0.50)),\n    \"evict_sink4_r050\":      (B1,  \"evict_sink4_r050\",      B1, \"baseline\", evi(\"sink_recent\", 0.50)),\n    \"evict_random_r050_s42\": (B1,  \"evict_random_r050_s42\", B1, \"baseline\", evi(\"random\", 0.50)),\n    \"evict_attn_r050\":       (B1E, \"evict_attn_r050\",       B1, \"baseline\", evi(\"attention\", 0.50)),\n    \"evict_random_r025_s42\": (B1,  \"evict_random_r025_s42\", B1, \"baseline\", evi(\"random\", 0.25)),\n    \"evict_attn_r025\":       (B1E, \"evict_attn_r025\",       B1, \"baseline\", evi(\"attention\", 0.25)),\n    \"topk_02\":               (\"baseline\", \"topk_02\", \"baseline\", \"topk_02\", {\"top_k\": 2}),\n    \"topk_03\":               (\"baseline\", \"topk_03\", \"baseline\", \"topk_03\", {\"top_k\": 3}),\n    \"topk_05_b8\":            (\"baseline\", None, None, \"baseline\", {\"top_k\": 5, \"batch_size\": 8}),\n    \"topk_10_b8\":            (\"topk_05_b8\", \"topk_10\", \"baseline\", \"topk_10\",\n                              {\"top_k\": 10, \"batch_size\": 8}),\n}\n\nL_BASE = llama(\"baseline\")\nPLEN = dict(zip(L_BASE.qid, L_BASE.prompt_tokens))\n\nREC = {}\ndef check(tag):\n    lref, qtag, qref, qret, kw = PLAN[tag]\n    k = kw.get(\"top_k\", TOP_K)\n    L, LR = llama(tag), llama(lref)\n    ret = dict(zip(qwen(qret).qid, qwen(qret).retrieved_ids))\n    bad = sum(ret[q] != v for q, v in zip(L.qid, L.retrieved_ids))\n    assert bad == 0, f\"{tag}: retrieved_ids differ from Qwen's {qret} on {bad} questions\"\n    if k == TOP_K:\n        bad = sum(PLEN[q] != v for q, v in zip(L.qid, L.prompt_tokens))\n        assert bad == 0, f\"{tag}: prompt_tokens differ from Llama baseline on {bad} questions\"\n    ref_pred = dict(zip(LR.qid, LR.prediction))\n    aL = Q.aggregate(L.to_dict(\"records\"), k=k)\n    aLR = Q.aggregate(LR.to_dict(\"records\"), k=TOP_K)\n    mL = mcnemar(LR, L)\n    dec = L.decode_tokens.astype(float)\n    rec = {\"llama_ref\": lref,\n           \"llama\": {\"em\": aL[\"em\"], \"dEM\": round(aL[\"em\"] - aLR[\"em\"], 4), **mL,\n                     \"identity_vs_ref\": round(float(np.mean(\n                         [ref_pred[q] == p for q, p in zip(L.qid, L.prediction)])), 4),\n                     \"complete_frac\": aL[\"complete_frac\"], \"em_complete\": aL[\"em_complete\"],\n                     \"em_incomplete\": aL[\"em_incomplete\"], \"abstain_rate\": aL[\"abstain_rate\"],\n                     \"decode_mean\": round(float(dec.mean()), 2),\n                     \"trunc_frac\": round(float((dec >= MNT_SHORT - 1).mean()), 4),\n                     \"bare_cite\": round(float(np.mean([is_bare(p) for p in L.prediction])), 4)}}\n    line = (f\"{tag:<22} llama EM {aL['em']:.3f} {rec['llama']['dEM']:+.3f} \"\n            f\"b={mL['b']:>3} c={mL['c']:>3} p={mL['p']:.4f} {mL['verdict']:<13} \"\n            f\"ident {rec['llama']['identity_vs_ref']:.3f} trunc {rec['llama']['trunc_frac']:.3f}\")\n    if qtag:\n        Qd, QR = qwen(qtag), qwen(qref)\n        aQ = Q.aggregate(Qd.to_dict(\"records\"), k=k)\n        aQR = Q.aggregate(QR.to_dict(\"records\"), k=TOP_K)\n        mQ = mcnemar(QR, Qd)\n        rec.update(qwen_tag=qtag, qwen_ref=qref,\n                   qwen={\"em\": aQ[\"em\"], \"dEM\": round(aQ[\"em\"] - aQR[\"em\"], 4), **mQ})\n        line += f\" | qwen EM {aQ['em']:.3f} {rec['qwen']['dEM']:+.3f} p={mQ['p']:.4f} {mQ['verdict']}\"\n    REC[tag] = rec\n    print(line)\n\ndef run_setting(tag):\n    t0 = time.time()\n    R.run_pipeline(exs, CFG_L, embedder=embedder, generator=gen, gen_tok=tok,\n                   mode=\"short\", setting=tag, out_csv=str(path_for(\"llama\", tag)),\n                   resume=True, progress=False, **PLAN[tag][4])\n    assert gen.config._attn_implementation == \"sdpa\", \"attn impl not restored\"\n    check(tag)\n    print(f\"  {(time.time() - t0) / 60:.1f} min   \"\n          f\">>> COMMIT AND PUSH {path_for('llama', tag).name} <<<\")\n\n# --- preflight (CPU) --------------------------------------------------------\nQWEN_EM = {\"kv_hqq_n8_g32_r512\": 0.391, \"kv_hqq_n4_g32_r512\": 0.385,\n           \"kv_hqq_n3_g32_r512\": 0.339, \"kv_hqq_n2_g32_r512\": 0.046,\n           \"kv_hqq_n2_g16_r512\": 0.370, \"evict_recency_r050\": 0.161,\n           \"evict_sink4_r050\": 0.282, \"evict_random_r050_s42\": 0.320,\n           \"evict_attn_r050\": 0.337, \"topk_02\": 0.366, \"topk_03\": 0.379, \"topk_10\": 0.428}\nQWEN_P = {\"topk_10\": 0.0014}\n\nfor ref in (\"baseline\", B1, B1E):\n    llama(ref)\nfor tag, (lref, qtag, qref, qret, kw) in PLAN.items():\n    if \"kv\" in kw:\n        assert KV.label(**kw[\"kv\"]) == tag, f\"{tag}: KV.label gives {KV.label(**kw['kv'])}\"\n    if \"evict\" in kw:\n        assert EV.label(**kw[\"evict\"]) == tag, f\"{tag}: EV.label gives {EV.label(**kw['evict'])}\"\n    qwen(qret)\n    if qtag:\n        em = Q.aggregate(qwen(qtag).to_dict(\"records\"), k=kw.get(\"top_k\", TOP_K))[\"em\"]\n        p = mcnemar(qwen(qref), qwen(qtag))[\"p\"]\n        print(f\"  qwen {qtag:<22} EM {em:.4f}  p vs {qref} {p:.4f}\")\n        if qtag in QWEN_EM:\n            assert abs(em - QWEN_EM[qtag]) < 5e-4, f\"{qtag}: EM {em} vs published {QWEN_EM[qtag]}\"\n        if qtag in QWEN_P:\n            assert p == QWEN_P[qtag], f\"{qtag}: p {p} vs published {QWEN_P[qtag]}\"\nprint(f\"\\npreflight OK: {len(PLAN)} settings, labels and Q