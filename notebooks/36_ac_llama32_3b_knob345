{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# notebooks/36_ac_llama32_3b_knob345 — CELL 1\n# Kaggle: Accelerator = GPU T4 x2, Internet On, HF_TOKEN secret ON.\n# Llama-3.2-3B, regime-1 knobs: 3 (KV precision), 4 (KV eviction), 5 (top-k).\n# Short mode, n=1000, Qwen's setting labels. ~2.7 h; every run resumes.\n!pip install -q datasets sentence-transformers faiss-cpu hqq \"transformers==5.0.0\"\n\nimport os\nos.environ[\"HF_HOME\"] = \"/kaggle/temp/hf_cache\"\nos.environ[\"TOKENIZERS_PARALLELISM\"] = \"false\"\n\nfrom kaggle_secrets import UserSecretsClient\nfrom huggingface_hub import login, HfApi\nlogin(token=UserSecretsClient().get_secret(\"HF_TOKEN\"))\n\nREPO_URL = \"https://github.com/lazarvelinov46/approximate-computing-rt-rag.git\"\nDEST     = \"/kaggle/working/ac-rag-stack\"\nif os.path.isdir(DEST):\n    !git -C \"{DEST}\" pull -q\nelse:\n    !git clone -q \"{REPO_URL}\" \"{DEST}\"\n%cd {DEST}\nimport sys\nif \".\" not in sys.path:\n    sys.path.insert(0, \".\")\n!git log --oneline -1\n\nimport functools, json, re, time\nfrom importlib.metadata import version\nfrom pathlib import Path\nimport numpy as np\nimport torch\nfrom scipy.stats import binomtest\n\nfrom src.config import load_config, results_dir\nfrom src.data.loader import load_from_config\nimport src.generator.model as G\nfrom src.generator import kv_cache as KV, eviction as EV\nimport src.retriever.embed as E\nimport src.pipeline.rag as R\nimport src.metrics.quality as Q\nfrom scripts.plot_phase2 import verdict\n\nassert version(\"transformers\") == \"5.0.0\"\nCFG_L = load_config(model=\"llama32_3b\")\nLLAMA = CFG_L[\"models\"][\"generator\"]\nOUTDIR = results_dir(LLAMA)\nTOP_K = CFG_L[\"retrieval\"][\"top_k\"]\nMNT_SHORT = CFG_L[\"generation\"][\"max_new_tokens\"]\nassert G.system_for(LLAMA, \"short\") == G.SYSTEM_NO_CITE != G.SYSTEM\n\nexs = load_from_config(CFG_L)\ngen, tok = G.load_generator(LLAMA)\nsnap = getattr(gen.config, \"_commit_hash\", None) or HfApi().model_info(LLAMA).sha\nwith open(OUTDIR / \"baselines_summary.json\") as fh:\n    base_snap = json.load(fh)[\"snapshot\"]\nassert snap == base_snap, f\"model snapshot changed since the baselines: {snap} vs {base_snap}\"\nprint(f\"{LLAMA}  snapshot {snap}  weights {torch.cuda.memory_allocated(0) / 2**30:.2f} GiB\")\n\nembedder = E.load_embedder(CFG_L[\"models\"][\"embedder\"])","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-09-22T22:44:18.143734Z","iopub.execute_input":"2026-09-22T22:44:18.14429Z","iopub.status.idle":"2026-09-22T22:46:03.029524Z","shell.execute_reply.started":"2026-09-22T22:44:18.144263Z","shell.execute_reply":"2026-09-22T22:46:03.028627Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m58.4/58.4 kB\u001b[0m \u001b[31m1.3 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0ma \u001b[36m0:00:01\u001b[0m\n\u001b[?25h  Installing build dependencies ... \u001b[?25l\u001b[?25hdone\n  Getting requirements to build wheel ... \u001b[?25l\u001b[?25hdone\n  Preparing metadata (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m18.8/18.8 MB\u001b[0m \u001b[31m26.1 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m00:01\u001b[0m00:01\u001b[0m\n\u001b[?25h  Building wheel for hqq (pyproject.toml) ... \u001b[?25l\u001b[?25hdone\n/kaggle/working/ac-rag-stack\n\u001b[33me894b