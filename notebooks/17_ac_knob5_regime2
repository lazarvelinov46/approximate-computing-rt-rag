 ---\")\nMC20 = mcnemar2(\"r2_topk_05_b8\", OUT2, \"r2_topk_20_b8\", OUT2)\n\nwith open(\"results/knob5_r2_summary.json\", \"w\") as fh:\n    json.dump({\"knob\": 5, \"regime\": 2, \"mode\": \"short\", \"n\": 1000,\n               \"run_plan\": [{\"setting\": s, \"k\": k, \"batch\": B} for s, k, B in RUN_PLAN],\n               \"batch_amendment\": {\n                   \"reason\": \"k=20 OOMs at the frozen batch_size=16 (4945-token \"\n                             \"worst prompt, 14.56 GiB T4). Ladder: 12 OOM, 8 OK \"\n                             \"at 12.62 GiB. Decided on a memory measurement \"\n                             \"before any k=20 EM existed.\",\n                   \"batch_for_k20\": 8,\n                   \"control\": \"r2_topk_05_b8\"},\n               \"projection_conditionals\": {\"em_complete\": EM_C, \"em_incomplete\": EM_I},\n               \"mcnemar_batch16_vs_k5\": MC2,\n               \"mcnemar_batch_control\": CTRL,\n               \"mcnemar_k20_vs_matched_k5\": MC20,\n               \"settings\": summary2.to_dict(\"records\")}, fh, indent=2)\nprint(\"\\nwrote results/knob5_r2_summary.csv and _summary.json\")\nprint(\"COMMIT AND PUSH before terminating.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-05T22:21:34.569343Z","iopub.execute_input":"2026-09-05T22:21:34.569658Z","iopub.status.idle":"2026-09-05T22:21:35.377258Z","shell.execute_reply.started":"2026-09-05T22:21:34.569632Z","shell.execute_reply":"2026-09-05T22:21:35.376581Z"}},"outputs":[{"name":"stdout","text":"            setting  k  batch  recall@k  complete_frac    em     f1  em_projected  em_complete  em_incomplete  em_bridge  em_comparison  abstain_rate  prompt_tokens_mean  em_residual\n         r2_topk_02  2     16    0.6495          0.380 0.305 0.3867        0.2408       0.5474         0.1565     0.2488         0.5417         0.041               337.3       0.0642\n         r2_topk_03  3     16    0.7150          0.485 0.306 0.4014        0.2763       0