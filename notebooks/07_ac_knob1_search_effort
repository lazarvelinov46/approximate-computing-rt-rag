e):\n    I.reset_search_stats()\n    ids, _ = I.search(idx, qv, TOP_K)\n    stats = I.read_search_stats(len(qv))\n\n    ann = np.mean([len(set(r) & e) / TOP_K for r, e in zip(ids, exact_sets)])\n    rec = np.mean([Q.recall_at_k(list(r), g, TOP_K)\n                   for r, g in zip(ids, gold_global)])\n    comp = np.mean([set(g) <= set(r) for r, g in zip(ids, gold_global)])\n    ident = np.mean([np.array_equal(r, e) for r, e in zip(ids, exact_ids)])\n\n    return {\n        \"index\": label, \"param\": param, \"value\": value,\n        \"ann_recall\": round(float(ann), 4),\n        \"exact_match_topk\": round(float(ident), 4),   # whole list identical\n        \"recall@5\": round(float(rec), 4),\n        \"complete_frac\": round(float(comp), 4),\n        \"ndis_per_query\": round(float(\n            stats.get(f\"{label}_ndis_per_query\", float(\"nan\"))), 1),\n    }\n\n\nrows = [{\"index\": \"flat\", \"param\": \"-\", \"value\": 0, \"ann_recall\": 1.0,\n         \"exact_match_topk\": 1.0, \"recall@5\": 0.768, \"complete_frac\": 0.573,\n         \"ndis_per_query\": float(len(corpus))}]\n\nfor ef in EF_GRID:\n    I.set_ef(h, ef)\n    rows.append(sweep_point(h, \"hnsw\", \"ef\", ef))\n\nfor np_ in NPROBE_GRID:\n    I.set_nprobe(iv, np_)\n    rows.append(sweep_point(iv, \"ivf\", \"nprobe\", np_))\n\nsweep = pd.DataFrame(rows)\nsweep.to_csv(\"results/knob1_dense_sweep.csv\", index=False)\nprint(sweep.to_string(index=False))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T22:49:55.262606Z","iopub.execute_input":"2026-09-01T22:49:55.26339Z","iopub.status.idle":"2026-09-01T22:50:22.571996Z","shell.execute_reply.started":"2026-09-01T22:49:55.263357Z","shell.execute_reply":"2026-09-01T22:50:22.57105Z"}},"outputs":[{"name":"stdout","text":"index  param  value  ann_recall  exact_match_topk  recall@5  complete_frac  ndis_per_query\n flat      -      0      1.0000             1.000    0.7680          0.573         66581.0\n hnsw     ef      5      0.7430 