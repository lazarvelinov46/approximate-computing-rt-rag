ache touches. n_freqs is independent of head_dim\n    so the partial-rotary condition is expressible.\"\"\"\n    def __init__(self, n_layers=36, n_heads=16, n_kv=2, hidden=2048,\n                 rope_type=\"default\", head_dim=128, impl=\"sdpa\",\n                 n_freqs=None):\n        self.config = SimpleNamespace(\n            num_hidden_layers=n_layers, num_attention_heads=n_heads,\n            num_key_value_heads=n_kv, hidden_size=hidden, head_dim=head_dim,\n            rope_parameters={\"rope_type\": rope_type, \"rope_theta\": 1000000.0},\n            _attn_implementation=impl)\n        self.model = SimpleNamespace(\n            rotary_emb=SimpleNamespace(\n                inv_freq=torch.ones(n_freqs if n_freqs is not None\n                                    else head_dim // 2)))\n\ndef expect(exc, fn, why, must_contain):\n    try:\n        fn()\n    except exc as e:\n        msg = str(e)\n        assert must_contain in msg, \\\n            f\"{why}: fired for the WRONG reason.\\n  expected ...{must_contain}...\\n  got: {msg[:140]}\"\n        print(f\"  OK  {why}\")\n    except Exception as e:\n        raise AssertionError(f\"{why}: wrong exception {type(e).__name__}: {e}\")\n    else:\n        raise AssertionError(f\"{why}: no exception raised\")\n\n# partial rotary: 64 of 128 head dims rotated (Phi-style partial_rotary_factor)\nexpect(ValueError,\n       lambda: EV.make_cache(StubModel(head_dim=128, n_freqs=32),\n                             \"recency\", 0.5),\n       \"partial rotary (32 freqs, 128 head dims)\", \"partial rotary\")\n\n# and the negative: a full-rotary stub must NOT trip it\nstub = StubModel()\nassert EV.make_cache(stub, \"recency\", 0.5) is not None\nprint(\"  OK  full rotary (64 freqs, 128 head dims) is allowed\")\n\n# --- resume CELL 3 from the point it stopped ------------------------------\nfrom src.generator import model as G\n\nprint(\"\\ngenerate_batch guards with a real model object:\")\nexpect(ValueError,\n       lambda: G.generate_batch(stub, None, [\"a\"] * 16, 32,\n                                evict=dict(policy=\"sink_recent\", keep_ratio=0.5)),\n       \"sink_recent at batch 16 via generate_batch\", \"non-contiguous keep-set\")\nexpect(ValueError,\n       lambda: G.generate_batch(stub, None, [\"a\"], 32,\n                                kv=dict(bits=4),\n                                evict=dict(policy=\"recency\", keep_ratio=0.5)),\n       \"kv + evict joint\", \"knob3 x knob4 joint\")\n\nprint(\"\\nescape hatches must WORK, not just exist:\")\nc = EV.make_cache(stub, \"sink_recent\", 0.5, batch_size=16, allow_padded=True)\nassert len(c.layers) == 36 and c.layers[0].policy == \"sink_recent\"\nprint(\"  OK  allow_padded=True builds a 36-layer cache\")\nc = EV.make_cache(stub, \"sink_recent\", 0.5, shift_rope=False, allow_naive=True)\nassert c.layers[0].shift_rope is False\nprint(\"  OK  allow_naive=True builds with shifting off\")\nc = EV.make_cache(StubModel(impl=\"eager\"), \"attention\", 0.5)\nassert c.layers[0].policy == \"attention\"\nprint(\"  OK  attention policy builds under eager\")\n\nc = EV.make_cache(stub, \"recency\", 0.5, batch_size=16)\nassert c is not None and len(c.layers) == 36\nprint(\"  OK  recency at batch 16 is allowed (a suffix is contiguous)\")\n\nprint(\"\\nper-layer independence:\")\nc = EV.make_cache(stub, \"random\", 0.5)\nassert len({id(l) for l in c.layers}) == 36, \"layers are aliased\"\nseqs = [EV.keep_indices(\"random\", 40, 8, rng=l._rng) for l in c.layers]\nassert len({tuple(s) for s in seqs}) > 1, \\\n    \"every layer drew the SAME random keep-set — rngs are not layer-seeded\"\nprint(f\"  OK  36 distinct layers, {len({tuple(s) for s in seqs})} distinct draws\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T19:22:38.556098Z","iopub.execute_input":"2026-09-07T19:22:38.556995Z","iopub.status.idle":"2026-09-07T19:22:38.7962Z","shell.execute_reply.started":"2026-09-07T19:22:38.55695Z","shell.execute_reply":"2026-09-07T19:22