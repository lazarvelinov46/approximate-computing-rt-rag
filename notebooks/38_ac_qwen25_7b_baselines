c, 0.5).pvalue if b + c else 1.0\n    return {\"b\": b, \"c\": c, \"d\": b + c, \"p\": round(float(p), 4), \"verdict\": verdict(b, c, p)}\n\ndef stats(df, mode):\n    a = Q.aggregate(df.to_dict(\"records\"), k=TOP_K)\n    rec = {k: a[k] for k in (\"em\", \"f1\", f\"recall@{TOP_K}\", \"complete_frac\", \"em_complete\",\n                             \"em_incomplete\", \"em_bridge\", \"em_comparison\", \"abstain_rate\")}\n    rec[\"gap\"] = round(a[\"em_complete\"] - a[\"em_incomplete\"], 4)\n    rec[\"decode_mean\"] = round(float(df.decode_tokens.mean()), 2)\n    # fp16-overflow sentinel: NaN logits decode as token 0, '!' (notebook 37 cell 10)\n    rec[\"bang_frac\"] = round(float(np.mean([\"!\" in p for p in df.prediction])), 4)\n    if mode == \"explain\":\n        rec[\"parse_rate\"] = round(float(df.parsed_ok.mean()), 4)\n        rec[\"trunc_frac\"] = round(float((df.decode_tokens >= MNT[\"explain\"] - 1).mean()), 4)\n    return rec\n\ndef check(tag):\n    key, mode = RUNS[tag]\n    S, Q3 = load(F[key], tag), load(QF[key], tag).set_index(\"qid\")\n    bad_r = sum(Q3.loc[q, \"retrieved_ids\"] != v for q, v in zip(S.qid, S.retrieved_ids))\n    bad_p = sum(int(Q3.loc[q, \"prompt_tokens\"]) != int(v) for q, v in zip(S.qid, S.prompt_tokens))\n    assert bad_r == 0 and bad_p == 0, \\\n        f\"{tag}: vs 3B, retrieved_ids differ {bad_r}, prompt_tokens differ {bad_p}\"\n    r7, r3 = stats(S, mode), stats(Q3.reset_index(), mode)\n    print(f\"{tag:<20} 7B \" + \"  \".join(f\"{k} {v}\" for k, v in r7.items()))\n    print(f\"{'':<20} 3B \" + \"  \".join(f\"{k} {v}\" for k, v in r3.items()))\n    return {\"7b\": r7, \"3b\": r3}\n\ndef smoke_identity(tag):\n    \"\"\"First rows vs notebook 37's smoke run of the same tag (same batches).\"\"\"\n    sm = R.load_results(str(OUTDIR / \"smoke_37.csv\"), setting=tag)\n    S = dict(zip(*load(F[RUNS[tag][0]], tag)[[\"qid\", \"prediction\"]].values.T))\n    ident = float(np.mean([S[q] == p for q, p in zip(sm.qid, sm.prediction)]))\n  