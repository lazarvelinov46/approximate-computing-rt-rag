{
  "knob": 5,
  "name": "top-k (data sampling)",
  "amendments": [
    {
      "what": "knobs.yaml knob_top_k.k from [5,3,1] to [10,7,5,3,2,1]",
      "why": "regime-1 corpus shape (10 paragraphs / 2 gold, measured nb 01) makes k=10 the zero-approximation anchor and k=2 the minimum feasible complete-evidence point; neither fact existed when the range was written",
      "results_seen": false
    },
    {
      "what": "k=1 dropped from the sweep",
      "why": "complete_frac(1)=0 by construction with 2 gold, so k=1 is not a point on the same curve",
      "results_seen": false
    },
    {
      "what": "regime-2 k=20 run at batch_size 8 with a matched k=5 control",
      "why": "4945-token worst prompt OOMs at batch 16 on a 14.56 GiB T4; ladder gave 12 OOM, 8 OK at 12.62 GiB. Decided on a memory measurement before any k=20 EM existed",
      "results_seen": false
    },
    {
      "what": "acceptance rule carve-out: discordant=0 with identical marginals is a null, not UNINFORMATIVE",
      "why": "the <10-discordant rule was written for low-power comparisons; knob 3 already treated the zero-discordant case as a null (8-bit KV). Consistency, not convenience",
      "results_seen": true
    }
  ],
